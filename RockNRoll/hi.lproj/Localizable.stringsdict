			<key>other</key>
			<string>छूटे हुए %ld भाग देखें</string>
		</dict>
	</dict>
	<key>Chat, %ld unread</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>चैट, %ld अपठित संदेश</string>
			<key>other</key>
			<string>चैट, %ld अपठित संदेश</string>
		</dict>
	</dict>
	<key>See all %ld recent jams</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>हाल का %ld सत्र देखें</string>
			<key>other</key>
			<string>हाल के सभी %ld सत्र देखें</string>
		</dict>
	</dict>
	<key>This month you had %ld meetings</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>इस महीने आपकी %ld बैठक थी</string>
			<key>other</key>
			<string>इस महीने आपकी %ld बैठकें थीं</string>
		</dict>
	</dict>
	<key>This week you had %ld meetings</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>इस सप्ताह आपकी %ld बैठक थी</string>
			<key>other</key>
			<string>इस सप्ताह आपकी %ld बैठकें थीं</string>
		</dict>
	</dict>
	<key>Today you had %ld meetings</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>आज आपकी %ld बैठक थी</string>
			<key>other</key>
			<string>आज आपकी %ld बैठकें थीं</string>
