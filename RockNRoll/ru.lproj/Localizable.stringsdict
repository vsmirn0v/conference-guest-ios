			<key>other</key>
			<string>Пропущено %ld фрагмента</string>
		</dict>
	</dict>
	<key>Chat, %ld unread</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>few</key>
			<string>Чат, %ld непрочитанных сообщения</string>
			<key>many</key>
