<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%ld approved notes</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>few</key>
			<string>%ld разрешённые заметки</string>
			<key>many</key>
			<string>%ld разрешённых заметок</string>
			<key>one</key>
			<string>%ld разрешённая заметка</string>
			<key>other</key>
			<string>%ld разрешённой заметки</string>
		</dict>
	</dict>
	<key>%ld characters over the limit</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>few</key>
			<string>Лишние %ld символа</string>
			<key>many</key>
			<string>Лишние %ld символов</string>
			<key>one</key>
			<string>Лишний %ld символ</string>
			<key>other</key>
			<string>Лишние %ld символа</string>
		</dict>
	</dict>
	<key>%ld meetings</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>few</key>
			<string>%ld встречи</string>
			<key>many</key>
			<string>%ld встреч</string>
			<key>one</key>
			<string>%ld встреча</string>
			<key>other</key>
			<string>%ld встреч</string>
		</dict>
	</dict>
	<key>%ld musicians</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>few</key>
			<string>%ld музыканта</string>
