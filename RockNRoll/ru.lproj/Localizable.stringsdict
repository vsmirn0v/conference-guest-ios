		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>few</key>
			<string>Показать %ld недавних джема</string>
			<key>many</key>
			<string>Показать %ld недавних джемов</string>
			<key>one</key>
