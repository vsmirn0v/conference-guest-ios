			<key>few</key>
			<string>%ld реакции</string>
			<key>many</key>
			<string>%ld реакций</string>
			<key>one</key>
			<string>%ld реакция</string>
			<key>other</key>
			<string>%ld реакции</string>
		</dict>
	</dict>
	<key>Catch up, %ld missed sections</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>few</key>
			<string>Пропущено %ld фрагмента</string>
			<key>many</key>
			<string>Пропущено %ld фрагментов</string>
			<key>one</key>
