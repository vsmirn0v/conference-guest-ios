			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>few</key>
			<string>На этой неделе было %ld встречи</string>
			<key>many</key>
			<string>На этой неделе было %ld встреч</string>
			<key>one</key>
			<string>На этой неделе была %ld встреча</string>
			<key>other</key>
			<string>На этой неделе было %ld встреч</string>
