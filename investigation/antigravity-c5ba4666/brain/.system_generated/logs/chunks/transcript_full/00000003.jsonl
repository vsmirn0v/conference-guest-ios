32:             return nil\n133:         }\n134:         return append(kind: kind, participantID: participantID, displayName: displayName,\n135:                       isOwn: false, time: time, providerTimestamp: providerTime,\n136:                       providerEventID: providerEventID, submissionID: nil)\n137:     }\n138: \n139:     /// Call only after the existing send gate and transport accept a submission.\n140:     @discardableResult\n141:     func recordLocalSubmission(kind: MeetingReaction, participantID: String, displayName: String?,\n142:                                submissionID: String = UUID().uuidString, at: Date? = nil,\n143:                                expectedMeetingID: UUID? = nil) -> MeetingReactionEvent? {\n144:         let time = at ?? clock()\n145:         guard accepts(expectedMeetingID), valid(participantID), valid(submissionID), finite(time) else { return nil }\n146:         let identity = Identity(source: .local, participantID: \"\", value: submissionID)\n147:         guard !identities.contains(identity),\n148:               !events.contains(where: { $0.localSubmissionID == submissionID }) else { return nil }\n149:         remember(identity)\n150:         return append(kind: kind, participantID: participantID, displayName: displayName,\n151:                       isOwn: true, time: time, providerTimestamp: nil,\n152:                       providerEventID: nil, submissionID: submissionID)\n153:     }\n154: \n155:     func setLocalDelivery(_ delivery: MeetingReactionEvent.Delivery, submissionID: String,\n156:                           expectedMeetingID: UUID? = nil) {\n157:         guard accepts(expectedMeetingID),\n158:               let index = events.firstIndex(where: { $0.localSubmissionID == submissionID }),\n159:               events[index].delivery != .acknowledged,\n160:               events[index].delivery != delivery else { return }\n161:         // A delayed submission callback cannot resurrect an already failed send.\n162:         guard delivery != .submitted else { return }\n163:         events[index].delivery = delivery\n164:     }\n165: \n166:     /// Fill an absent snapshot by exact identity; never rewrite a captured name.\n167:     func resolveUnknownParticipant(id: String, name: String, expectedMeetingID: UUID? = nil) {\n168:         guard accepts(expectedMeetingID), let name = snapshotName(name) else { return }\n169:         var resolved = events\n170:         for index in resolved.indices where resolved[index].participantID == id {\n171:             resolved[index].resolveName(name)\n172:         }\n173:         if resolved != events { events = resolved }\n174:     }\n175: \n176:     /// The presentation supplies IDs that were actually visible in the foreground.\n177:     func markSeen(ids: [String]) {\n178:         guard !ids.isEmpty else { return }\n179:         let visible = Set(ids)\n180:         let changed = events.indices.filter { !events[$0].isSeen && visible.contains(events[$0].id) }"}
