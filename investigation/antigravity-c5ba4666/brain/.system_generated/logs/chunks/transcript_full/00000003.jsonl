ents.filter { changes[$0.id] == nil }\n128:         // Merge ordered deltas instead of sorting the full retained transcript.\n129:         var merged: [TranscriptSegment] = []\n130:         merged.reserveCapacity(previous.count + additions.count)\n131:         var left = 0, right = 0\n132:         while left < previous.count && right < additions.count {\n133:             if Self.precedes(previous[left], additions[right]) { merged.append(previous[left]); left += 1 }\n134:             else { merged.append(additions[right]); right += 1 }\n135:         }\n136:         merged.append(contentsOf: previous[left...]); merged.append(contentsOf: additions[right...])\n137:         if merged.count > 5_000 { isTruncated = true }\n138:         segments = Array(merged.suffix(5_000))\n139:         for (id, value) in changes { segmentsByID[id] = value }\n140:         for removed in merged.prefix(max(0, merged.count - 5_000)) { segmentsByID.removeValue(forKey: removed.id) }\n141:     }\n142: \n143:     public func transcript(during interval: MissedInterval, now: Date = Date()) -> [TranscriptSegment] {\n144:         let end = interval.end ?? now\n145:         return segments.filter { segment in\n146:             guard let timestamp = segment.spokenAt else { return false }\n147:             return timestamp >= interval.start.addingTimeInterval(-5)\n148:                 && timestamp <= end.addingTimeInterval(5)\n149:         }\n150:     }\n151: \n152:     public mutating func markReviewed() {\n153:         reviewedIntervalIDs.formUnion(intervals.filter { $0.end != nil }.map(\\.id))\n154:         lastReviewedCount = reviewedIntervalIDs.count\n155:     }\n156: \n157:     public mutating func markReviewed(_ id: UUID) {\n158:         guard intervals.contains(where: { $0.id == id && $0.end != nil }) else { return }\n159:         reviewedIntervalIDs.insert(id)\n160:         lastReviewedCount = reviewedIntervalIDs.count\n161:     }\n162: \n163:     /// After an app restart, old CallKit and audi