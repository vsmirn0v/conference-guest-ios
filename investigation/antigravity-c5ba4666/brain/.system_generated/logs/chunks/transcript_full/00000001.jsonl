  self.maximumEvents = max(1, maximumEvents)\n90:         maximumIdentities = max(1, maximumIdentityCount)\n91:         self.maximumGaps = max(1, maximumGaps)\n92:         self.clock = clock\n93:     }\n94: \n95:     /// Rebinding the same meeting preserves history through a reconnect/UI rebuild.\n96:     func beginMeeting(id: UUID = UUID()) {\n97:         guard meetingID != id else { return }\n98:         clear()\n99:         meetingID = id\n100:     }"}
