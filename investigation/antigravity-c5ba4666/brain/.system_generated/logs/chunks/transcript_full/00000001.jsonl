owScene }.first)\n58:         let previous = scene.windows.first { $0.isKeyWindow }\n59:         let window = UIWindow(windowScene: scene)\n60:         let chat = ChatStore(); chat.reactionHistoryAvailable = true; chat.reactionHistory.beginMeeting()\n61:         let panel = ConversationPanelViewController(catchUp: CatchUpStore(), chat: chat)\n62:         window.rootViewController = panel; window.makeKeyAndVisible()\n63:         defer { window.isHidden = true; previous?.makeKey() }\n64:         try await waitFor(\"Conversation appearance completed\") {\n65:             chat.isConversationOpen && chat.reactionHistory.isReadingLatest\n66:         }\n67:         await drainUpdates()\n68:         let before = panel.messageRenderCount\n69:         for _ in 0..<30 { chat.reactionHistory.receive(kind: .wave, participantID: \"ani\", displayName: \"Ani\") }\n70:         await drainUpdates()\n71:         XCTAssertLessThanOrEqual(panel.messageRenderCount - before, 2, \"Seen-state feedback may add one render\")\n72:         let background = panel.messageRenderCount\n73:         chat.reactionHistory.receive(kind: .heart, participantID: \"new\", displayName: \"New\")\n74:         // Resign while the newest snapshot is still queued for rendering.\n75:         NotificationCenter.default.post(name: UIApplication.willResignActiveNotification, object: nil)\n76:         await drainUpdates()\n77:         XCTAssertEqual(panel.messageRenderCount, background)\n78:         XCTAssertFalse(try XCTUnwrap(chat.reactionHistory.events.last).isSeen)\n79:         NotificationCenter.default.post(name: UIApplication.didBecomeActiveNotification, object: nil)\n80:         await drainUpdates()\n81:         XCTAssertGreaterThan(panel.messageRenderCount, background)\n82:         XCTAssertEqual(chat.reactionHistory.events.count, 31)\n83:         XCTAssertTrue(find(ReactionHistoryRowView.self, in: panel.view).contains { $0.group.events.contains { $0.kind == .heart } })\n84:     }\n85:     func testHistoryRem