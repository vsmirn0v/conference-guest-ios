ason, at time: Date = Date()) {\n83:         guard activeReasons.insert(reason).inserted else { return }\n84:         if activeReasons.count == 1 {\n85:             intervals.append(MissedInterval(id: UUID(), start: time, end: nil, reasons: [reason]))\n86:             if intervals.count > 100 {\n87:                 let removed = intervals.removeFirst()\n88:                 reviewedIntervalIDs.remove(removed.id)\n89:                 isTruncated = true\n90:             }\n91:         } else if let index = intervals.indices.last, intervals[index].end == nil {\n92:             intervals[index] = MissedInterval(id: intervals[index].id,\n93:                                               start: intervals[index].start,\n94:                                               end: nil,\n95:                                               reasons: intervals[index].reasons.union([reason]))\n96:         }\n97:     }\n98: \n99:     public mutating func end(_ reason: MissedReason, at time: Date = Date()) {\n100:         guard activeReasons.remove(reason) != nil, activeReasons.isEmpty,\n101:               let index = intervals.indices.last, intervals[index].end == nil else { return }\n102:         intervals[index].end = max(time, intervals[index].start)\n103:     }\n104: \n105:     public func shouldRetain(id: String, spokenAt: Date?) -> Bool {\n106:         guard isTruncated, segments.count == 5_000, segmentsByID[id] == nil, let first = segments.first else { return true }\n107:         return Self.precedes(first, TranscriptSegment(id: id, speaker: nil, text: \"\", spokenAt: spokenAt))\n108:     }\n109: \n110:     private static func precedes(_ a: TranscriptSegment, _ b: TranscriptSegment) -> Bool {\n111:         switch (a.spokenAt, b.spokenAt) {\n112:         case let (x?, y?): return x == y ? a.id < b.id : x < y\n113:         case (nil, _?): return false\n114:         case (_?, nil): return true\n115:         case (nil, nil): return a.id < b.id\n116:         }\n117:     }\n118: \n119:     public mutating func upsert(_ incoming: [TranscriptSegment]) {\n120:         var changes: [String: TranscriptSegment] = [:]\n121:         for segment in incoming where !segment.id.isEmpty && !segment.text.isEmpty && shouldRetain(id: segment.id, spokenAt: segment.spokenAt) {\n122:             changes[segment.id] = segment\n123:         }\n124:         changes = changes.filter { segmentsByID[$0.key] != $0.value }\n125:         guard !changes.isEmpty else { return }\n126:         let additions = changes.values.sorted(by: Self.precedes)\n127:         let previous = segm