setParticipantVolume(1, id: \"boris\")\n171:         XCTAssertEqual(volumes[\"boris\"]!, 0.4, accuracy: 1e-9)\n172:         ok(await daily.setSound(false)); ok(await infra.setSound(false))\n173:         XCTAssertFalse(module.playout); XCTAssertEqual(volumes, [\"anna\": 0, \"boris\": 0])\n174:         ok(await infra.setTranscriptionOutput(true))\n175:         XCTAssertTrue(module.transcription, \"Output runs silenced for transcription\")\n176:         XCTAssertFalse(module.playout); XCTAssertEqual(volumes, [\"anna\": 0, \"boris\": 0])\n177:         ok(await daily.setSound(true))\n178:         XCTAssertTrue(module.playout); XCTAssertFalse(module.transcription)\n179:         XCTAssertEqual(volumes, [\"anna\": 1, \"boris\": 0], \"A transcribing meeting stays silent beside one with sound\")\n180:         ok(await daily.detach())\n181:         XCTAssertEqual(volumes[\"anna\"], 0, \"A detached meeting is silenced\")\n182:         XCTAssertFalse(module.playout); XCTAssertTrue(module.transcription)\n183:     }\n184: \n185:     func testOnlyTheTalkMeetingReceivesYourMicrophoneAndPlaysReplies() async throws {\n186:         let (engine, module) = make()\n187:         let daily = try await engine.attach(meetingID: UUID()), infra = try await engine.attach(meetingID: UUID())\n188:         var heard: [String] = []\n189:         daily.setInputTranscriptionSink { _ in heard.append(\"daily\") }\n190:         infra.setInputTranscriptionSink { _ in heard.append(\"infra\") }\n191:         let buffer = try XCTUnwrap(AVAudioPCMBuffer(pcmFormat: AVAudioFormat(standardFormatWithSampleRate: 48_000, channels: 1)!, frameCapacity: 16))\n192:         module.deliver(buffer)\n193:         XCTAssertEqual(heard, [], \"No talk meeting: nobody hears the microphone\")\n194:         ok(await infra.assumeTalk()); module.deliver(buffer)\n195:         ok(await daily.assumeTalk()); module.deliver(buffer)\n196:         XCTAssertEqual(heard, [\"infra\", \"daily\"])\n197:         no(await infra.playVoiceReply(b