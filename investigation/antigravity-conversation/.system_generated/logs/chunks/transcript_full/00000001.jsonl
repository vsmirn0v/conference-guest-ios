for count in [2, 4] {\n36:             let (engine, module) = make()\n37:             var meetings: [MeetingAudioAttachment] = [], senders: [FakeSender] = []\n38:             for _ in 0..<count {\n39:                 let meeting = try await engine.attach(meetingID: UUID()), sender = FakeSender()\n40:                 meeting.addSender(sender); meetings.append(meeting); senders.append(sender)\n41:             }\n42:             // At the moment the module unmutes, only the talk meeting's sender may be on.\n43:             module.onUnmute = {\n44:                 let talk = engine.talkMeetingID\n45:                 for (meeting, sender) in zip(meetings, senders) where meeting.meetingID != talk {\n46:                     XCTAssertFalse(sender.isEnabled, \"Another meeting's sender was on when the module unmuted\")\n47:                 }\n48:             }\n49:             for round in 0..<(count * 2) {\n50:                 let speaker = meetings[round % count]\n51:                 ok(await speaker.assumeTalk())\n52:                 ok(await speaker.setMuted(false))\n53:                 let enabled = senders.enumerated().filter { $0.element.isEnabled }.map(\\.offset)\n54:                 XCTAssertEqual(enabled, [round % count], \"\\(count) meetings, round \\(round)\")\n55:                 XCTAssertFalse(module.muted)\n56:             }\n57:             XCTAssertGreaterThan(module.unmutes, 0)\n58:         }\n59:     }\n60: \n61:     func testMovingTheTalkRoleMutesFirstAndRefusesAStaleUnmute() async throws {\n62:         let (engine, module) = make()\n63:         let daily = try await engine.attach(meetingID: UUID()), infra = try await engine.attach(meetingID: UUID())\n64:         let a = FakeSender(), b = FakeSender()\n65:         daily.addSender(a); infra.addSender(b)\n66:         ok(await daily.assumeTalk())\n67:         let dailyEpoch = try XCTUnwrap(daily.talkEpoch)\n68:         ok(await daily.setMuted(false))\n69:         module.log.removeAll()\n70: \n71:         ok(await infra.assumeTalk())\n72:         XCTAssertFalse(a.isEnabled, \"The previous talk meeting's sender is off\")\n73:         XCTAssertTrue(module.muted)\n74:         XCTAssertEqual(module.log.first, \"mute:true\", \"Muted before the role moves\")\n75:         no(await engine.setMuted(false, for: daily, epoch: dailyEpoch), \"A stale meeting cannot unmute\")\n76:         XCTAssertFalse(a.isEnabled); XCTAssertTrue(module.muted)\n77:         XCTAssertFalse(b.isEnabled, \"The new talk meeting starts muted: it never inherits an unmute\")\n78: \n79:         // Back again: the old epoch from the first round is still refused.\n80:         ok(await daily.assumeTalk())\n81:         no(await engine.setMuted(false, for: daily, epoch: dailyEpoch))\n82:         ok(await daily.setMuted(false))\n83:         XCTAssertTrue(a.isEnabled); XCTAssertFalse(b.isEnabled)\n84:     }\n85: \n86:     func testAFailedUnmuteLeavesEverythingSilent() async throws {\n87:         let (engine, module) = make()\n88:         let daily = try await engine.attach(meetingID: UUID()), sender = FakeSender()\n89:         daily.addSender(sender)\n90:         ok(await daily.assumeTalk())\n91:         module.failUnmute = true\n92:         no(await daily.setMuted(false))\n93:         XCTAssertFalse(sender.isEnabled); XCTAssertTrue(module.muted)\n94:         XCTAssertTrue(module.log.contains(\"suppress\"), \"A failed unmute is followed by the privacy barrier\")\n95:         module.failUnmute = false; module.failActivation = true\n96:         no(await daily.setMuted(false))\n97:         XCTAssertFalse(sender.isEnabled, \"No sender before the microphone is active\")\n98:     }\n99: \n100:     func testReleasingTheTalkRoleReleasesTheDeviceUnlessKeptWarm() async throws {\n101:         let (engine, module) = make()\n102:         let daily = try await engine.attach(meetingID: UUID()), sender = FakeSender()\n103:         daily.addSender(sender)\n104:         ok(await daily.assumeTalk()); ok(await daily.setMuted(false))\n105:         ok(await daily.relinquishTalk())\n106:         XCTAssertFalse(sender.isEnabled); XCTAssertTrue(module.muted)\n107:         XCTAssertNil(engine.talkMeetingID)\n108:         XCTAssertEqual(module.log.last, \"permit:false warm:false\")\n109:         engine.keepInputWarm = true\n110:         ok(await daily.assumeTalk()); ok(await daily.relinquishTalk())\n111:         XCTAssertEqual(module.log.last, \"permit:false warm:true\")\n112:     }\n113: \n114:     // Guarantee 4: the private microphone check only while no sender is enabled.\n115:     func testPrivateCheckOnlyWhileNoSenderIsEnabled() async throws {\n116:         let (engine, module) = make()\n117:         let daily = try await engine.attach(meetingID: UUID()), sender = FakeSender()\n118:         daily.addSender(sender)\n119:         ok(await daily.assumeTalk()); ok(await daily.setMuted(false))\n120:         no(await engine.beginPrivateCheck(), \"Refused while a meeting sends\")\n121:         ok(await daily.setMuted(true))\n122:         ok(await engine.beginPrivateCheck())\n123:         XCTAssertTrue(engine.privateCheckActive)\n124:         no(await daily.setMuted(false), \"No unmute during the check\")\n125:         XCTAssertFalse(sender.isEnabled); XCTAssertTrue(module.muted)\n126:         ok(await engine.endPrivateCheck())\n127:         ok(await daily.setMuted(false))\n128:         XCTAssertTrue(sender.isEnabled)\n129:     }\n130: \n131:     // Guarantee 5: cleanup failures quarantine the engine.\n132:     func testAFailedReleaseBlocksNewMeetings() async throws {\n133:         let (engine, module) = make()\n134:         let daily = try await engine.attach(meetingID: UUID()), sender = FakeSender()\n135:         daily.addSender(sender)\n136:         ok(await daily.assumeTalk()); ok(await daily.setMuted(false))\n137:         module.failShutdown = true\n138:         no(await daily.detach())\n139:         XCTAssertFalse(sender.isEnabled, \"Senders are off even when release fails\")\n140:         XCTAssert