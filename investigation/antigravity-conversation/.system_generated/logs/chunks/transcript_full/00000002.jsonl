cess\n273:             } else {\n274:                 success = await applyOutputLocked() && success\n275:             }\n276:             if !success { quarantine() }\n277:             return success\n278:         }\n279:     }\n280: \n281:     // MARK: Talk role\n282: \n283:     /// Moves the talk role. Every sender is disabled and the module muted first; the\n284:     /// new talk meeting starts muted and must unmute itself.\n285:     @discardableResult func assignTalk(to attachment: MeetingAudioAttachment) async -> Bool {\n286:         await work.run { [self] in\n287:             guard attachments[attachment.meetingID] === attachment, !cleanupFailed else { return false }\n288:             if talkMeetingID == attachment.meetingID { return true }\n289:             guard await muteEverythingLocked() else { return false }\n290:             talkUnmuted = false\n291:             talkMeetingID = attachment.meetingID; talkEpoch &+= 1\n292:             inputSink.set(attachment.inputSinkHandler)\n293:             _ = module?.setMicrophoneGate(open: true)\n294:             return await module?.setInputPermitted(true, keepWarm: false, timeout: timeouts.mute) ?? false\n295:         }\n296:     }\n297: \n298:     @discardableResult func releaseTalk(from attachment: MeetingAudioAttachment) async -> Bool {\n299:         await work.run { [self] in\n300:             guard talkMeetingID == attachment.meetingID else { return true }"}
