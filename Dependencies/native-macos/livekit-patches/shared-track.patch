diff --git a/Sources/LiveKit/Track/Track+SharedEngine.swift b/Sources/LiveKit/Track/Track+SharedEngine.swift
new file mode 100644
index 0000000..2a5a40e
--- /dev/null
+++ b/Sources/LiveKit/Track/Track+SharedEngine.swift
@@ -0,0 +1,34 @@
+import Foundation
+
+internal import LiveKitWebRTC
+
+public extension Track {
+    /// Whether the underlying WebRTC track sends. An app running several meetings on one
+    /// shared audio engine (SharedPeerConnectionFactory) enables only the talk meeting's
+    /// microphone sender. Blocks briefly on the RTC executor, like the SDK's own sync APIs.
+    var sharedEngineSenderEnabled: Bool {
+        get { mediaTrack.blocking { $0.isEnabled } }
+        set { mediaTrack.blocking { $0.isEnabled = newValue } }
+    }
+}
+
+public extension LocalAudioTrack {
+    /// Creates an enabled track backed by an external synthetic PCM source (`deliverSyntheticPCMInt16`),
+    /// bypassing hardware ADM recording and microphone permission checks.
+    static func createSyntheticVoiceTrack(name: String = "voice-reply") async -> LocalAudioTrack {
+        await RTC.run {
+            let source = RTC.peerConnectionFactory.syntheticAudioSource()
+            let rtcTrack = RTC.peerConnectionFactory.audioTrack(with: source, trackId: UUID().uuidString)
+            rtcTrack.isEnabled = true
+            let mediaTrack = RTCMediaTrack(rtcTrack)
+            return LocalAudioTrack(
+                name: name,
+                source: .microphone,
+                track: mediaTrack,
+                reportStatistics: false,
+                captureOptions: .noProcessing,
+                syntheticSource: source
+            )
+        }
+    }
+}
