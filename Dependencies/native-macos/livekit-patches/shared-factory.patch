+/*
+ * Rock'N'Roll for Mac patch (Dependencies/native-macos/livekit-patches/shared-factory.patch).
+ * Licensed under the Apache License, Version 2.0, like the rest of this SDK.
+ */
+
+import Foundation
+
+internal import LiveKitWebRTC
+
+/// Lets an app run LiveKit rooms on a WebRTC factory (and its audio device module) that it
+/// also uses for other calls, so every call shares one audio engine and echo canceller.
+public enum SharedPeerConnectionFactory {
+    /// Hands the SDK the app's `LKRTCPeerConnectionFactory`. Must run before any LiveKit API
+    /// touches WebRTC; returns false when the SDK already created its own factory or the
+    /// object is not a factory.
+    @discardableResult
+    public static func install(_ factory: AnyObject) -> Bool {
+        guard let factory = factory as? LKRTCPeerConnectionFactory else { return false }
+        return RTC.pcFactoryState.mutate { state -> Bool in
+            guard !state.isInitialized, RTC.injectedPeerConnectionFactory == nil else { return false }
+            RTC.injectedPeerConnectionFactory = factory
+            return true
+        }
+    }
+
+    /// The SDK runs on a factory the app supplied.
+    public static var isInstalled: Bool { RTC.injectedPeerConnectionFactory != nil }
+
+    /// The SDK's audio processing module (an `LKRTCDefaultAudioProcessingModule`). Create the
+    /// shared factory with it, so LiveKit's capture and render hooks (the local frame watcher
+    /// that publishing waits for, custom processing) see the shared audio.
+    public static var audioProcessingModule: AnyObject { RTC.audioProcessingModule }
+
+    /// The SDK's video encoder factory (simulcast) and decoder factory, so LiveKit rooms on the
+    /// shared factory publish and receive video exactly as on the SDK's own.
+    public static var videoEncoderFactory: AnyObject { RTC.encoderFactory }
+    public static var videoDecoderFactory: AnyObject { RTC.decoderFactory }
+}
