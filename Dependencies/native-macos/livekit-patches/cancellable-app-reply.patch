+++ b/Sources/LiveKit/Audio/NativeAppReplyPlayer.swift
@@ -0,0 +1,171 @@
+/*
+ * Rock'N'Roll for Mac patch (Dependencies/native-macos/livekit-patches/cancellable-app-reply.patch).
+ * Licensed under the Apache License, Version 2.0, like the rest of this SDK.
+ */
+
+#if os(macOS)
+@preconcurrency import AVFoundation
+import Foundation
+
+/// One cancellable speech buffer on the SDK's outgoing mixer, with an optional
+/// local copy on its separate output mixer. Ordinary app audio has its own node.
+final class NativeAppReplyPlayer: @unchecked Sendable {
+    let node = AVAudioPlayerNode()
+    let monitor = AVAudioPlayerNode()
+    private enum Path: Sendable { case outgoing, local }
+    private struct Route {
+        let id = UUID()
+        let format: AVAudioFormat
+        weak var mixer: AVAudioMixerNode?
+    }
+    private struct Active {
+        let id: UUID
+        let continuation: CheckedContinuation<Bool, Never>
+        var outgoing = true
+        var local: Bool
+    }
+    private let lock = NSLock()
+    private var route: Route?
+    private var monitorRoute: Route?
+    private var active: Active?
+
+    func connect(to mixer: AVAudioMixerNode, engine: AVAudioEngine, format: AVAudioFormat) {
+        lock.lock()
+        route = nil
+        let current = takeActive()
+        lock.unlock()
+        current?.resume(returning: false)
+        engine.connect(node, to: mixer, format: format)
+        lock.lock()
+        route = Route(format: format, mixer: mixer)
+        lock.unlock()
+    }
+
+    func connectMonitor(to mixer: AVAudioMixerNode, engine: AVAudioEngine, format: AVAudioFormat) {
+        guard let pcm = AVAudioFormat(standardFormatWithSampleRate: format.sampleRate, channels: format.channelCount)
+        else { return }
+        lock.lock()
+        guard route?.mixer !== mixer, monitorRoute?.mixer !== mixer || monitorRoute?.format != pcm else {
+            lock.unlock()
+            return
+        }
+        monitorRoute = nil
+        let current = takeActive()
+        lock.unlock()
+        current?.resume(returning: false)
+        engine.connect(monitor, to: mixer, format: pcm)
+        lock.lock()
+        monitorRoute = Route(format: pcm, mixer: mixer)
+        lock.unlock()
+    }
+
+    func setMonitorGain(_ gain: Float) {
+        lock.lock(); defer { lock.unlock() }
+        if active?.local == true { monitor.volume = gain }
+    }
+
+    func interrupt() {
+        lock.lock()
+        let current = takeActive()
+        lock.unlock()
+        current?.resume(returning: false)
+    }
+
+    func invalidateRoute() {
+        lock.lock()
+        route = nil
+        monitorRoute = nil
+        let current = takeActive()
+        lock.unlock()
+        current?.resume(returning: false)
+    }
+
+    @MainActor func play(_ buffer: AVAudioPCMBuffer, localGain: Float? = nil, canStart: @MainActor () -> Bool) async -> Bool {
+        let (outgoing, local) = currentRoutes()
+        guard !Task.isCancelled, let outgoing, let converted = Self.convert(buffer, to: outgoing.format)
+        else { return false }
+        let mirror = localGain.flatMap { gain in
+            gain > 0 ? local.flatMap { Self.convert(buffer, to: $0.format) } : nil
+        }
+        guard localGain == nil || mirror != nil else { return false }
+        let duration = Double(converted.frameLength) / outgoing.format.sampleRate
+        guard duration.isFinite, duration > 0 else { return false }
+
+        let id = UUID()
+        return await withTaskCancellationHandler {
+            await withCheckedContinuation { continuation in
+                guard canStart() else { continuation.resume(returning: false); return }
+                lock.lock()
+                guard !Task.isCancelled, route?.id == outgoing.id, active == nil,
+                      let engine = node.engine, engine.isRunning,
+                      mirror == nil || (monitorRoute?.id == local?.id &&
+                          monitor.engine?.isRunning == true && monitorRoute?.mixer !== route?.mixer) else {
+                    lock.unlock()
+                    continuation.resume(returning: false)
+                    return
+                }
+                active = Active(id: id, continuation: continuation, local: mirror != nil)
+                schedule(converted, on: node, path: .outgoing, id: id)
+                if let mirror, let localGain {
+                    monitor.volume = localGain
+                    schedule(mirror, on: monitor, path: .local, id: id)
+                }
+                lock.unlock()
+                DispatchQueue.global(qos: .userInitiated).asyncAfter(deadline: .now() + duration + 2) { [weak self] in
+                    self?.finish(id)
+                }
+            }
+        } onCancel: {
+            self.finish(id)
+        }
+    }
+
+    private func schedule(_ buffer: AVAudioPCMBuffer, on player: AVAudioPlayerNode, path: Path, id: UUID) {
+        player.scheduleBuffer(buffer, completionCallbackType: .dataRendered) { [weak self] _ in
+            // A stopped buffer also generates a callback. Stop clears its token first.
+            DispatchQueue.global(qos: .userInitiated).async { [weak self] in
+                self?.finish(id, rendered: path)
+            }
+        }
+        player.play()
+    }
+
+    private func currentRoutes() -> (Route?, Route?) {
+        lock.lock(); defer { lock.unlock() }
+        return (route, monitorRoute)
+    }
+
+    private func finish(_ id: UUID, rendered path: Path? = nil) {
+        lock.lock()
+        guard var current = active, current.id == id else { lock.unlock(); return }
+        let completed = path != nil && node.engine?.isRunning == true &&
+            (path != .local || monitor.engine?.isRunning == true)
+        if completed {
+            if path == .outgoing { current.outgoing = false } else { current.local = false }
+            if current.outgoing || current.local {
+                active = current
+                lock.unlock()
+                return
+            }
+        }
+        let continuation = takeActive()
+        lock.unlock()
+        continuation?.resume(returning: completed)
+    }
+
+    /// The next phrase waits for both players to discard the old buffers.
+    private func takeActive() -> CheckedContinuation<Bool, Never>? {
+        guard let current = active else { return nil }
+        active = nil
+        node.stop()
+        if monitor.engine != nil { monitor.stop() }
+        return current.continuation
+    }
+
+    private static func convert(_ buffer: AVAudioPCMBuffer, to format: AVAudioFormat) -> AVAudioPCMBuffer? {
+        if buffer.format == format { return buffer }
+        let capacity = AudioConverter.frameCapacity(from: buffer.format, to: format, inputFrameCount: buffer.frameLength)
+        return AudioConverter(from: buffer.format, to: format, outputBufferCapacity: capacity)?.convert(from: buffer)
+    }
+}
+#endif
