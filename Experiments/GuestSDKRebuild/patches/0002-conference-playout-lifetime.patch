+  NSHashTable *factories = ConferenceAudioFactories();
+  @synchronized(factories) {
+    gConferencePlayoutReserved.store(reserved != 0, std::memory_order_release);
+    RTC_OBJC_TYPE(RTCPeerConnectionFactory) *current = gConferenceAudioFactory;
+    [current setConferencePlayoutState:reserved ? 1 : 0];
+    if (getenv("CONFERENCE_TEST_MEDIA_TRACE")) {
+      NSLog(@"Conference output reservation=%d live-factories=%lu current=%p", reserved,
+            (unsigned long)factories.count, current);
+    }
+  }
+}
