+- (void)registerConferencePlayout {
+  if (!_nativeAudioDeviceModule || !_workerThread) return;
+  NSHashTable *factories = ConferenceAudioFactories();
+  @synchronized(factories) {
+    if (!_conferencePlayoutState) _conferencePlayoutState = std::make_shared<std::atomic<int>>(0);
+    [factories addObject:self];
+    RTC_OBJC_TYPE(RTCPeerConnectionFactory) *previous = gConferenceAudioFactory;
+    gConferenceAudioFactory = self;
+    if (previous != self) [previous setConferencePlayoutState:-1];
+    [self setConferencePlayoutState:gConferencePlayoutReserved.load(std::memory_order_acquire) ? 1 : 0];
+  }
 }
 
+- (void)setConferencePlayoutState:(int)state {
+  auto adm = _nativeAudioDeviceModule;
+  auto desired = _conferencePlayoutState;
+  if (!adm || !_workerThread || !desired) return;
+  desired->store(state, std::memory_order_release);
+  // Retain native state, not the factory: its last reference must not be
+  // released from a task running on the factory's own worker thread.
+  _workerThread->PostTask([adm, desired] {
+    const int requested = desired->load(std::memory_order_acquire);
+    const int result = requested < 0 ? adm->RetireConferencePlayout()
+                                    : adm->SetConferencePlayoutReserved(requested > 0);
+    if (result != 0 || getenv("CONFERENCE_TEST_MEDIA_TRACE")) {
+      NSLog(@"Conference output ADM=%p state=%d result=%d playing=%d recording=%d",
+            adm.get(), requested, result, adm->Playing(), adm->Recording());
+    }
+  });
+}
