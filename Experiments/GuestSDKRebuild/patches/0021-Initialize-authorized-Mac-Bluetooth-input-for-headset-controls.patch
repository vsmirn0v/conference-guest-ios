+// Core Audio HAL is public on macOS but omitted from the iOS SDK. Query the
+// actual default input transport instead of relying on compatibility-runtime
+// AVAudioSession port strings (which differ from iOS HFP port identifiers).
+static bool MacHasBluetoothInput() {
+  struct PropertyAddress { UInt32 selector, scope, element; };
+  using GetProperty = OSStatus (*)(UInt32, const PropertyAddress*, UInt32,
+                                  const void*, UInt32*, void*);
+  auto get = reinterpret_cast<GetProperty>(
+      dlsym(RTLD_DEFAULT, "AudioObjectGetPropertyData"));
+  if (!get) return false;
+  PropertyAddress address{0x64496E20 /* dIn  */, 0x676C6F62 /* glob */, 0};
+  UInt32 device = 0, size = sizeof(device);
+  if (get(1 /* kAudioObjectSystemObject */, &address, 0, nullptr, &size,
+          &device) != noErr || size != sizeof(device) || !device) return false;
+  address.selector = 0x7472616E;  // kAudioDevicePropertyTransportType: tran
+  UInt32 transport = 0;
+  size = sizeof(transport);
+  if (get(device, &address, 0, nullptr, &size, &transport) != noErr ||
+      size != sizeof(transport)) return false;
+  return transport == 0x626C7565 /* blue */ || transport == 0x626C6561 /* blea */;
+}
