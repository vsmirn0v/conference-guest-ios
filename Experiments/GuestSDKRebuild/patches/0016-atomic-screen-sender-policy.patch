   RTC_OBJC_TYPE(RTCPeerConnectionFactory) * _factory;
@@ -30,6 +33,28 @@ - (NSString *)senderId {
   return [NSString stringForStdString:_nativeRtpSender->id()];
 }
 
+- (BOOL)conferencePreserveScreenResolution:(NSString *)expectedTrackID {
+  auto native = _nativeRtpSender;
+  auto* thread = _factory.signalingThread;
+  if (!native || !thread || !expectedTrackID.length) return NO;
+  auto* proxy = dynamic_cast<webrtc::RtpSenderProxyWithInternal<webrtc::RtpSenderInternal>*>(native.get());
+  if (!proxy) return NO;
+  std::string expected = [expectedTrackID stdString];
+  return thread->BlockingCall([proxy, expected = std::move(expected)] {
+    auto* sender = proxy->internal();
+    if (sender->media_type() != webrtc::MediaType::VIDEO) return false;
+    auto track = sender->track();
+    if (!track || track->id() != expected) return false;
+    // These internal methods preserve outstanding public parameter transactions.
+    // Execute the entire read/change/write on the sender's signaling thread.
+    auto parameters = sender->GetParametersInternal(false, true);
+    if (parameters.encodings.empty()) return false;  // Includes stopped senders.
+    if (parameters.degradation_preference == webrtc::DegradationPreference::MAINTAIN_RESOLUTION) return true;
+    parameters.degradation_preference = webrtc::DegradationPreference::MAINTAIN_RESOLUTION;
+    return sender->SetParametersInternalWithAllLayers(parameters).ok();
+  });
+}
+
 - (RTC_OBJC_TYPE(RTCRtpParameters) *)parameters {
   return [[RTC_OBJC_TYPE(RTCRtpParameters) alloc]
       initWithNativeParameters:_nativeRtpSender->GetParameters()];
@@ -144,3 +169,12 @@ - (void)setFrameEncryptor:
 }
 
 @end
+
+int RTCSetScreenShareSenderResolution(void *sender, const char *track_id) {
+  if (!sender || !track_id) return 0;
+  id object = (__bridge id)sender;
+  if (![object isKindOfClass:[RTC_OBJC_TYPE(RTCRtpSender) class]]) return 0;
+  NSString* expected = [NSString stringWithUTF8String:track_id];
+  if (!expected || !expected.length) return 0;
+  return [object conferencePreserveScreenResolution:expected] ? 1 : 0;
+}
