+  // Prepare before the managed ADM is exposed to SDK media requests.
+  bool Prepare(std::shared_ptr<std::atomic<int>> authority) {
+    if (authority_ || !authority) return false;
+    authority_ = std::move(authority);
+    phase_ = Phase::kPending;
+    ClearIntent();
+    ++generation_;
+    return true;
+  }
+
+  bool managed() const { return authority_ != nullptr; }
+  bool admitted() const {
+    return !authority_ ||
+           (phase_ == Phase::kAdmitted &&
+            authority_->load(std::memory_order_acquire) >= 0);
+  }
+  // Desired reservation, not permission to touch hardware; check admitted too.
+  bool reserved() const {
+    return authority_ && authority_->load(std::memory_order_acquire) ==
+                             kConferenceAudioReserved;
+  }
+  bool should_play() const {
+    return admitted() && (reserved() || wants_playout_start());
+  }
+
+  bool Grant() {
+    if (!authority_) return true;
+    ObserveRevocation();
+    if (authority_->load(std::memory_order_acquire) < 0) return false;
+    if (phase_ != Phase::kAdmitted) ++generation_;
+    phase_ = Phase::kAdmitted;
+    return true;
+  }
+
+  void Retire() {
+    if (!authority_) return;
+    if (phase_ != Phase::kRetired) ++generation_;
+    phase_ = Phase::kRetired;
+    ClearIntent();
+  }
+
+  // Return whether the caller may perform the native operation now. Deferred
+  // SDK requests must be replayed on grant, without recording new SDK intent.
+  bool RequestPlayoutInit() {
+    return Request(playout_init_, playout_start_, false);
+  }
+  bool RequestPlayoutStart() {
+    return Request(playout_init_, playout_start_, true);
+  }
+  bool RequestRecordingInit() {
+    return Request(recording_init_, recording_start_, false);
+  }
+  bool RequestRecordingStart() {
+    return Request(recording_init_, recording_start_, true);
+  }
+  void StopPlayout() {
+    ObserveRevocation();
+    playout_init_ = playout_start_ = false;
+  }
+  void StopRecording() {
+    ObserveRevocation();
+    recording_init_ = recording_start_ = false;
+  }
+
+  bool wants_playout_init() const { return playout_init_; }
+  bool wants_playout_start() const { return playout_start_; }
+  bool wants_recording_init() const { return recording_init_; }
+  bool wants_recording_start() const { return recording_start_; }
+  uint64_t generation() const { return generation_; }
+  bool AllowsCallback(uint64_t generation) const {
+    return generation == generation_ && admitted();
+  }
+
+ private:
+  enum class Phase { kPending, kAdmitted, kRetired };
+
+  void ObserveRevocation() {
+    if (authority_ && authority_->load(std::memory_order_acquire) ==
+                          kConferenceAudioRetired) {
+      Retire();
+    }
+  }
+
+  bool Request(bool& initialized, bool& started, bool start) {
+    ObserveRevocation();
+    if (phase_ == Phase::kRetired) return false;
+    initialized = true;
+    if (start) started = true;
+    return admitted();
+  }
+
+  void ClearIntent() {
+    playout_init_ = playout_start_ = false;
+    recording_init_ = recording_start_ = false;
+  }
+
+  std::shared_ptr<std::atomic<int>> authority_;
+  Phase phase_ = Phase::kAdmitted;
+  bool playout_init_ = false;
+  bool playout_start_ = false;
+  bool recording_init_ = false;
+  bool recording_start_ = false;
+  uint64_t generation_ = 0;
+};
+
+// Called only by the ownership coordinator's serial queue. The driver owns
+// factory lifetimes and executes actions asynchronously on their worker threads.
+class ConferenceAudioOwnership {
+ public:
+  using Owner = uint64_t;
+  enum class Kind { kApply, kRetire };
+  struct Action {
+    uint64_t id;
+    Owner owner;
+    Kind kind;
+    bool reserved;
+    uint64_t revision;
+  };
+
+  // Zero selects no owner. Reselecting the same owner requests a refresh.
+  void Select(Owner owner) {
+    desired_owner_ = owner;
+    RequestChanged();
+  }
+
+  // Reservation and ownership are separate: an unreserved owner is admitted
+  // for ordinary SDK media. Repeating a value explicitly retries or refreshes.
+  void SetReserved(bool reserved) {
+    desired_reserved_ = reserved;
+    RequestChanged();
+  }
+
+  std::optional<Action> Next() {
+    if (in_flight_ || paused_) return std::nullopt;
+    if (active_owner_ && active_owner_ != desired_owner_) {
+      return Issue(active_owner_, Kind::kRetire, false);
+    }
+    if (desired_owner_ && applied_revision_ != revision_) {
+      // An issued apply may already own hardware even before it completes,
+      // fails, or becomes obsolete. Only successful retirement releases it.
+      active_owner_ = desired_owner_;
+      return Issue(desired_owner_, Kind::kApply, desired_reserved_);
+    }
+    return std::nullopt;
+  }
+
+  // Ignore duplicate and stale completions, including completions arriving
+  // while another owner's action is in flight.
+  bool Complete(uint64_t action_id, bool success) {
+    if (!in_flight_ || in_flight_->id != action_id) return false;
+    const Action completed = *in_flight_;
+    in_flight_.reset();
+    if (success) {
+      if (completed.kind == Kind::kRetire) {
+        active_owner_ = 0;
+        applied_revision_ = 0;
+      } else {
+        applied_revision_ = completed.revision;
+      }
+    } else {
+      // One failed attempt per request. A newer request received while the
+      // operation ran already authorizes another attempt; never spin on failure.
+      paused_ = completed.revision == revision_;
+    }
+    return true;
+  }
+
+  Owner active_owner() const { return active_owner_; }
+  Owner desired_owner() const { return desired_owner_; }
+  Owner in_flight_owner() const {
+    return in_flight_ ? in_flight_->owner : 0;
+  }
+  bool desired_reserved() const { return desired_reserved_; }
+  uint64_t revision() const { return revision_; }
+  const std::optional<Action>& in_flight() const { return in_flight_; }
+
+ private:
+  void RequestChanged() {
+    ++revision_;
+    paused_ = false;
+  }
+
+  Action Issue(Owner owner, Kind kind, bool reserved) {
+    in_flight_ = Action{++next_action_id_, owner, kind, reserved, revision_};
+    return *in_flight_;
+  }
+
+  Owner active_owner_ = 0;
+  Owner desired_owner_ = 0;
+  bool desired_reserved_ = false;
+  bool paused_ = false;
+  uint64_t revision_ = 0;
+  uint64_t applied_revision_ = 0;
+  uint64_t next_action_id_ = 0;
+  std::optional<Action> in_flight_;
+};
