--- /dev/null
+++ b/sdk/objc/native/src/audio/audio_unit_recovery.h
@@ -0,0 +1,34 @@
+/* Copyright 2026 Rock'n'Roll contributors. BSD license: see LICENSE. */
+#ifndef SDK_OBJC_NATIVE_SRC_AUDIO_AUDIO_UNIT_RECOVERY_H_
+#define SDK_OBJC_NATIVE_SRC_AUDIO_AUDIO_UNIT_RECOVERY_H_
+
+namespace webrtc::ios_adm {
+// Shared by route updates and microphone transitions. Initialize can dispose an
+// AudioUnit after a property failure: recreate it before the next attempt.
+template <typename Unit>
+bool InitializeAudioUnitForRecovery(Unit& unit, double rate, bool input) {
+  if (unit.GetState() == Unit::kInitRequired && !unit.Init()) return false;
+  return unit.Initialize(rate, input);
+}
+
+template <typename Unit, typename Prepare>
+bool RestartAudioUnitForRecovery(Unit& unit, double rate, bool input,
+                                 Prepare prepare) {
+  const bool was_started = unit.GetState() == Unit::kStarted;
+  if (was_started) {
+    unit.Stop();
+    prepare();
+  }
+  if (unit.GetState() == Unit::kInitialized) unit.Uninitialize();
+  if (!InitializeAudioUnitForRecovery(unit, rate, input)) return false;
+  if (was_started && unit.Start() != 0) {
+    // The failed transition may have configured a new input bus. A delayed
+    // retry must reinitialize using the current recording intent, not retain
+    // a failed unmute's duplex configuration after InitRecording returns -1.
+    unit.Uninitialize();
+    return false;
+  }
+  return true;
+}
+}  // namespace webrtc::ios_adm
+#endif
