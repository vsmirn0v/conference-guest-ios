+namespace {
+webrtc::ios_adm::ApplicationInputMuteState& CurrentApplicationInputMute() {
+  // Process lifetime: audio workers/queued main work can outlive static teardown.
+  static auto* const state = new webrtc::ios_adm::ApplicationInputMuteState;
+  return *state;
+}
+void ScheduleApplicationInputMuteRestore(int delay_ms = 0) {
+  if (!CurrentApplicationInputMute().QueueRestore()) return;
+  dispatch_after(dispatch_time(DISPATCH_TIME_NOW, delay_ms * NSEC_PER_MSEC),
+                 dispatch_get_main_queue(), ^{
+    auto result = CurrentApplicationInputMute().Restore([](bool muted) {
+      if (@available(iOS 17.0, *)) {
+        AVAudioApplication* application = [AVAudioApplication sharedInstance];
+        if (application.isInputMuted != muted) {
+          NSError* error = nil;
+          if (![application setInputMuted:muted error:&error]) {
+            RTCLogError(@"Could not restore application input mute: %@", error);
+            return false;
+          }
+        }
+      }
+      return true;
+    });
+    if (result == webrtc::ios_adm::ApplicationInputMuteState::RestoreResult::kRetry) {
+      ScheduleApplicationInputMuteRestore(250);
+    }
+  });
+}
+}
+
+void RTCSetApplicationInputMuteIntent(int muted) {
+  // ApplicationMicrophoneMute serializes ownership and platform writes on main.
+  RTC_DCHECK([NSThread isMainThread]);
+  auto& state = CurrentApplicationInputMute();
+  state.SetIntent(muted);
+  if (state.IsReconfiguring()) ScheduleApplicationInputMuteRestore();
+}
+int RTCApplicationInputMuteReconfiguring() {
+  return CurrentApplicationInputMute().IsReconfiguring() ? 1 : 0;
+}
