+int RTCConfigureScreenShareEncoderQuality(void *encoder, int max_qp, int prioritize_speed) {
+  if (!encoder) return 0;
+  id object = (__bridge id)encoder;
+  if (![object isKindOfClass:[RTC_OBJC_TYPE(RTCVideoEncoderH264) class]]) return 0;
+  return [object configureConferenceScreenMaxQP:max_qp prioritizeSpeed:prioritize_speed != 0];
+}
