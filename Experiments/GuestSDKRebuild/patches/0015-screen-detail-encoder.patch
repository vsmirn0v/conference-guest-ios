+- (int)configureConferenceScreenMaxQP:(int)maxQP prioritizeSpeed:(BOOL)prioritizeSpeed {
+  if (_codecMode != RTC_OBJC_TYPE(RTCVideoCodecModeScreensharing) ||
+      !_compressionSession || maxQP < 1 || maxQP > 51) {
+    return 0;
+  }
+  if (@available(iOS 15.0, macOS 12.0, *)) {
+    _conferenceScreenMaxQP = maxQP;
+    _conferenceAppliedScreenQP = 0;
+    OSStatus speed = VTSessionSetProperty(_compressionSession,
+        kVTCompressionPropertyKey_PrioritizeEncodingSpeedOverQuality,
+        prioritizeSpeed ? kCFBooleanTrue : kCFBooleanFalse);
+    OSStatus quality = VTSessionSetProperty(_compressionSession,
+        kVTCompressionPropertyKey_MaxAllowedFrameQP, (__bridge CFNumberRef)@([self conferenceScreenQPForBitrate:_targetBitrateBps]));
+    if (speed != noErr || quality != noErr) {
+      _conferenceScreenMaxQP.reset();
+      VTSessionSetProperty(_compressionSession,
+          kVTCompressionPropertyKey_PrioritizeEncodingSpeedOverQuality, kCFBooleanTrue);
+      VTSessionSetProperty(_compressionSession,
+          kVTCompressionPropertyKey_MaxAllowedFrameQP,
+          (__bridge CFNumberRef)@(kHighH264QpThreshold));
+      return 0;
+    }
+    _conferenceAppliedScreenQP = [self conferenceScreenQPForBitrate:_targetBitrateBps];
+    _conferenceScreenPrioritizeSpeed = prioritizeSpeed;
+    RTC_LOG(LS_INFO) << "Conference screen detail maxQP=" << maxQP
+                     << " prioritizeSpeed=" << prioritizeSpeed;
+    return 1;
+  }
+  return 0;
+}
+
+// Calibration uses bits per source pixel per second, not display size or
+// device names. Below 0.0625 the strict floor can starve full-resolution text
+// updates. Keep resolution and quality preference, but allow upstream QP 39.
+// A 25% recovery margin prevents oscillation around the budget boundary.
+- (int)conferenceScreenQPForBitrate:(uint32_t)bitrate {
+  if (!_conferenceScreenMaxQP.has_value()) return kHighH264QpThreshold;
+  const int requested = *_conferenceScreenMaxQP;
+  uint64_t threshold = static_cast<uint64_t>(_width) * _height / 16;
+  if (_conferenceAppliedScreenQP > requested) threshold += threshold / 4;
+  return bitrate < threshold ? std::max(requested, kHighH264QpThreshold) : requested;
+}
+
+- (int)conferenceScreenRates:(uint32_t *)rates count:(int)count {
+  if (!_compressionSession || !rates || count < 4 ||
+      _codecMode != RTC_OBJC_TYPE(RTCVideoCodecModeScreensharing)) return 0;
+  CFTypeRef average = nullptr, frameRate = nullptr, limits = nullptr;
+  VTSessionCopyProperty(_compressionSession, kVTCompressionPropertyKey_AverageBitRate,
+                        kCFAllocatorDefault, &average);
+  VTSessionCopyProperty(_compressionSession, kVTCompressionPropertyKey_ExpectedFrameRate,
+                        kCFAllocatorDefault, &frameRate);
+  VTSessionCopyProperty(_compressionSession, kVTCompressionPropertyKey_DataRateLimits,
+                        kCFAllocatorDefault, &limits);
+  id a = CFBridgingRelease(average), f = CFBridgingRelease(frameRate), l = CFBridgingRelease(limits);
+  if (![a isKindOfClass:[NSNumber class]] || ![f isKindOfClass:[NSNumber class]] ||
+      ![l isKindOfClass:[NSArray class]]) return 0;
+  NSArray* pairs = l;
+  if (!pairs.count || pairs.count % 2 != 0 || pairs.count > static_cast<NSUInteger>(count - 2)) return 0;
+  for (id value in pairs) if (![value isKindOfClass:[NSNumber class]]) return 0;
+  rates[0] = [a unsignedIntValue]; rates[1] = [f unsignedIntValue];
+  for (NSUInteger i = 0; i < pairs.count; ++i) rates[i + 2] = [pairs[i] unsignedIntValue];
+  return static_cast<int>(pairs.count + 2);
+}
