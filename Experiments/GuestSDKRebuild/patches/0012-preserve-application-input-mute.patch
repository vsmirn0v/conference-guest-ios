+// Recreating/activating an iOS input unit can clear the application mute bit.
+// Preserve a muted user intent; never unmute from native device lifecycle work.
+class PreserveApplicationInputMute {
+ public:
+  PreserveApplicationInputMute() {
+    if (@available(iOS 17.0, *)) {
+      if (![NSProcessInfo processInfo].isiOSAppOnMac) {
+        was_muted_ = [AVAudioApplication sharedInstance].isInputMuted;
+      }
+    }
+  }
+  ~PreserveApplicationInputMute() {
+    if (!was_muted_) return;
+    if (@available(iOS 17.0, *)) {
+      AVAudioApplication* application = [AVAudioApplication sharedInstance];
+      if (was_muted_ && !application.isInputMuted) {
+        NSError* error = nil;
+        if (![application setInputMuted:YES error:&error]) {
+          RTCLogError(@"Could not preserve application input mute: %@", error);
+        }
+      }
+    }
+  }
+ private:
+  bool was_muted_ = false;
+};
+
 using ios::CheckAndLogError;
 
