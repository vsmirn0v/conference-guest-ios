+void AudioDeviceIOS::ScheduleAudioUnitRestart() {
+  RTC_DCHECK_RUN_ON(thread_);
+  if (audio_unit_restart_pending_ || audio_unit_restart_attempts_ >= 5 ||
+      is_interrupted_ || !audio_unit_ ||
+      (!playing_.load() && !recording_.load())) return;
+  audio_unit_restart_pending_ = true;
+  ++audio_unit_restart_attempts_;
+  const uint64_t generation = audio_unit_restart_generation_;
+  thread_->PostDelayedTask(SafeTask(safety_, [this, generation] {
+    if (generation != audio_unit_restart_generation_) return;
+    audio_unit_restart_pending_ = false;
+    if (is_interrupted_ || !audio_unit_ ||
+        (!playing_.load() && !recording_.load())) return;
+    RTC_OBJC_TYPE(RTCAudioSession)* session =
+        [RTC_OBJC_TYPE(RTCAudioSession) sharedInstance];
+    if (!session.canPlayOrRecord) return;
+    HandleSampleRateChange();
+    UpdateAudioUnit(session.canPlayOrRecord);
+    RTCLog(@"Route restart attempt %d, audio unit state %d",
+           audio_unit_restart_attempts_, audio_unit_->GetState());
+  }), TimeDelta::Millis(250));
+}
