+  std::shared_ptr<std::atomic<int>> admission;
+};
+struct ConferenceAudioCoordinator {
+  ConferenceOwnership ownership;
+  std::map<ConferenceOwnership::Owner, ConferenceAudioOwner> owners;
+};
+ConferenceAudioCoordinator &ConferenceCoordinator() {
+  static auto *coordinator = new ConferenceAudioCoordinator;
+  return *coordinator;
+}
+dispatch_queue_t ConferenceControlQueue() {
+  static dispatch_queue_t queue;
+  static dispatch_once_t once;
+  dispatch_once(&once, ^{
+    queue = dispatch_queue_create("org.webrtc.conference-audio-ownership", DISPATCH_QUEUE_SERIAL);
+  });
+  return queue;
+}
+#if defined(WEBRTC_IOS)
+std::atomic<uint64_t> gNextConferenceAudioOwner{0};
