+void SyntheticAudioSource::RemoveSink(AudioTrackSinkInterface* sink) {
+  std::lock_guard<std::mutex> lock(sinks_mutex_);
+  sinks_.erase(std::remove(sinks_.begin(), sinks_.end(), sink), sinks_.end());
+}
+
+void SyntheticAudioSource::DeliverPCM16(const int16_t* samples,
+                                        size_t frames_per_channel,
+                                        int sample_rate_hz,
+                                        size_t num_channels) {
+  if (!samples || frames_per_channel == 0 || sample_rate_hz <= 0 ||
+      num_channels == 0) {
+    return;
+  }
+  std::lock_guard<std::mutex> deliver_lock(deliver_mutex_);
+  std::vector<AudioTrackSinkInterface*> sinks_snapshot;
+  {
+    std::lock_guard<std::mutex> lock(sinks_mutex_);
+    sinks_snapshot = sinks_;
+  }
+  for (AudioTrackSinkInterface* sink : sinks_snapshot) {
+    sink->OnData(samples, 16, sample_rate_hz, num_channels,
+                 frames_per_channel, std::nullopt);
+  }
+}
