+bool Latency(AudioDeviceID device, AudioObjectPropertyScope scope, double rate, uint32_t* microseconds) {
+  UInt32 device_frames = 0;
+  if (!Property(device, kAudioDevicePropertyLatency, scope, &device_frames)) return false;
+  AudioObjectPropertyAddress address{kAudioDevicePropertyStreams, scope, kAudioObjectPropertyElementMain};
+  UInt32 bytes = 0;
+  if (AudioObjectGetPropertyDataSize(device, &address, 0, nullptr, &bytes) != noErr ||
+      !bytes || bytes % sizeof(AudioStreamID) || bytes / sizeof(AudioStreamID) > 64) return false;
+  std::array<AudioStreamID, 64> streams{};
+  const UInt32 expected = bytes;
+  if (AudioObjectGetPropertyData(device, &address, 0, nullptr, &bytes, streams.data()) != noErr || bytes != expected) return false;
+  UInt32 stream_frames = 0;
+  for (size_t i = 0; i < bytes / sizeof(AudioStreamID); ++i) {
+    UInt32 frames = 0;
