+  // WebRtcVoiceEngine ignores their errors before destroying AudioState. There
+  // is no HAL call/join here and no caller lock may be held. On timeout the
+  // actual AudioState owner pin AND the complete ADM anchor remain quarantined.
+  const double deadline = requested_deadline > 0 ? requested_deadline : ExperimentalCoreAudioUptime() + 2;
