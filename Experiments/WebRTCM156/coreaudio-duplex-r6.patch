+bool AudioDeviceMacDuplex::InstallListeners() {
+  auto add = [this](AudioObjectID object, AudioObjectPropertySelector selector, AudioObjectPropertyScope scope, bool optional) {
+    AudioObjectPropertyAddress address{selector, scope, kAudioObjectPropertyElementMain};
+    if (optional && !AudioObjectHasProperty(object, &address)) return true;
+    auto slot = std::find_if(listeners_.begin(), listeners_.end(), [](const auto& entry) { return !entry.cell; });
+    if (slot == listeners_.end()) { Error(-8, true); return false; }
+    auto* cell = ExperimentalCoreAudioCallbackCells().Allocate(this);
+    if (!cell) { Error(-8, true); return false; }
+    slot->object = object; slot->address = address; slot->cell = cell;
+    if (!cell->Open()) { Error(-10, true); return false; }
+    const auto result = AudioObjectAddPropertyListener(object, &address, ListenerProc, cell);
+    if (result != noErr) { cell->Close(); Error(result, true); return false; }
+    slot->installed = true;
+    return true;
+  };
+  return add(kAudioObjectSystemObject, kAudioHardwarePropertyDevices, kAudioObjectPropertyScopeGlobal, false) &&
+      add(kAudioObjectSystemObject, kAudioHardwarePropertyDefaultInputDevice, kAudioObjectPropertyScopeGlobal, false) &&
+      add(kAudioObjectSystemObject, kAudioHardwarePropertyDefaultOutputDevice, kAudioObjectPropertyScopeGlobal, false) &&
+      add(selected_.input, kAudioDevicePropertyStreamFormat, kAudioDevicePropertyScopeInput, false) &&
+      add(selected_.output, kAudioDevicePropertyStreamFormat, kAudioDevicePropertyScopeOutput, false) &&
+      add(selected_.input, kAudioDevicePropertyDataSource, kAudioDevicePropertyScopeInput, true) &&
+      add(selected_.output, kAudioDevicePropertyDataSource, kAudioDevicePropertyScopeOutput, true) &&
+      add(selected_.input, kAudioDevicePropertyDeviceIsAlive, kAudioObjectPropertyScopeGlobal, false) &&
+      add(selected_.output, kAudioDevicePropertyDeviceIsAlive, kAudioObjectPropertyScopeGlobal, false);
+}
+bool AudioDeviceMacDuplex::Drain(ExperimentalCoreAudioCallbackCell* cell, uint64_t deadline) {
+  if (!cell) return true;
+  cell->Close();
+  while (!cell->ClosedAndDrained() && Now() < deadline) Poll();
+  if (cell->ClosedAndDrained()) return true;
+  Error(-9, true); return false;
+}
+bool AudioDeviceMacDuplex::RemoveListeners(uint64_t deadline) {
+  bool success = true;
+  for (auto& entry : listeners_) {
+    if (!entry.cell) continue;
+    entry.cell->Close();
+    if (entry.installed) {
+      const auto status = AudioObjectRemovePropertyListener(entry.object, &entry.address, ListenerProc, entry.cell);
+      if (status != noErr) { Error(status, true); success = false; }
+      else entry.installed = false;
+    }
+    if (!Drain(entry.cell, deadline)) success = false;
+  }
+  return success;
+}
+void AudioDeviceMacDuplex::RouteChanged(AudioObjectID object, const AudioObjectPropertyAddress& address) {
+  const bool negotiable = negotiating_.load(std::memory_order_acquire) &&
+      address.mSelector == kAudioDevicePropertyStreamFormat &&
+      ((object == selected_.input && address.mScope == kAudioDevicePropertyScopeInput) ||
+       (object == selected_.output && address.mScope == kAudioDevicePropertyScopeOutput));
+  const uint64_t word = authority_.RouteEvent();
+  owner_.experimental_observed_route_generation_.fetch_add(1, std::memory_order_acq_rel);
+  const size_t slot = event_count_.fetch_add(1, std::memory_order_acq_rel);
+  if (slot < events_.size()) {
+    auto& event = events_[slot]; event.word = word; event.nanos = Now();
+    event.object = object; event.selector = address.mSelector; event.scope = address.mScope;
+    event.ready.store(true, std::memory_order_release);
+  } else authority_.FailTerminal();
+  if (!negotiable || (word & Authority::kTerminal) || slot >= events_.size()) {
+    authority_.FailTerminal();
+    const auto origin = address.mSelector == kAudioDevicePropertyStreamFormat ? AudioDeviceMac::ErrorOrigin::kStreamFormat :
+        address.mSelector == kAudioDevicePropertyDataSource ? AudioDeviceMac::ErrorOrigin::kDataSource : AudioDeviceMac::ErrorOrigin::kDeviceList;
+    owner_.RecordExperimentalCoreAudioError(-6, origin, __LINE__, object, address.mSelector, address.mScope);
+  }
+  if (owner_._ptrAudioBuffer) owner_._ptrAudioBuffer->SetExperimentalCoreAudioCaptureMuted(true);
+}
+OSStatus AudioDeviceMacDuplex::ListenerProc(AudioObjectID object, UInt32 count,
+    const AudioObjectPropertyAddress addresses[], void* context) {
+  ExperimentalCoreAudioCallbackCell::Lease lease(static_cast<ExperimentalCoreAudioCallbackCell*>(context));
+  auto* owner = static_cast<AudioDeviceMacDuplex*>(lease.owner());
+  if (owner) for (UInt32 i = 0; i < std::min<UInt32>(count, 64); ++i) owner->RouteChanged(object, addresses[i]);
+  if (owner && count > 64) owner->Error(kAdmission);
+  return noErr;
+}
+bool AudioDeviceMacDuplex::StartRawInput(uint64_t intent, uint64_t deadline) {
+  auto& io = owner_.experimental_input_io_;
+  if (io.started) return true;
+  if (!io.created) {
+  io.cell = ExperimentalCoreAudioCallbackCells().Allocate(this);
+  if (!io.cell) { Error(-8, true); return false; }
+  io.device = selected_.input; ++io.serial;
+  const auto created = AudioDeviceCreateIOProcID(io.device, InputProc, io.cell, &io.proc);
+  if (created != noErr) { Error(created, true); return false; }
+  io.created = true; io.proof.store(AudioDeviceMac::kCreated, std::memory_order_release);
+  input_create_count_.fetch_add(1, std::memory_order_release);
+  if (!io.cell->Open()) { Error(-10, true); return false; }
+  owner_._inDeviceIOProcID = io.proc; owner_._recIsInitialized = true;
+  input_initialized_.store(true, std::memory_order_release);
+  }
+  if (!Current(intent, deadline)) return false;
+  const auto started = AudioDeviceStart(io.device, io.proc);
+  if (started != noErr) { Error(started, true); return false; }
+  io.started = true; io.proof.fetch_or(AudioDeviceMac::kStarted, std::memory_order_release);
+  input_start_count_.fetch_add(1, std::memory_order_release);
+  owner_._recording = true;
+  return true;
+}
+OSStatus AudioDeviceMacDuplex::InputProc(AudioDeviceID, const AudioTimeStamp*, const AudioBufferList* data,
+    const AudioTimeStamp* time, AudioBufferList*, const AudioTimeStamp*, void* context) {
+  ExperimentalCoreAudioCallbackCell::Lease lease(static_cast<ExperimentalCoreAudioCallbackCell*>(context));
+  auto* owner = static_cast<AudioDeviceMacDuplex*>(lease.owner());
+  return owner ? owner->Input(data, time) : noErr;
+}
+OSStatus AudioDeviceMacDuplex::Input(const AudioBufferList* data, const AudioTimeStamp* time) {
+  const uint64_t now = Now();
+  uint64_t unset = 0; first_input_.compare_exchange_strong(unset, now, std::memory_order_release);
+  last_input_.store(now, std::memory_order_release);
+  if (data) {
+    input_buffers_.store(data->mNumberBuffers, std::memory_order_relaxed);
+    if (data->mNumberBuffers == 1) {
+      input_channels_.store(data->mBuffers[0].mNumberChannels, std::memory_order_relaxed);
+      input_bytes_.store(data->mBuffers[0].mDataByteSize, std::memory_order_relaxed);
+    }
+  }
+  callbacks_.fetch_add(1, std::memory_order_release);
+  auto* target = capture_target_.load(std::memory_order_acquire);
+  if (!target) return noErr;
+  ExperimentalCoreAudioCallbackCell::Lease admission(target);
+  auto* generation = static_cast<CaptureGeneration*>(admission.owner());
+  if (!generation || !data || !time || !(time->mFlags & kAudioTimeStampHostTimeValid) ||
+      AudioConvertHostTimeToNanos(time->mHostTime) <= generation->cutoff_host) return noErr;
+  const uint64_t authority = authority_.Read();
+  if ((authority & Authority::kTerminal) || !recording_demand_.load(std::memory_order_acquire)) return noErr;
+  if (data->mNumberBuffers != 1) { Error(kAdmission, true); return noErr; }
+  const auto& b = data->mBuffers[0];
+  if (!b.mData || !ExperimentalCoreAudioDuplexBufferShape(1, b.mNumberChannels, b.mDataByteSize,
+      generation->source.mChannelsPerFrame, generation->source.mBytesPerFrame,
+      kCaptureSamples / generation->source.mChannelsPerFrame)) {
+    Error(kAdmission, true); return noErr;
+  }
+  const auto samples = std::span<const float>(static_cast<const float*>(b.mData), b.mDataByteSize / sizeof(float));
+  double energy = 0;
+  for (float sample : samples) {
+    if (!std::isfinite(sample) || sample < -8 || sample > 8) { Error(kAdmission, true); return noErr; }
+    energy += double(sample) * sample;
+  }
+  auto* buffer = owner_._ptrAudioBuffer;
+  const uint64_t input_nanos = AudioConvertHostTimeToNanos(time->mHostTime);
+  const uint64_t current_nanos = AudioConvertHostTimeToNanos(AudioGetCurrentHostTime());
+  const double queue_delay = double(generation->ring.AvailableToRead()) * 1e6 /
+      generation->source.mChannelsPerFrame / generation->source.mSampleRate;
+  const double callback_delay = double(current_nanos >= input_nanos ? current_nanos - input_nanos : 0) * 1e-3 + queue_delay;
+  if (!std::isfinite(callback_delay) || callback_delay > INT32_MAX) { Error(kAdmission); return noErr; }
+  generation->callback_delay_us.store(uint32_t(callback_delay), std::memory_order_release);
+  owner_._captureDelayUs.store(int32_t(callback_delay), std::memory_order_release);
+  buffer->RecordExperimentalCoreAudioInput(uint64_t(energy * 1073741824.0), samples.size(), true);
+  if (!generation->ring.Write(samples, buffer->ExperimentalCoreAudioCaptureState(), ApplicationCaptureState())) {
+    input_drops_.fetch_add(1, std::memory_order_release);
+    Error(kAdmission); return noErr;
+  }
+  const auto signal = semaphore_signal(owner_._captureSemaphore);
+  if (signal != KERN_SUCCESS) Error(signal, true);
+  return noErr;
+}
+bool AudioDeviceMacDuplex::StableRoute(Route* route, uint64_t* validated_word, uint64_t intent, uint64_t deadline) {
+  while (Current(intent, deadline)) {
+    const uint64_t word = authority_.Read(), count = callbacks_.load(std::memory_order_acquire);
+    Route before, after;
+    if (!ReadRoute(&before)) { Error(kAdmission); return false; }
+    while (Current(intent, deadline) && callbacks_.load(std::memory_order_acquire) < count + 2) Poll();
+    if (!Current(intent, deadline)) return false;
+    if (!ReadRoute(&after)) { Error(kAdmission); return false; }
+    if (authority_.Read() != word || !SameRoute(before, after)) continue;
+    if (after.input != selected_.input || after.output != selected_.output ||
+        after.input_uid != selected_.input_uid || after.output_uid != selected_.output_uid ||
+        last_input_.load(std::memory_order_acquire) <= first_input_.load(std::memory_order_acquire) ||
+        !ExperimentalCoreAudioDuplexBufferShape(input_buffers_.load(std::memory_order_acquire),
+            input_channels_.load(std::memory_order_acquire), input_bytes_.load(std::memory_order_acquire),
+            after.input_format.mChannelsPerFrame, after.input_format.mBytesPerFrame,
+            kCaptureSamples / after.input_format.mChannelsPerFrame)) { Error(kAdmission); return false; }
+    *validated_word = word; *route = std::move(after); return true;
+  }
+  return false;
+}
+bool AudioDeviceMacDuplex::BuildCapture(const Route& route, uint64_t cutoff) {
+  if (capture_) return true;
+  if (owner_._ptrAudioBuffer->RecordingChannels() != N_REC_CHANNELS ||
+      owner_._ptrAudioBuffer->RecordingSampleRate() != N_REC_SAMPLES_PER_SEC) { Error(kAdmission); return false; }
+  uint32_t latency = 0;
+  if (!Latency(route.input, kAudioDevicePropertyScopeInput, route.input_format.mSampleRate, &latency)) { Error(kAdmission); return false; }
+  capture_ = std::make_unique<CaptureGeneration>(*this, route.input_format, cutoff, latency);
+  auto& generation = *capture_;
+  AudioStreamBasicDescription desired{double(N_REC_SAMPLES_PER_SEC), kAudioFormatLinearPCM,
+      kLinearPCMFormatFlagIsSignedInteger | kLinearPCMFormatFlagIsPacked,
+      sizeof(int16_t), 1, sizeof(int16_t), 1, 16, 0};
+  const auto status = AudioConverterNew(&generation.source, &desired, &generation.converter);
+  if (status != noErr) { Error(status, true); return false; }
+  generation.cell = ExperimentalCoreAudioCallbackCells().Allocate(&generation);
+  if (!generation.cell || !generation.cell->Open()) { Error(-8, true); return false; }
+  generation.running.store(true, std::memory_order_release); generation.exited.store(false, std::memory_order_release);
+  generation.worker = PlatformThread::SpawnJoinable([&generation] { generation.Run(); },
+      "R6Capture", ThreadAttributes().SetPriority(ThreadPriority::kRealtime));
+  capture_target_.store(generation.cell, std::memory_order_release);
+  return true;
+}
+bool AudioDeviceMacDuplex::StartOutput(const Route& route) {
+  if (owner_._ptrAudioBuffer->PlayoutChannels() != N_PLAY_CHANNELS ||
+      owner_._ptrAudioBuffer->PlayoutSampleRate() != N_PLAY_SAMPLES_PER_SEC) { Error(kAdmission); return false; }
+  if (owner_._playing && OutputAllowed() && !render_exited_.load(std::memory_order_acquire)) return true;
+  if (owner_._playing && !StopOutput(Now() + 2000000000)) return false;
+  if (!OutputRequested()) return true;
+  const uint64_t output_token = output_authority_.Read();
+  if (output_history_count_.load(std::memory_order_acquire) >= output_history_.size()) { Error(-8, true); return false; }
+  owner_._renderBuffer.Clear();
+  owner_._outStreamFormat = route.output_format;
+  owner_._outDesiredFormat = {double(N_PLAY_SAMPLES_PER_SEC), kAudioFormatLinearPCM,
+      kLinearPCMFormatFlagIsSignedInteger | kLinearPCMFormatFlagIsPacked,
+      sizeof(int16_t) * N_PLAY_CHANNELS, 1, sizeof(int16_t) * N_PLAY_CHANNELS, N_PLAY_CHANNELS, 16, 0};
+  UInt32 native_frames = 0, latency = 0;
+  if (!Property(route.output, kAudioDevicePropertyBufferFrameSize, kAudioObjectPropertyScopeGlobal, &native_frames) || !native_frames ||
+      uint64_t{native_frames} * route.output_format.mChannelsPerFrame > kCaptureSamples ||
+      std::ceil(double(native_frames) * N_PLAY_SAMPLES_PER_SEC / route.output_format.mSampleRate) * N_PLAY_CHANNELS > std::size(owner_._renderConvertData) ||
+      !Latency(route.output, kAudioDevicePropertyScopeOutput, route.output_format.mSampleRate, &latency)) { Error(kAdmission); return false; }
+  render_latency_us_.store(latency, std::memory_order_release);
+  output_frames_capacity_.store(native_frames, std::memory_order_release);
+  owner_._renderDelayOffsetSamples = 0; owner_._renderDelayUs = 0;
+  const auto converted = AudioConverterNew(&owner_._outDesiredFormat, &owner_._outStreamFormat, &owner_._renderConverter);
+  if (converted != noErr) { Error(converted, true); return false; }
+  owner_.experimental_render_converter_owned_ = true;
+  output_start_callbacks_.store(output_callbacks_.load(std::memory_order_acquire), std::memory_order_release);
+  if (owner_.CreateDeviceIOProc(route.output, AudioDeviceMac::deviceIOProc, false, &owner_._deviceIOProcID) != noErr) return false;
+  output_create_count_.fetch_add(1, std::memory_order_release);
+  owner_._playIsInitialized = true; owner_._renderDeviceIsAlive = 1; owner_._doStop = false;
+  output_initialized_.store(true, std::memory_order_release);
+  render_exited_.store(false, std::memory_order_release);
+  owner_.render_worker_thread_ = PlatformThread::SpawnJoinable([this] {
+    while (owner_.RenderWorkerThread()) {}
+    render_exited_.store(true, std::memory_order_release);
+  }, "R6Render", ThreadAttributes().SetPriority(ThreadPriority::kRealtime));
+  if (!OutputRequested() || output_authority_.Read() != output_token) return StopOutput(Now() + 2000000000);
+  const auto started = AudioDeviceStart(route.output, owner_._deviceIOProcID);
+  if (started != noErr) { Error(started, true); return false; }
+  owner_.experimental_output_io_.started = true;
+  owner_.experimental_output_io_.proof.fetch_or(AudioDeviceMac::kStarted, std::memory_order_release);
+  output_start_count_.fetch_add(1, std::memory_order_release);
+  owner_._playing = true;
+  if (!OutputRequested() || !output_authority_.Authorize(output_token)) return StopOutput(Now() + 2000000000);
+  return true;
+}
+bool AudioDeviceMacDuplex::StopOutput(uint64_t deadline) {
+  if (!output_authority_.Revoke()) authority_.FailTerminal();
+  auto& io = owner_.experimental_output_io_;
+  uint64_t required = AudioDeviceMac::kWorkerJoined | AudioDeviceMac::kConverterDisposed | AudioDeviceMac::kListenersRemoved;
+  if (io.cell) required |= AudioDeviceMac::kCellClosed | AudioDeviceMac::kCellDrained;
+  if (io.created) required |= AudioDeviceMac::kDestroyed;
+  if (io.started) required |= AudioDeviceMac::kStopSucceeded;
+  io.required_proof.fetch_or(required, std::memory_order_release);
+  owner_._playing = false;
+  if (io.cell) {
+    io.cell->Close(); io.proof.fetch_or(AudioDeviceMac::kCellClosed, std::memory_order_release);
+    if (!Drain(io.cell, deadline)) return false;
+    io.proof.fetch_or(AudioDeviceMac::kCellDrained, std::memory_order_release);
+  }
+  if (io.started && !(io.proof.load(std::memory_order_acquire) & AudioDeviceMac::kStopSucceeded)) {
+    const auto status = AudioDeviceStop(io.device, io.proc); io.stop_status.store(status, std::memory_order_release);
+    if (status != noErr) { Error(status, true); return false; }
+    io.proof.fetch_or(AudioDeviceMac::kStopSucceeded, std::memory_order_release);
+  }
+  if (io.created && !(io.proof.load(std::memory_order_acquire) & AudioDeviceMac::kDestroyed)) {
+    const auto status = AudioDeviceDestroyIOProcID(io.device, io.proc); io.destroy_status.store(status, std::memory_order_release);
+    if (status != noErr) { Error(status, true); return false; }
+    io.proof.fetch_or(AudioDeviceMac::kDestroyed, std::memory_order_release);
+  }
+  owner_._renderDeviceIsAlive = 0;
+  if (!owner_.render_worker_thread_.empty()) {
+    const auto wake = semaphore_signal_all(owner_._renderSemaphore);
+    if (wake != KERN_SUCCESS) { Error(wake, true); return false; }
+    while (!render_exited_.load(std::memory_order_acquire) && Now() < deadline) Poll();
+    if (!render_exited_.load(std::memory_order_acquire)) { Error(-9, true); return false; }
+    owner_.render_worker_thread_.Finalize();
+  }
+  io.proof.fetch_or(AudioDeviceMac::kWorkerJoined | AudioDeviceMac::kListenersRemoved, std::memory_order_release);
+  if (owner_.experimental_render_converter_owned_) {
+    const auto status = AudioConverterDispose(owner_._renderConverter);
+    if (status != noErr) { Error(status, true); return false; }
+    owner_.experimental_render_converter_owned_ = false; owner_._renderConverter = nullptr;
+  }
+  io.proof.fetch_or(AudioDeviceMac::kConverterDisposed, std::memory_order_release);
+  if (!ExperimentalCoreAudioRetirementComplete(io.proof.load(std::memory_order_acquire),
+      io.required_proof.load(std::memory_order_acquire), owner_.experimental_unsafe_errors_.mask())) return false;
+  io.proof.fetch_or(AudioDeviceMac::kDirectionClean, std::memory_order_release);
+  if (io.created) {
+    const size_t index = output_history_count_.load(std::memory_order_acquire);
+    if (index >= output_history_.size()) { Error(-8, true); return false; }
+    output_history_[index] = {io.serial, io.proof.load(std::memory_order_acquire), io.required_proof.load(std::memory_order_acquire),
+        io.stop_status.load(std::memory_order_acquire), io.destroy_status.load(std::memory_order_acquire), owner_._outStreamFormat};
+    output_history_count_.store(index + 1, std::memory_order_release);
+  }
+  io.created = false; io.started = false; io.proc = nullptr;
+  owner_._deviceIOProcID = nullptr; owner_._playIsInitialized = false; owner_._renderBuffer.Clear();
+  output_initialized_.store(false, std::memory_order_release);
+  return true;
+}
+bool AudioDeviceMacDuplex::StopInput(uint64_t deadline) {
+  auto& io = owner_.experimental_input_io_;
+  uint64_t required = AudioDeviceMac::kWorkerJoined | AudioDeviceMac::kConverterDisposed | AudioDeviceMac::kListenersRemoved;
+  if (io.cell) required |= AudioDeviceMac::kCellClosed | AudioDeviceMac::kCellDrained;
+  if (io.created) required |= AudioDeviceMac::kDestroyed;
+  if (io.started) required |= AudioDeviceMac::kStopSucceeded;
+  if (capture_ && capture_->cell) required |= AudioDeviceMac::kDataCellClosed | AudioDeviceMac::kDataCellDrained;
+  io.required_proof.fetch_or(required, std::memory_order_release);
+  if (capture_ && capture_->cell) {
+    capture_->cell->Close(); capture_target_.store(nullptr, std::memory_order_release);
+    io.proof.fetch_or(AudioDeviceMac::kDataCellClosed, std::memory_order_release);
+    if (!Drain(capture_->cell, deadline)) return false;
+    io.proof.fetch_or(AudioDeviceMac::kDataCellDrained, std::memory_order_release);
+  }
+  if (io.cell) {
+    io.cell->Close(); io.proof.fetch_or(AudioDeviceMac::kCellClosed, std::memory_order_release);
+    if (!Drain(io.cell, deadline)) return false;
+    io.proof.fetch_or(AudioDeviceMac::kCellDrained, std::memory_order_release);
+  }
+  if (io.started && !(io.proof.load(std::memory_order_acquire) & AudioDeviceMac::kStopSucceeded)) {
+    const auto status = AudioDeviceStop(io.device, io.proc); io.stop_status.store(status, std::memory_order_release);
+    if (status != noErr) { Error(status, true); return false; }
+    io.proof.fetch_or(AudioDeviceMac::kStopSucceeded, std::memory_order_release);
+  }
+  if (io.created && !(io.proof.load(std::memory_order_acquire) & AudioDeviceMac::kDestroyed)) {
+    const auto status = AudioDeviceDestroyIOProcID(io.device, io.proc); io.destroy_status.store(status, std::memory_order_release);
+    if (status != noErr) { Error(status, true); return false; }
+    io.proof.fetch_or(AudioDeviceMac::kDestroyed, std::memory_order_release);
+  }
+  if (capture_) {
+    capture_->running.store(false, std::memory_order_release);
+    const auto wake = semaphore_signal_all(owner_._captureSemaphore);
+    if (wake != KERN_SUCCESS) { Error(wake, true); return false; }
+    while (!capture_->exited.load(std::memory_order_acquire) && Now() < deadline) Poll();
+    if (!capture_->exited.load(std::memory_order_acquire)) { Error(-9, true); return false; }
+    if (!capture_->worker.empty()) capture_->worker.Finalize();
+    if (capture_->converter) {
+      const auto status = AudioConverterDispose(capture_->converter);
+      if (status != noErr) { Error(status, true); return false; }
+      capture_->converter = nullptr;
+    }
+    capture_.reset();
+  }
+  io.proof.fetch_or(AudioDeviceMac::kWorkerJoined | AudioDeviceMac::kConverterDisposed | AudioDeviceMac::kListenersRemoved, std::memory_order_release);
+  if (!ExperimentalCoreAudioRetirementComplete(io.proof.load(std::memory_order_acquire),
+      io.required_proof.load(std::memory_order_acquire), owner_.experimental_unsafe_errors_.mask())) return false;
+  io.proof.fetch_or(AudioDeviceMac::kDirectionClean, std::memory_order_release);
+  io.created = false; io.started = false; io.proc = nullptr;
+  owner_._inDeviceIOProcID = nullptr; owner_._recIsInitialized = false; owner_._recording = false;
+  input_initialized_.store(false, std::memory_order_release);
+  return true;
+}
+bool AudioDeviceMacDuplex::TestHold(uint32_t phase, uint64_t intent, uint64_t deadline) {
+  if (phase != static_cast<uint32_t>(Phase::kReady) || hold_phase_.load(std::memory_order_acquire) != phase) return true;
+  uint64_t until = hold_deadline_.load(std::memory_order_acquire);
+  if (!until) {
+    const uint64_t candidate = std::min(deadline, Now() + uint64_t(std::min(hold_milliseconds_.load(), 1000u)) * 1000000);
+    hold_deadline_.compare_exchange_strong(until, candidate, std::memory_order_acq_rel);
+    if (!until) until = candidate;
+  }
+  hold_active_.store(Now() < until, std::memory_order_release);
+  // Explicit test-only delayed RETURN, never a privacy barrier: sideband
+  // authority revocation remains immediate and callbacks never wait here.
+  // A newer intent must not restart or shorten this one absolute hold window.
+  while (Now() < until) Poll();
+  hold_active_.store(false, std::memory_order_release);
+  return Current(intent, deadline);
+}
+void AudioDeviceMacDuplex::HoldForTesting(uint32_t phase, uint32_t milliseconds) {
+  hold_deadline_.store(0, std::memory_order_release);
+  hold_milliseconds_.store(std::min(milliseconds, 1000u), std::memory_order_release);
+  hold_phase_.store(phase == static_cast<uint32_t>(Phase::kReady) ? phase : 0, std::memory_order_release);
+}
+AudioDeviceModule::ExperimentalCoreAudioDuplexResult AudioDeviceMacDuplex::Prepare(
+    uint64_t expected_intent, double deadline_uptime) {
+  const uint64_t entry = authority_.Read();
+  uint64_t serial = 0;
+  auto finish = [&](int32_t status, uint64_t token) {
+    AudioDeviceModule::ExperimentalCoreAudioDuplexResult result;
+    result.status = status; result.sealed_token = token;
+    result.owner_generation = owner_generation_;
+    result.physical_generation = physical_generation_.load(std::memory_order_acquire);
+    result.prepare_serial = serial; result.expected_intent = expected_intent; result.entry_authority = entry;
+    // This is the actual return/cancellation observation, retained by value.
+    result.observed_authority = authority_.Read(); result.observation_nanos = Now();
+    if (status == 0) result.abort_reason = 0;
+    else if (status == kStale && Authority::Intent(result.observed_authority) != expected_intent)
+      result.abort_reason = result.observed_authority & Authority::kTerminal ? 2 : 1;
+    else if (status == kDeadline) result.abort_reason = 4;
+    else if ((result.observed_authority & Authority::kTerminal) && (result.observed_authority & Authority::kSealed)) result.abort_reason = 3;
+    else if (status == -23) result.abort_reason = 6;
+    else result.abort_reason = 5;
+    return result;
+  };
+  if (Authority::Intent(entry) != expected_intent || (entry & Authority::kTerminal)) return finish(kStale, 0);
+  if (!std::isfinite(deadline_uptime) || deadline_uptime <= double(Now()) * 1e-9) return finish(Error(kDeadline), 0);
+  if (!initialized_.load(std::memory_order_acquire) && Init() != 0) return finish(kAdmission, 0);
+  Control control(*this);
+  if (!control) return finish(-23, 0);
+  if (!std::isfinite(deadline_uptime) || deadline_uptime <= 0) return finish(kAdmission, 0);
+  const uint64_t previous_serial = prepare_serial_.load(std::memory_order_acquire);
+  if (previous_serial == UINT64_MAX) return finish(Error(kAdmission), 0);
+  serial = previous_serial + 1;
+  prepare_serial_.store(serial, std::memory_order_release);
+  uint64_t word = authority_.Read();
+  if (Authority::Intent(word) != expected_intent) return finish(kStale, 0);
+  if ((word & Authority::kTerminal) || IsRetired() || owner_.ExperimentalCoreAudioError()) return finish(kAdmission, 0);
+  const uint64_t deadline = uint64_t(std::min(deadline_uptime, double(Now()) * 1e-9 + 8.0) * 1e9);
+  if (deadline <= Now()) return finish(Error(kDeadline), 0);
+  if (!(word & Authority::kAuthorized) || !recording_demand_.load(std::memory_order_acquire)) {
+    if (owner_.experimental_input_io_.created) return finish(Error(kAdmission), 0);
+    Route route;
+    if (!ReadRoute(&route) || route.input_uid != selected_.input_uid || route.output_uid != selected_.output_uid) return finish(Error(kAdmission), 0);
+    const bool success = OutputRequested() ? StartOutput(route) : StopOutput(deadline);
+    return finish(success ? 0 : kAdmission, 0);
+  }
+  if (!Authority::AllowsPreparation(word)) return finish(kStale, 0);
+  if (!first_deadline_) first_deadline_ = deadline;
+  const uint64_t bounded_deadline = prepared_.load(std::memory_order_acquire) ? deadline : std::min(deadline, first_deadline_);
+  if (!prepared_.load(std::memory_order_acquire)) {
+    Route route;
+    if (!sealed_candidate_) {
+    EnterPhase(Phase::kQuiesceOutput);
+    if (!StopOutput(bounded_deadline)) return finish(kAdmission, 0);
+    if (!Current(expected_intent, bounded_deadline)) return finish(kStale, 0);
+    negotiating_.store(true, std::memory_order_release);
+    EnterPhase(Phase::kStartInput);
+    if (!Current(expected_intent, bounded_deadline) || !StartRawInput(expected_intent, bounded_deadline)) return finish(kStale, 0);
+    if (!Current(expected_intent, bounded_deadline)) return finish(kStale, 0);
+    EnterPhase(Phase::kNegotiate);
+    if (!TestHold(static_cast<uint32_t>(Phase::kNegotiate), expected_intent, bounded_deadline))
+      return finish(Authority::Intent(authority_.Read()) != expected_intent ? kStale : Error(kDeadline), 0);
+    uint64_t validated_word = 0;
+    if (!StableRoute(&route, &validated_word, expected_intent, bounded_deadline))
+      return finish(Authority::Intent(authority_.Read()) != expected_intent ? kStale : Error(kDeadline), 0);
+    EnterPhase(Phase::kSeal);
+    if (!authority_.Seal(validated_word, &word)) return finish(kStale, 0);
+    negotiating_.store(false, std::memory_order_release);
+    sealed_route_ = route;
+    sealed_candidate_ = true;
+    physical_generation_.store(1, std::memory_order_release);
+    } else {
+      route = sealed_route_;
+      word = authority_.Read();
+    }
+    if (!Current(expected_intent, bounded_deadline)) return finish(kStale, 0);
+    EnterPhase(Phase::kBuildCapture);
+    const uint64_t cutoff = AudioConvertHostTimeToNanos(AudioGetCurrentHostTime());
+    if (!BuildCapture(route, cutoff)) return finish(kAdmission, 0);
+    if (!Current(expected_intent, bounded_deadline)) return finish(kStale, 0);
+    EnterPhase(Phase::kBuildOutput);
+    if (OutputRequested() && !StartOutput(route)) return finish(kAdmission, 0);
+    if (OutputRequested() && !OutputAllowed()) return finish(kStale, 0);
+    EnterPhase(Phase::kVerify);
+    const uint64_t count = callbacks_.load(std::memory_order_acquire);
+    while (Current(expected_intent, bounded_deadline) &&
+        (callbacks_.load(std::memory_order_acquire) <= count || capture_->converted.load(std::memory_order_acquire) == 0 ||
+         (OutputAllowed() && output_callbacks_.load(std::memory_order_acquire) <= output_start_callbacks_.load(std::memory_order_acquire)))) Poll();
+    Route after;
+    if (!Current(expected_intent, bounded_deadline) || !ReadRoute(&after) || !SameRoute(route, after) || authority_.Read() != word)
+      return finish(Authority::Intent(authority_.Read()) != expected_intent ? kStale : Error(kAdmission), 0);
+    prepared_.store(true, std::memory_order_release);
+  } else {
+    Route route;
+    const uint64_t before = authority_.Read();
+    if (!ReadRoute(&route) || !SameRoute(route, sealed_route_) ||
+        !capture_ || !SameFormat(route.input_format, capture_->source)) return finish(Error(kAdmission), 0);
+    const uint64_t output_serial = owner_.experimental_output_io_.serial;
+    const bool success = OutputRequested() ? StartOutput(route) : StopOutput(bounded_deadline);
+    if (!success || authority_.Read() != before) return finish(kStale, 0);
+    if (OutputRequested() && !OutputAllowed()) return finish(kStale, 0);
+    if (OutputRequested() && owner_.experimental_output_io_.serial != output_serial) {
+      const uint64_t input_count = callbacks_.load(std::memory_order_acquire);
+      while (Current(expected_intent, bounded_deadline) &&
+          (output_callbacks_.load(std::memory_order_acquire) <= output_start_callbacks_.load(std::memory_order_acquire) ||
+           callbacks_.load(std::memory_order_acquire) <= input_count)) Poll();
+      Route after;
+      if (!Current(expected_intent, bounded_deadline)) return finish(kStale, 0);
+      if (!ReadRoute(&after) || !SameRoute(route, after) || authority_.Read() != before) return finish(Error(kAdmission), 0);
+    }
+  }
+  EnterPhase(Phase::kReady);
+  if (!TestHold(static_cast<uint32_t>(Phase::kReady), expected_intent, bounded_deadline))
+    return finish(Authority::Intent(authority_.Read()) != expected_intent ? kStale : Error(kDeadline), 0);
+  word = authority_.Read();
+  return finish(Current(expected_intent, bounded_deadline) ? 0 : kStale, word);
+}
+int32_t AudioDeviceMacDuplex::Retire() {
+  Control control(*this);
+  if (!control) return -1;
+  if (owner_.experimental_retirement_confirmed_.load(std::memory_order_acquire)) return 0;
+  owner_.experimental_retirement_requested_.store(true, std::memory_order_release);
+  authority_.FailTerminal();
+  if (owner_._ptrAudioBuffer) owner_._ptrAudioBuffer->SetExperimentalCoreAudioCaptureMuted(true);
+  EnterPhase(Phase::kRetire);
+  const uint64_t deadline = Now() + 2000000000;
+  const bool output = StopOutput(deadline), input = StopInput(deadline), listeners = RemoveListeners(deadline);
+  if (!input || !output || !listeners || owner_.experimental_unsafe_errors_.mask()) return -1;
+  if (owner_._mixerManager.Close() != 0) return Error(-10, true);
+  if (owner_.experimental_capture_semaphore_owned_) {
+    const auto status = semaphore_destroy(mach_task_self(), owner_._captureSemaphore);
+    if (status != KERN_SUCCESS) return Error(status, true);
+    owner_.experimental_capture_semaphore_owned_ = false;
+  }
+  if (owner_.experimental_render_semaphore_owned_) {
+    const auto status = semaphore_destroy(mach_task_self(), owner_._renderSemaphore);
+    if (status != KERN_SUCCESS) return Error(status, true);
+    owner_.experimental_render_semaphore_owned_ = false;
+  }
+  if (owner_._ptrAudioBuffer) owner_._ptrAudioBuffer->AttachExperimentalCoreAudioDuplexAuthority(nullptr);
+  owner_._initialized = false; owner_._isShutDown = true;
+  owner_.duplex_module_initialized_.store(false, std::memory_order_release);
+  initialized_.store(false, std::memory_order_release);
+  owner_.experimental_retirement_confirmed_.store(true, std::memory_order_release);
+  EnterPhase(Phase::kStopped);
+  return 0;
+}
+AudioDeviceModule::ExperimentalCoreAudioDuplexState AudioDeviceMacDuplex::State() const {
+  AudioDeviceModule::ExperimentalCoreAudioDuplexState state;
+  state.supported = true; state.authority = authority_.Read(); state.prepared = prepared_.load(std::memory_order_acquire);
+  state.owner_generation = owner_generation_;
+  state.physical_generation = physical_generation_.load(std::memory_order_acquire);
+  state.active_prepare_serial = prepare_serial_.load(std::memory_order_acquire);
+  state.input_create_count = input_create_count_.load(std::memory_order_acquire);
+  state.input_start_count = input_start_count_.load(std::memory_order_acquire);
+  state.output_create_count = output_create_count_.load(std::memory_order_acquire);
+  state.output_start_count = output_start_count_.load(std::memory_order_acquire);
+  state.hold_active = hold_active_.load(std::memory_order_acquire);
+  state.output_running = owner_._playing.load(std::memory_order_acquire);
+  state.input_running = owner_._recording.load(std::memory_order_acquire);
+  state.capture_committed = (state.authority & Authority::kCommitted) != 0;
+  state.phase = timeline_.phase.load(std::memory_order_acquire);
+  for (size_t i = 0; i < ExperimentalCoreAudioDuplexTimeline::kPhases; ++i) state.phase_nanos[i] = timeline_.times[i].load(std::memory_order_acquire);
+  state.input_callbacks = callbacks_.load(std::memory_order_acquire); state.output_callbacks = output_callbacks_.load(std::memory_order_acquire);
+  state.first_input_nanos = first_input_.load(std::memory_order_acquire); state.last_input_nanos = last_input_.load(std::memory_order_acquire);
+  state.archived_output_generations = output_history_count_.load(std::memory_order_acquire);
+  state.output_history_size = std::min<size_t>(state.archived_output_generations, output_history_.size());
+  for (size_t i = 0; i < state.output_history_size; ++i) {
+    const auto& from = output_history_[i]; auto& to = state.output_history[i];
+    to.serial = from.serial; to.proof = from.proof; to.required = from.required;
+    to.stop_status = from.stop; to.destroy_status = from.destroy;
+    to.sample_rate = from.format.mSampleRate; to.format_id = from.format.mFormatID; to.flags = from.format.mFormatFlags;
+    to.bytes_per_packet = from.format.mBytesPerPacket; to.frames_per_packet = from.format.mFramesPerPacket;
+    to.bytes_per_frame = from.format.mBytesPerFrame; to.channels = from.format.mChannelsPerFrame;
+    to.bits_per_channel = from.format.mBitsPerChannel; to.reserved = from.format.mReserved;
+  }
+  state.observed_events = event_count_.load(std::memory_order_acquire);
+  state.event_size = std::min<size_t>(state.observed_events, events_.size());
+  for (size_t i = 0; i < state.event_size; ++i) {
+    const auto& from = events_[i]; auto& to = state.events[i];
+    if (!from.ready.load(std::memory_order_acquire)) continue;
+    to.ready = true; to.authority = from.word; to.nanos = from.nanos;
+    to.object = from.object; to.selector = from.selector; to.scope = from.scope;
+  }
+  state.input_drops = input_drops_.load(std::memory_order_acquire);
+  return state;
+}
