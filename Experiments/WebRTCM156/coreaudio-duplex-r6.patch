+struct AudioDeviceMacDuplex::CaptureGeneration {
+  CaptureGeneration(AudioDeviceMacDuplex& controller, const AudioStreamBasicDescription& format, uint64_t cutoff, uint32_t latency)
+      : control(controller), source(format), cutoff_host(cutoff), device_latency_us(latency), ring(kCaptureSamples), scratch(kCaptureSamples) {}
+  AudioDeviceMacDuplex& control;
+  const AudioStreamBasicDescription source;
+  const uint64_t cutoff_host;
+  const uint32_t device_latency_us;
+  std::atomic<uint32_t> callback_delay_us{0};
+  AudioConverterRef converter = nullptr;
+  ExperimentalCoreAudioCallbackCell* cell = nullptr;
+  ExperimentalCoreAudioCapture ring;
+  ExperimentalCoreAudioCaptureEpoch epoch;
+  std::vector<float> scratch;
+  PlatformThread worker;
+  std::atomic<bool> running{false}, exited{true};
+  std::atomic<uint64_t> converted{0};
+  static OSStatus Supply(AudioConverterRef, UInt32* packets, AudioBufferList* data,
+      AudioStreamPacketDescription**, void* context) {
+    auto& self = *static_cast<CaptureGeneration*>(context);
+    const uint64_t samples = uint64_t{*packets} * self.source.mChannelsPerFrame;
+    if (!samples || samples > self.scratch.size()) { *packets = 0; return 1; }
+    while (self.running.load(std::memory_order_acquire) && self.ring.AvailableToRead() < samples) {
+      mach_timespec_t timeout{0, 10000000};
+      const auto status = semaphore_timedwait(self.control.owner_._captureSemaphore, timeout);
+      if (status != KERN_SUCCESS && status != KERN_OPERATION_TIMED_OUT) {
+        self.control.Error(status, true); *packets = 0; return 1;
+      }
+    }
+    if (!self.running.load(std::memory_order_acquire)) { *packets = 0; return 1; }
