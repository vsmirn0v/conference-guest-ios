+template <typename T> bool Property(AudioObjectID object, AudioObjectPropertySelector selector,
+    AudioObjectPropertyScope scope, T* value) {
+  AudioObjectPropertyAddress address{selector, scope, kAudioObjectPropertyElementMain};
+  UInt32 bytes = sizeof(T);
+  return AudioObjectGetPropertyData(object, &address, 0, nullptr, &bytes, value) == noErr && bytes == sizeof(T);
+}
+bool UID(AudioDeviceID device, std::string* result) {
+  CFStringRef uid = nullptr;
+  if (!Property(device, kAudioDevicePropertyDeviceUID, kAudioObjectPropertyScopeGlobal, &uid) || !uid) return false;
+  char bytes[1024];
+  const bool success = CFStringGetCString(uid, bytes, sizeof(bytes), kCFStringEncodingUTF8);
+  CFRelease(uid);
+  if (success) *result = bytes;
+  return success;
