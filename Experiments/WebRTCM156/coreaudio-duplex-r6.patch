+class Gate {
+ public:
+  void Open() { std::lock_guard<std::mutex> lock(mutex_); open_ = true; cv_.notify_all(); }
+  bool Wait(std::chrono::milliseconds timeout = 5000ms) {
+    std::unique_lock<std::mutex> lock(mutex_);
+    return cv_.wait_for(lock, timeout, [&] { return open_; });
+  }
+ private:
+  std::mutex mutex_;
+  std::condition_variable cv_;
+  bool open_ = false;
+};
+struct OwnerStats {
+  std::atomic<bool> destroyed{false};
+  std::thread::id released_on;
+};
+class TransportOwner : public RefCountInterface {
+ public:
+  explicit TransportOwner(std::shared_ptr<OwnerStats> stats) : stats_(std::move(stats)) {}
+  ~TransportOwner() override {
+    stats_->released_on = std::this_thread::get_id();
+    stats_->destroyed.store(true, std::memory_order_release);
+  }
+  NiceMock<test::MockAudioTransport> transport;
+ private:
+  std::shared_ptr<OwnerStats> stats_;
+};
+struct Fixture {
+  ExperimentalCoreAudioDuplexAuthority authority;
+  AudioDeviceBuffer buffer{CreateTestEnvironment()};
+  std::shared_ptr<OwnerStats> stats = std::make_shared<OwnerStats>();
+  scoped_refptr<TransportOwner> owner = make_ref_counted<TransportOwner>(stats);
+  Fixture() {
+    buffer.AttachExperimentalCoreAudioDuplexAuthority(&authority);
+    EXPECT_EQ(buffer.RegisterExperimentalCoreAudioDuplexTransport(&owner->transport, owner), 0);
+    EXPECT_EQ(buffer.SetPlayoutSampleRate(48000), 0);
+    EXPECT_EQ(buffer.SetRecordingSampleRate(48000), 0);
+    EXPECT_EQ(buffer.SetPlayoutChannels(1), 0);
+    EXPECT_EQ(buffer.SetRecordingChannels(1), 0);
+  }
+};
+
+void ExerciseCleanStop(bool input) {
+  Fixture fixture;
+  auto& buffer = fixture.buffer;
+  Gate entered, release;
+  std::atomic<bool> callback_finished{false};
+  std::array<int16_t, 480> samples{};
+  auto* transport = &fixture.owner->transport;
+  if (input) {
+    EXPECT_CALL(*transport, RecordedDataIsAvailable(_, _, _, _, _, _, _, _, _, _, _))
+        .WillOnce([&](const void*, size_t, size_t, size_t, uint32_t, uint32_t,
+                      int32_t, uint32_t, bool, uint32_t&, std::optional<int64_t>) {
+          entered.Open(); EXPECT_TRUE(release.Wait());
+          callback_finished.store(true, std::memory_order_release); return 0;
+        });
+    buffer.StartRecording();
+  } else {
+    EXPECT_CALL(*transport, NeedMorePlayData(_, _, _, _, _, _, _, _))
+        .WillOnce([&](size_t frames, size_t bytes, size_t, uint32_t, void* data,
+                      size_t& produced, int64_t*, int64_t*) {
+          entered.Open(); EXPECT_TRUE(release.Wait());
+          std::memset(data, 0, frames * bytes); produced = frames;
+          callback_finished.store(true, std::memory_order_release); return 0;
+        });
+    buffer.StartPlayout();
+  }
+  auto* cell = buffer.ExperimentalCoreAudioDuplexDeliveryCell(input);
+  ASSERT_NE(cell, nullptr);
+  fixture.owner = nullptr;  // Only the actual ADB registration owns transport.
+  std::thread callback([&] {
+    ExperimentalCoreAudioCallbackCell::Lease lease(cell);
+    EXPECT_EQ(lease.owner(), &buffer);
+    if (!lease.owner()) { entered.Open(); return; }
+    if (input) {
+      buffer.SetRecordedBuffer(samples.data(), samples.size());
+      buffer.DeliverRecordedData();
+    } else { buffer.RequestPlayoutData(480); }
+  });
+  const bool admitted = entered.Wait();
+  EXPECT_TRUE(admitted);
+  std::atomic<bool> stop_returned{false}, close_observed{false}, waited_for_callback{false};
+  std::thread releaser([&] {
+    const auto deadline = std::chrono::steady_clock::now() + 1000ms;
+    while (std::chrono::steady_clock::now() < deadline) {
+      ExperimentalCoreAudioCallbackCell::Lease probe(cell);
+      if (!probe.owner()) { close_observed.store(true); break; }
+      std::this_thread::sleep_for(1ms);
+    }
+    // An incorrectly early Stop leaves a sticky return flag before release.
+    std::this_thread::sleep_for(20ms);
+    waited_for_callback.store(!stop_returned.load());
+    EXPECT_TRUE(buffer.ExperimentalCoreAudioDuplexTransportPinned());
+    EXPECT_FALSE(fixture.stats->destroyed.load(std::memory_order_acquire));
+    release.Open();
+  });
+  if (input) buffer.StopRecording(); else buffer.StopPlayout();
+  stop_returned.store(true);
+  EXPECT_TRUE(callback_finished.load(std::memory_order_acquire));
+  callback.join(); releaser.join();
+  EXPECT_TRUE(close_observed.load());
+  EXPECT_TRUE(waited_for_callback.load());
+  EXPECT_TRUE(cell->ClosedAndDrained());
+  EXPECT_FALSE(cell->Open());  // Never reopen a published tombstone.
+  EXPECT_FALSE(buffer.ExperimentalCoreAudioDuplexDeliveryUnsafe());
+  EXPECT_EQ(buffer.RegisterAudioCallback(nullptr), 0);
+  EXPECT_FALSE(buffer.ExperimentalCoreAudioDuplexTransportPinned());
+  EXPECT_TRUE(fixture.stats->destroyed.load(std::memory_order_acquire));
+  EXPECT_EQ(fixture.stats->released_on, std::this_thread::get_id());
+}
+
+TEST(ExperimentalCoreAudioDuplexTransport, StopRecordingDrainsAdmittedRawTransport) {
+  ExerciseCleanStop(true);
+}
+TEST(ExperimentalCoreAudioDuplexTransport, StopPlayoutDrainsAdmittedRawTransport) {
+  ExerciseCleanStop(false);
+}
