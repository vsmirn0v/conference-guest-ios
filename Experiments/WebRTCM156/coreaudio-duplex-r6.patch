+  if (initialized_.load(std::memory_order_acquire)) return 0;
+  if (!ReadRoute(&selected_)) return Error(kAdmission);
+  owner_._inputDeviceID = selected_.input; owner_._outputDeviceID = selected_.output;
+  owner_.experimental_selected_input_id_.store(selected_.input, std::memory_order_release);
+  owner_.experimental_selected_output_id_.store(selected_.output, std::memory_order_release);
+  owner_._twoDevices = true; owner_._inputDeviceIsSpecified = owner_._outputDeviceIsSpecified = true;
+  auto status = semaphore_create(mach_task_self(), &owner_._renderSemaphore, SYNC_POLICY_FIFO, 0);
+  if (status != KERN_SUCCESS) return Error(status, true);
+  owner_.experimental_render_semaphore_owned_ = true;
+  status = semaphore_create(mach_task_self(), &owner_._captureSemaphore, SYNC_POLICY_FIFO, 0);
+  if (status != KERN_SUCCESS) return Error(status, true);
+  owner_.experimental_capture_semaphore_owned_ = true;
+  if (!InstallListeners()) return -1;
+  owner_._initialized = true; owner_._isShutDown = false;
+  initialized_.store(true, std::memory_order_release);
+  return 0;
+}
