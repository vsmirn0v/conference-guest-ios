+void AudioDeviceMacDuplex::OutputCallback(const AudioBufferList* data) {
+  const auto& buffer = data->mBuffers[0];
+  const auto samples = std::span<const float>(static_cast<const float*>(buffer.mData), buffer.mDataByteSize / sizeof(float));
+  double energy = 0;
+  for (float sample : samples) {
+    if (!std::isfinite(sample) || sample < -8 || sample > 8) { Error(kAdmission, true); return; }
+    energy += double(sample) * sample;
+  }
+  owner_._ptrAudioBuffer->RecordExperimentalCoreAudioPhysicalOutput(uint64_t(energy * 1073741824.0), samples.size(), true);
