+      auto* buffer = control.owner_._ptrAudioBuffer;
+      const uint64_t local = buffer->ExperimentalCoreAudioCaptureState(), process = ApplicationCaptureState();
+      const uint64_t authority = control.authority_.Read();
+      const OSStatus reset = epoch.Begin(local, process, [this] { return AudioConverterReset(converter); });
+      if (reset != noErr) { control.Error(reset, true); break; }
