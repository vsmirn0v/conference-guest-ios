+    const timespec pause{0, 1000000}; nanosleep(&pause, nullptr);
+  }
+  if (!cell->ClosedAndDrained()) {
+    experimental_duplex_delivery_unsafe_.store(true, std::memory_order_release);
+    if (auto* authority = experimental_duplex_authority_.load(std::memory_order_acquire)) authority->FailTerminal();
+  }
+  return !experimental_duplex_delivery_unsafe_.load(std::memory_order_acquire);
+}
