+// R6 only. One publication word linearizes app intent, format invalidation and
+// the final capture commit. No callback needs the control/Swift lock.
+class ExperimentalCoreAudioDuplexAuthority {
+ public:
+  enum Flag : uint64_t {
+    kAuthorized = 1, kMuted = 2, kSound = 4, kTerminal = 8,
+    kPrivate = 16, kSealed = 32, kCommitted = 64, kDemandClosed = 128
+  };
+  // The lower epoch invalidates on actual route events OR native capture
+  // demand transitions. Actual HAL notifications have a separate journal/count.
+  static constexpr unsigned kRouteShift = 8, kIntentShift = 36;
+  static constexpr uint64_t kEpochMax = (uint64_t{1} << 28) - 1;
+  static constexpr uint64_t kRouteMask = kEpochMax << kRouteShift;
+  static constexpr uint64_t kIntentMask = kEpochMax << kIntentShift;
+  static constexpr uint64_t kPublicFlags = kAuthorized | kMuted | kSound | kTerminal | kPrivate;
+  static_assert((kRouteMask & kIntentMask) == 0);
+  static_assert((kPublicFlags & (kRouteMask | kIntentMask)) == 0);
+  static_assert(std::atomic<uint64_t>::is_always_lock_free);
+
+  uint64_t Read() const { return word_.load(std::memory_order_acquire); }
+  static uint64_t Intent(uint64_t word) { return word >> kIntentShift; }
+  static uint64_t Route(uint64_t word) { return (word & kRouteMask) >> kRouteShift; }
+  static bool AllowsPublication(uint64_t word) {
+    return (word & (kAuthorized | kSealed | kCommitted)) ==
+               (kAuthorized | kSealed | kCommitted) &&
+           !(word & (kMuted | kTerminal | kPrivate | kDemandClosed));
+  }
+  static bool AllowsPreparation(uint64_t word) {
+    return (word & kAuthorized) && !(word & (kTerminal | kPrivate | kDemandClosed));
+  }
+  // App sequence is allocated under the same lock as its intent flags. Older
+  // latches cannot overwrite new mute/Leave/private authority after queue delay.
+  bool Latch(uint32_t sequence, uint32_t flags, uint64_t* result) {
+    if (!sequence || sequence > kEpochMax || (flags & ~kPublicFlags)) {
+      FailTerminal(); return false;
+    }
+    uint64_t old = Read();
+    do {
+      if (sequence <= Intent(old) || (old & kTerminal)) return false;
+      const uint64_t next = (uint64_t{sequence} << kIntentShift) |
+          (old & (kRouteMask | kSealed | kDemandClosed)) | flags;
+      if (word_.compare_exchange_weak(old, next, std::memory_order_acq_rel)) {
+        if (result) *result = next;
+        return true;
+      }
+    } while (true);
+  }
+  // Before seal, notifications are a bounded negotiation journal. After seal,
+  // even a same-format notification invalidates this generation permanently.
+  uint64_t RouteEvent() {
+    uint64_t old = Read();
+    do {
+      const uint64_t route = Route(old);
+      uint64_t next = old & ~uint64_t{kCommitted};
+      if (route == kEpochMax || (old & kSealed)) next |= kTerminal | kMuted;
+      if (route != kEpochMax) next = (next & ~kRouteMask) | ((route + 1) << kRouteShift);
+      if (word_.compare_exchange_weak(old, next, std::memory_order_acq_rel)) return next;
+    } while (true);
+  }
+  bool Seal(uint64_t expected, uint64_t* sealed) {
+    if (!AllowsPreparation(expected) || (expected & kSealed)) return false;
+    const uint64_t next = expected | kSealed;
+    if (!word_.compare_exchange_strong(expected, next, std::memory_order_acq_rel)) return false;
+    if (sealed) *sealed = next;
+    return true;
+  }
+  bool Commit(uint64_t expected, uint64_t* committed) {
+    if (!(expected & kSealed) || !AllowsPreparation(expected) || (expected & kMuted)) return false;
+    const uint64_t next = expected | kCommitted;
+    if (!word_.compare_exchange_strong(expected, next, std::memory_order_acq_rel)) return false;
+    if (committed) *committed = next;
+    return true;
+  }
+  // Deadline expiry is terminal for this one attempt, including a late native
+  // completion. A newer user intent cannot reopen the invalidated owner.
+  bool Revoke(uint64_t expected_intent) {
+    uint64_t old = Read();
+    do {
+      if (Intent(old) != expected_intent) return false;
+      const uint64_t next = (old | kTerminal | kMuted) & ~uint64_t{kCommitted};
+      if (word_.compare_exchange_weak(old, next, std::memory_order_acq_rel)) return true;
+    } while (true);
+  }
+  void FailTerminal() {
+    uint64_t old = Read();
+    while (!word_.compare_exchange_weak(old,
+        (old | kTerminal | kMuted) & ~uint64_t{kCommitted}, std::memory_order_acq_rel)) {}
+  }
+  void SetCaptureDemand(bool run) {
+    uint64_t old = Read();
+    do {
+      if (bool(old & kDemandClosed) == !run) return;
+      const uint64_t epoch = Route(old);
+      uint64_t next = run ? (old & ~uint64_t{kDemandClosed}) :
+          ((old | kDemandClosed) & ~uint64_t{kCommitted});
+      if (epoch == kEpochMax) next = (next | kTerminal | kMuted) & ~uint64_t{kCommitted};
+      else next = (next & ~kRouteMask) | ((epoch + 1) << kRouteShift);
+      if (word_.compare_exchange_weak(old, next, std::memory_order_acq_rel)) return;
+    } while (true);
+  }
+
+ private:
+  std::atomic<uint64_t> word_{kMuted | kDemandClosed};
+};
+
+// Output has its own authority domain. An input mute/demand epoch must not
+// interrupt a valid render generation. Sound/output-demand ABA still revokes
+// a native Start already in progress; only that exact output token can open.
+class ExperimentalCoreAudioOutputAuthority {
+ public:
+  static constexpr uint64_t kActive = 1, kTerminal = uint64_t{1} << 63;
+  static constexpr uint64_t kEpochMask = kTerminal - 2;
+  uint64_t Read() const { return word_.load(std::memory_order_acquire); }
+  bool Allows() const { const uint64_t word = Read(); return (word & kActive) && !(word & kTerminal); }
+  bool Revoke() {
+    uint64_t old = Read();
+    do {
+      if (old & kTerminal) return false;
+      const uint64_t epoch = old & kEpochMask;
+      const uint64_t next = epoch == kEpochMask ? kTerminal : epoch + 2;
+      if (word_.compare_exchange_weak(old, next, std::memory_order_acq_rel)) return !(next & kTerminal);
+    } while (true);
+  }
+  bool Authorize(uint64_t expected) {
+    if (expected & (kTerminal | kActive)) return false;
+    return word_.compare_exchange_strong(expected, expected | kActive, std::memory_order_acq_rel);
+  }
+ private:
+  std::atomic<uint64_t> word_{0};
+};
+
+enum class ExperimentalCoreAudioDuplexPhase : uint32_t {
+  kIdle, kQuiesceOutput, kStartInput, kNegotiate, kSeal, kBuildCapture,
+  kBuildOutput, kVerify, kReady, kCommitted, kRetire, kStopped, kFailed, kCount
+};
+
+// Each phase has a first raw monotonic timestamp. Reads are passive atomics.
+// Callback metadata is bounded and published once per journal entry.
+struct ExperimentalCoreAudioDuplexTimeline {
+  static constexpr size_t kPhases = static_cast<size_t>(ExperimentalCoreAudioDuplexPhase::kCount);
+  void Enter(ExperimentalCoreAudioDuplexPhase next, uint64_t now) {
+    uint64_t unset = 0;
+    times[static_cast<size_t>(next)].compare_exchange_strong(unset, now, std::memory_order_release);
+    phase.store(static_cast<uint32_t>(next), std::memory_order_release);
+  }
+  std::atomic<uint32_t> phase{0};
+  std::array<std::atomic<uint64_t>, kPhases> times{};
+};
+
+// No payload parsing is necessary to advance negotiation. Byte/channel layout
+// validation belongs to an immutable generation after the full ASBD is sealed.
+inline bool ExperimentalCoreAudioDuplexBufferShape(uint32_t buffers,
+    uint32_t channels, uint32_t bytes, uint32_t expected_channels,
+    uint32_t bytes_per_frame, uint32_t capacity_frames) {
+  return buffers == 1 && channels == expected_channels && channels > 0 &&
+      bytes_per_frame > 0 && bytes > 0 && bytes % bytes_per_frame == 0 &&
+      bytes / bytes_per_frame <= capacity_frames;
+}
+
+inline uint16_t ExperimentalCoreAudioDuplexDelayMs(int32_t queue_us, uint32_t device_us) {
+  const uint64_t delay = uint64_t(queue_us > 0 ? queue_us : 0) + device_us;
+  const uint64_t milliseconds = (delay + 500) / 1000;
+  return milliseconds > std::numeric_limits<uint16_t>::max() ?
+      std::numeric_limits<uint16_t>::max() : static_cast<uint16_t>(milliseconds);
+}
