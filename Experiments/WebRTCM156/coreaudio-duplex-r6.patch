+TEST(ExperimentalCoreAudioDuplexTransport, UnregisterSharesDeadlineAndQuarantinesOwner) {
+  // An unsafe ADB cannot be destroyed; production retains the complete ADM/ADB
+  // anchor. This fixture intentionally keeps that whole dependency graph alive.
+  auto fixture = std::make_unique<Fixture>();
+  auto& buffer = fixture->buffer;
+  auto stats = fixture->stats;
+  auto* transport = &fixture->owner->transport;
+  ::testing::Mock::AllowLeak(transport);
+  buffer.StartRecording(); buffer.StartPlayout();
+  auto* capture = buffer.ExperimentalCoreAudioDuplexDeliveryCell(true);
+  auto* render = buffer.ExperimentalCoreAudioDuplexDeliveryCell(false);
+  ASSERT_NE(capture, nullptr); ASSERT_NE(render, nullptr);
+  Gate capture_entered, render_entered, release;
+  std::atomic<bool> capture_admitted{false}, render_admitted{false};
+  auto held = [&](ExperimentalCoreAudioCallbackCell* cell, Gate& entered, std::atomic<bool>& admitted) {
+    ExperimentalCoreAudioCallbackCell::Lease lease(cell);
+    admitted.store(lease.owner() == &buffer); entered.Open();
+    EXPECT_TRUE(release.Wait());
+  };
+  fixture->owner = nullptr;
+  std::thread input([&] { held(capture, capture_entered, capture_admitted); });
+  std::thread output([&] { held(render, render_entered, render_admitted); });
+  EXPECT_TRUE(capture_entered.Wait()); EXPECT_TRUE(render_entered.Wait());
+  EXPECT_TRUE(capture_admitted.load()); EXPECT_TRUE(render_admitted.load());
+  const double began = AudioDeviceBuffer::ExperimentalCoreAudioUptime();
+  const int result = buffer.RegisterAudioCallback(nullptr);
+  const double elapsed = AudioDeviceBuffer::ExperimentalCoreAudioUptime() - began;
+  EXPECT_EQ(result, -1);
+  EXPECT_GE(elapsed, 1.9); EXPECT_LT(elapsed, 3.0);  // One budget, not 2s per direction.
+  EXPECT_TRUE(buffer.ExperimentalCoreAudioDuplexDeliveryUnsafe());
+  EXPECT_TRUE(buffer.ExperimentalCoreAudioDuplexTransportPinned());
+  EXPECT_FALSE(stats->destroyed.load(std::memory_order_acquire));
+  EXPECT_NE(fixture->authority.Read() & ExperimentalCoreAudioDuplexAuthority::kTerminal, 0u);
+  release.Open(); input.join(); output.join();
+  EXPECT_TRUE(capture->ClosedAndDrained()); EXPECT_TRUE(render->ClosedAndDrained());
+  EXPECT_FALSE(capture->Open()); EXPECT_FALSE(render->Open());
+  const double repeated = AudioDeviceBuffer::ExperimentalCoreAudioUptime();
+  EXPECT_EQ(buffer.RegisterAudioCallback(nullptr), -1);
+  EXPECT_FALSE(buffer.CloseExperimentalCoreAudioDuplexDelivery(true));
+  EXPECT_FALSE(buffer.CloseExperimentalCoreAudioDuplexDelivery(false));
+  EXPECT_LT(AudioDeviceBuffer::ExperimentalCoreAudioUptime() - repeated, 0.2);
+  auto other_stats = std::make_shared<OwnerStats>();
+  auto other = make_ref_counted<TransportOwner>(other_stats);
+  EXPECT_EQ(buffer.RegisterExperimentalCoreAudioDuplexTransport(&other->transport, other), -1);
+  other = nullptr;
+  EXPECT_TRUE(other_stats->destroyed.load(std::memory_order_acquire));
+  EXPECT_TRUE(buffer.ExperimentalCoreAudioDuplexTransportPinned());
+  EXPECT_FALSE(stats->destroyed.load(std::memory_order_acquire));
+  (void)fixture.release();
+}
