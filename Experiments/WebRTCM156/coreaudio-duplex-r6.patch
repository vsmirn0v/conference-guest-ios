+  auto* old = targets.Allocate(generation.get());
+  ASSERT_TRUE(old->Open());
+  std::atomic<ExperimentalCoreAudioCallbackCell*> target{old};
+  auto* delayed_load = target.load(std::memory_order_acquire);
+  old->Close();
+  target.store(nullptr, std::memory_order_release);
+  ASSERT_TRUE(old->ClosedAndDrained());
+  generation.reset();
+  ExperimentalCoreAudioCallbackCell::Lease late(delayed_load);
+  EXPECT_EQ(late.owner(), nullptr);
+  auto replacement = std::make_unique<int>(42);
+  auto* fresh = targets.Allocate(replacement.get());
+  ASSERT_TRUE(fresh->Open());
+  target.store(fresh, std::memory_order_release);
+  EXPECT_FALSE(old->Open());
+  ExperimentalCoreAudioCallbackCell::Lease admitted(target.load(std::memory_order_acquire));
+  ASSERT_NE(admitted.owner(), nullptr);
+  EXPECT_EQ(*static_cast<int*>(admitted.owner()), 42);
+  fresh->Close();
+}
