+int32_t AudioDeviceMacDuplex::Error(int32_t result, bool unsafe) {
+  if (!result) result = kAdmission;
+  authority_.FailTerminal();
+  if (owner_._ptrAudioBuffer) owner_._ptrAudioBuffer->SetExperimentalCoreAudioCaptureMuted(true);
+  if (unsafe) owner_.RecordExperimentalCoreAudioError(result, AudioDeviceMac::ErrorOrigin::kResourceProof, __LINE__);
+  else owner_.experimental_core_audio_error_.Record(result, [this, result] {
+    AudioDeviceModule::ExperimentalCoreAudioErrorContext context;
+    context.origin = result == kDeadline ? AudioDeviceMac::ErrorOrigin::kDuplexDeadline : AudioDeviceMac::ErrorOrigin::kDuplexAdmission;
+    context.uptime = AudioDeviceBuffer::ExperimentalCoreAudioUptime();
+    context.route_generation = Authority::Route(authority_.Read());
+    context.capture_generation = owner_._ptrAudioBuffer ? owner_._ptrAudioBuffer->ExperimentalCoreAudioCaptureState() : 0;
+    context.process_capture_generation = ApplicationCaptureState();
+    return context;
+  });
+  EnterPhase(Phase::kFailed);
+  return result;
+}
+uint64_t AudioDeviceMacDuplex::Latch(uint32_t flags, uint32_t sequence) {
+  bool available = false;
+  if (!intent_latching_.compare_exchange_strong(available, true, std::memory_order_acq_rel)) {
+    authority_.FailTerminal(); output_authority_.Revoke(); return 0;
+  }
+  struct Release { std::atomic<bool>& flag; ~Release() { flag.store(false, std::memory_order_release); } } release{intent_latching_};
+  const uint64_t previous = authority_.Read();
+  uint64_t token = 0;
+  if (!authority_.Latch(sequence, flags, &token)) return 0;
+  if (bool(previous & Authority::kSound) != bool(flags & Authority::kSound) || (flags & Authority::kTerminal))
+    if (!output_authority_.Revoke()) authority_.FailTerminal();
+  if (owner_._ptrAudioBuffer) owner_._ptrAudioBuffer->SetExperimentalCoreAudioCaptureMuted(true);
+  return token;
+}
+bool AudioDeviceMacDuplex::Revoke(uint64_t intent) {
+  const bool result = authority_.Revoke(intent);
+  if (result && owner_._ptrAudioBuffer) owner_._ptrAudioBuffer->SetExperimentalCoreAudioCaptureMuted(true);
+  return result;
