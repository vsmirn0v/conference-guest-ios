+bool AudioDeviceBuffer::CloseExperimentalCoreAudioDuplexDelivery(bool input, double requested_deadline) {
+  auto* cell = ExperimentalCoreAudioDuplexDeliveryCell(input);
+  if (!cell) return !experimental_duplex_delivery_unsafe_.load(std::memory_order_acquire);
+  cell->Close();
+  if (experimental_duplex_delivery_unsafe_.load(std::memory_order_acquire)) return false;
