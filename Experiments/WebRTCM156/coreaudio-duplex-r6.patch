+  if (!input && previous != run && !output_authority_.Revoke()) authority_.FailTerminal();
+  if (input && !run && owner_._ptrAudioBuffer) owner_._ptrAudioBuffer->SetExperimentalCoreAudioCaptureMuted(true);
