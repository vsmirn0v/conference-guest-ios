+  fixture.DisablePlayout();
+  std::this_thread::sleep_for(50ms);
+  EXPECT_EQ(fixture.SettledCalls(), 0);
+}
+
+TEST(AudioStateDuplexTest, ExistingNullPollerStopsAfterSidebandQuarantine) {
+  PollerFixture fixture;
+  fixture.DisablePlayout();
+  EXPECT_TRUE(fixture.mixed.Wait(TimeDelta::Seconds(2)));
+  EXPECT_GT(fixture.calls.load(), 0);
+  // No additional SetPlayout/Update call: the existing tick must guard itself.
+  fixture.device->quarantined.store(true);
+  const int after_admitted_tick = fixture.SettledCalls();
+  std::this_thread::sleep_for(50ms);
+  EXPECT_EQ(fixture.SettledCalls(), after_admitted_tick);
+}
+
+TEST(AudioStateDuplexTest, HeldOldRenderCannotRaceNewNullPoller) {
+  PollerFixture fixture;
+  fixture.block_next.store(true);
+  std::thread old_render([&] {
+    std::array<int16_t, 480> output{};
+    size_t produced = 0;
+    int64_t elapsed = 0, ntp = 0;
+    fixture.raw_transport->NeedMorePlayData(480, sizeof(int16_t), 1, 48000,
+        output.data(), produced, &elapsed, &ntp);
+  });
+  EXPECT_TRUE(fixture.raw_entered.Wait(TimeDelta::Seconds(2)));
+  fixture.device->quarantined.store(true);
+  fixture.DisablePlayout();  // Stop failed with an admitted old render access.
+  std::this_thread::sleep_for(50ms);
+  EXPECT_EQ(fixture.SettledCalls(), 1);
+  // Even when a regression started the poller, stop it on its worker before
+  // releasing the old render. Failure detection must not create a cleanup race
+  // on AudioTransportImpl's shared frame/resampler state.
+  fixture.StopDirectPoller();
+  fixture.raw_release.Set();
+  old_render.join();
+  EXPECT_EQ(fixture.SettledCalls(), 1);
+}
+
+TEST(AudioStateDuplexTest, LegacyDeviceRetainsOriginalNullPollerBehavior) {
+  PollerFixture fixture(false);
+  fixture.device->quarantined.store(true);  // Ignored when capability is absent.
+  fixture.DisablePlayout();
+  EXPECT_TRUE(fixture.mixed.Wait(TimeDelta::Seconds(2)));
+  EXPECT_GT(fixture.SettledCalls(), 0);
+}
