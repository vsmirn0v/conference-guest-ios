+    private let lock = NSLock()
+    private var membership: GuestAudioDemandPermit?
+    private let deliver: @Sendable (GuestAudioDemandPermit) -> Void
+    init(deliver: @escaping @Sendable (GuestAudioDemandPermit) -> Void) { self.deliver = deliver }
