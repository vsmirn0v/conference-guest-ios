+// A peer/receiver membership can revoke queued control work synchronously.
+// This lock is never used by an audio callback or the native worker.
+final class GuestAudioDemandPermit: @unchecked Sendable {
+    private let lock = NSLock()
+    private var active = true
+    var isActive: Bool { lock.lock(); defer { lock.unlock() }; return active }
+    func revoke() { lock.lock(); active = false; lock.unlock() }
+}
