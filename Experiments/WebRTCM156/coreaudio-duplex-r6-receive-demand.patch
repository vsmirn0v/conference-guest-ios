+// All methods are confined to the engine's MainActor. An event during an await
+// keeps exactly one pending pass; an empty next() ends the task without a gap
+// in which an event could be lost. A cancelled instance is never reused.
+@MainActor final class GuestAudioDemandReconciliation {
+    let permit = GuestAudioDemandPermit()
+    private var running = false
+    private var pending = false
+    func request() -> Bool {
+        guard permit.isActive else { return false }
+        pending = true
+        guard !running else { return false }
+        running = true
+        return true
+    }
+    func next() -> Bool {
+        guard permit.isActive, pending else { running = false; return false }
+        pending = false
+        return true
+    }
+    func cancel() { permit.revoke(); pending = false }
+}
