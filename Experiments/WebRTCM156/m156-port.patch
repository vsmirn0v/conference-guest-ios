+  key_handler->RatchetKey(0);
+  auto new_keyset = key_handler->GetKeySet(0);
+  EXPECT_NE(new_keyset, nullptr);
+  EXPECT_NE(new_keyset->material, keyset->material);
+  EXPECT_NE(new_keyset->encryption_key, keyset->encryption_key);
