+
+@interface RTCConfigurationCompatibilityTest : XCTestCase
+@end
+
+@implementation RTCConfigurationCompatibilityTest
+
+#if defined(RTC_ENABLE_H265)
+- (void)testHEVCFactoryAdvertisesWhatItCanCreate {
+  RTC_OBJC_TYPE(RTCDefaultVideoEncoderFactory) *encoder =
+      [[RTC_OBJC_TYPE(RTCDefaultVideoEncoderFactory) alloc] init];
+  RTC_OBJC_TYPE(RTCDefaultVideoDecoderFactory) *decoder =
+      [[RTC_OBJC_TYPE(RTCDefaultVideoDecoderFactory) alloc] init];
+  NSPredicate *hevc = [NSPredicate predicateWithFormat:@"name == %@", @"H265"];
+  NSArray *encoders = [[encoder supportedCodecs] filteredArrayUsingPredicate:hevc];
+  NSArray *decoders = [[decoder supportedCodecs] filteredArrayUsingPredicate:hevc];
+  XCTAssertEqual(encoders.count, 1u);
+  XCTAssertEqual(decoders.count, 1u);
+  if (encoders.count == 1 && decoders.count == 1) {
+    XCTAssertNotNil([encoder createEncoder:encoders.firstObject]);
+    XCTAssertNotNil([decoder createDecoder:decoders.firstObject]);
+  }
+}
+#endif
+
+- (void)testOptInDefaultsRemainDisabled {
+  RTC_OBJC_TYPE(RTCConfiguration) *config =
+      [[RTC_OBJC_TYPE(RTCConfiguration) alloc] init];
+  XCTAssertFalse(config.enableIceGatheringOnAnyAddressPorts);
+  XCTAssertFalse(config.enableSctpSnap);
+  std::unique_ptr<webrtc::PeerConnectionInterface::RTCConfiguration> native(
+      [config createNativeConfiguration]);
+  XCTAssertTrue(native != nullptr);
+  XCTAssertEqual(native->port_allocator_config.flags &
+                     webrtc::PORTALLOCATOR_ENABLE_ANY_ADDRESS_PORTS,
+                 0u);
+  XCTAssertFalse(native->enable_sctp_snap);
+}
+
+- (void)testAnyAddressFlagTogglePreservesUnrelatedNativeFlags {
+  webrtc::PeerConnectionInterface::RTCConfiguration native;
+  const uint32_t unrelated = webrtc::PORTALLOCATOR_DISABLE_TCP |
+                             webrtc::PORTALLOCATOR_ENABLE_IPV6;
+  native.set_port_allocator_flags(unrelated |
+                                 webrtc::PORTALLOCATOR_ENABLE_ANY_ADDRESS_PORTS);
+  RTC_OBJC_TYPE(RTCConfiguration) *config =
+      [[RTC_OBJC_TYPE(RTCConfiguration) alloc] initWithNativeConfiguration:native];
+  XCTAssertTrue(config.enableIceGatheringOnAnyAddressPorts);
+  config.enableIceGatheringOnAnyAddressPorts = NO;
+  std::unique_ptr<webrtc::PeerConnectionInterface::RTCConfiguration> disabled(
+      [config createNativeConfiguration]);
+  XCTAssertEqual(disabled->port_allocator_config.flags, unrelated);
+  config.enableIceGatheringOnAnyAddressPorts = YES;
+  std::unique_ptr<webrtc::PeerConnectionInterface::RTCConfiguration> enabled(
+      [config createNativeConfiguration]);
+  XCTAssertEqual(enabled->port_allocator_config.flags,
+                 unrelated | webrtc::PORTALLOCATOR_ENABLE_ANY_ADDRESS_PORTS);
+}
+
+- (void)testSctpSnapRoundTripBothValues {
+  for (NSNumber *enabled in @[ @NO, @YES ]) {
+    webrtc::PeerConnectionInterface::RTCConfiguration native;
+    native.enable_sctp_snap = enabled.boolValue;
+    RTC_OBJC_TYPE(RTCConfiguration) *config =
+        [[RTC_OBJC_TYPE(RTCConfiguration) alloc] initWithNativeConfiguration:native];
+    XCTAssertEqual(config.enableSctpSnap, enabled.boolValue);
+    config.enableSctpSnap = !enabled.boolValue;
+    std::unique_ptr<webrtc::PeerConnectionInterface::RTCConfiguration> changed(
+        [config createNativeConfiguration]);
+    XCTAssertEqual(changed->enable_sctp_snap, !enabled.boolValue);
+  }
+}
+
+- (void)testCapabilitiesCompareMediaKindValues {
+  RTC_OBJC_TYPE(RTCPeerConnectionFactory) *factory =
+      [[RTC_OBJC_TYPE(RTCPeerConnectionFactory) alloc] init];
+  RTC_OBJC_TYPE(RTCRtpCapabilities) *expectedSender =
+      [factory rtpSenderCapabilitiesForKind:kRTCMediaStreamTrackKindAudio];
+  RTC_OBJC_TYPE(RTCRtpCapabilities) *expectedReceiver =
+      [factory rtpReceiverCapabilitiesForKind:kRTCMediaStreamTrackKindAudio];
+  XCTAssertGreaterThan(expectedSender.codecs.count, 0u);
+  XCTAssertGreaterThan(expectedReceiver.codecs.count, 0u);
+
+  for (NSString *kind in @[ kRTCMediaStreamTrackKindAudio, @"audio",
+                           [NSMutableString stringWithString:@"audio"] ]) {
+    RTC_OBJC_TYPE(RTCRtpCapabilities) *sender =
+        [factory rtpSenderCapabilitiesForKind:kind];
+    RTC_OBJC_TYPE(RTCRtpCapabilities) *receiver =
+        [factory rtpReceiverCapabilitiesForKind:kind];
+    XCTAssertEqual(sender.codecs.count, expectedSender.codecs.count);
+    XCTAssertEqual(receiver.codecs.count, expectedReceiver.codecs.count);
+    XCTAssertEqualObjects(sender.codecs.firstObject.name,
+                          expectedSender.codecs.firstObject.name);
+    XCTAssertEqualObjects(receiver.codecs.firstObject.name,
+                          expectedReceiver.codecs.firstObject.name);
+  }
+}
+
+- (void)testCodecPreferencesGetterReadsNativeStateAcrossWrappers {
+  RTC_OBJC_TYPE(RTCPeerConnectionFactory) *factory =
+      [[RTC_OBJC_TYPE(RTCPeerConnectionFactory) alloc] init];
+  RTC_OBJC_TYPE(RTCConfiguration) *config =
+      [[RTC_OBJC_TYPE(RTCConfiguration) alloc] init];
+  RTC_OBJC_TYPE(RTCMediaConstraints) *constraints =
+      [[RTC_OBJC_TYPE(RTCMediaConstraints) alloc]
+          initWithMandatoryConstraints:@{} optionalConstraints:nil];
+  RTC_OBJC_TYPE(RTCPeerConnection) *peer =
+      [factory peerConnectionWithConfiguration:config
+                                   constraints:constraints delegate:nil];
+  XCTAssertNotNil(peer);
+  RTC_OBJC_TYPE(RTCRtpTransceiver) *transceiver =
+      [peer addTransceiverOfType:RTC_OBJC_TYPE(RTCRtpMediaTypeAudio)];
+  XCTAssertNotNil(transceiver);
+  XCTAssertEqual(transceiver.codecPreferences.count, 0u);
+  NSArray<RTC_OBJC_TYPE(RTCRtpCodecCapability) *> *supported =
+      [factory rtpSenderCapabilitiesForKind:@"audio"].codecs;
+  XCTAssertGreaterThan(supported.count, 0u);
+  NSArray<RTC_OBJC_TYPE(RTCRtpCodecCapability) *> *preferred = @[ supported.firstObject ];
+  NSError *error = nil;
+  XCTAssertTrue([transceiver setCodecPreferences:preferred error:&error]);
+  XCTAssertNil(error);
+  XCTAssertEqual(transceiver.codecPreferences.count, 1u);
+  XCTAssertEqualObjects(transceiver.codecPreferences.firstObject.name,
+                        preferred.firstObject.name);
+  RTC_OBJC_TYPE(RTCRtpTransceiver) *second =
+      [[RTC_OBJC_TYPE(RTCRtpTransceiver) alloc]
+          initWithFactory:factory nativeRtpTransceiver:transceiver.nativeRtpTransceiver];
+  XCTAssertEqualObjects(second.codecPreferences.firstObject.name,
+                        preferred.firstObject.name);
+  XCTAssertTrue([second setCodecPreferences:@[] error:&error]);
+  XCTAssertEqual(transceiver.codecPreferences.count, 0u);
+  [peer close];
+}
+
+@end
