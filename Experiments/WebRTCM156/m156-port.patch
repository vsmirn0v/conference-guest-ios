+VideoToolboxH264ProfileLevels QueryVideoToolboxH264ProfileLevelsForSize(int32_t width, int32_t height) {
+  if (@available(macOS 10.13, *)) {
+    // Native Mac's encoder path uses hardware acceleration. Do not advertise
+    // software-only levels when selecting its VideoToolbox profile-level-id.
+    NSDictionary *encoderSpecification = @{
