+  auto adm = _nativeAudioDeviceModule;
+  if (!adm || !_workerThread) return;
+  auto admission = std::make_shared<std::atomic<int>>(kConferenceAudioPending);
+  const bool prepared = _workerThread->BlockingCall([adm, admission] {
+    return webrtc::ios_adm::PrepareConferenceAudio(adm.get(), admission);
+  });
+  if (getenv("CONFERENCE_TEST_MEDIA_TRACE")) {
+    NSLog(@"Conference audio factory=%p built-in ADM=%p managed=%d", self, adm.get(), prepared);
+  }
