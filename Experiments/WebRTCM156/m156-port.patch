+TEST(PeerConnectionFactoryDependenciesTest,
+     AudioProcessingStateSnapshotDoesNotInitializeMediaEngine) {
+  auto ap_factory = std::make_unique<MockAudioProcessingBuilder>();
+  auto audio_processing = make_ref_counted<NiceMock<MockAudioProcessing>>();
+  EXPECT_CALL(*ap_factory, Build).WillOnce(Return(audio_processing));
+
+  scoped_refptr<AudioDeviceModule> adm = FakeAudioCaptureModule::Create();
+  PeerConnectionFactoryDependencies dependencies;
+  dependencies.adm = adm;
+  dependencies.audio_processing_builder = std::move(ap_factory);
+  dependencies.env = CreateTestEnvironment();
+  EnableMediaWithDefaults(dependencies);
+  auto factory = CreateModularPeerConnectionFactory(std::move(dependencies));
+  ASSERT_TRUE(factory);
+  Thread* const signaling_thread = Thread::Current();
+
+  AudioProcessing::Config config;
+  config.echo_canceller.enabled = true;
+  EXPECT_CALL(*audio_processing, GetConfig()).WillOnce([&] {
+    EXPECT_NE(Thread::Current(), signaling_thread);
+    return config;
+  });
+  EXPECT_CALL(*audio_processing, ApplyConfig(_)).Times(0);
+  EXPECT_FALSE(adm->Initialized());
+  const AudioProcessingState state = factory->GetAudioProcessingState();
+  EXPECT_TRUE(state.has_audio_processing_module);
+  EXPECT_EQ(state.echo_cancellation.software_active, true);
+  EXPECT_FALSE(adm->Initialized());
+}
