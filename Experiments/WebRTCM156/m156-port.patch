+
+#import <XCTest/XCTest.h>
+
+#import "api/peerconnection/RTCCryptoOptions.h"
+#import "api/peerconnection/RTCDataPacketCryptor.h"
+#import "api/peerconnection/RTCFrameCryptorKeyProvider+Private.h"
+
+@interface RTCFrameCryptorKeyProviderTest : XCTestCase
+@end
+
+@implementation RTCFrameCryptorKeyProviderTest
+
+- (void)testLegacyInitializersPreserveFailureTolerance {
+  NSData *salt = [@"ratchet salt" dataUsingEncoding:NSUTF8StringEncoding];
+  RTC_OBJC_TYPE(RTCFrameCryptorKeyProvider) *first =
+      [[RTC_OBJC_TYPE(RTCFrameCryptorKeyProvider) alloc]
+          initWithRatchetSalt:salt ratchetWindowSize:3 sharedKeyMode:YES
+          uncryptedMagicBytes:nil failureTolerance:2 keyRingSize:16];
+  XCTAssertEqual(first.nativeKeyProvider->options().failure_tolerance, 2);
+  XCTAssertFalse(first.nativeKeyProvider->options().discard_frame_when_cryptor_not_ready);
+  RTC_OBJC_TYPE(RTCFrameCryptorKeyProvider) *second =
+      [[RTC_OBJC_TYPE(RTCFrameCryptorKeyProvider) alloc]
+          initWithRatchetSalt:salt ratchetWindowSize:3 sharedKeyMode:YES
+          uncryptedMagicBytes:nil failureTolerance:4 keyRingSize:256
+          discardFrameWhenCryptorNotReady:YES];
+  XCTAssertEqual(second.nativeKeyProvider->options().failure_tolerance, 4);
+  XCTAssertTrue(second.nativeKeyProvider->options().discard_frame_when_cryptor_not_ready);
+}
+
+- (void)testPacketRoundTripAndTagRejection {
+  NSData *salt = [@"ratchet salt" dataUsingEncoding:NSUTF8StringEncoding];
+  NSData *key = [@"test material" dataUsingEncoding:NSUTF8StringEncoding];
+  NSData *cleartext = [@"authenticated packet" dataUsingEncoding:NSUTF8StringEncoding];
+  RTC_OBJC_TYPE(RTCFrameCryptorKeyProvider) *provider =
+      [[RTC_OBJC_TYPE(RTCFrameCryptorKeyProvider) alloc]
+          initWithRatchetSalt:salt ratchetWindowSize:0 sharedKeyMode:YES
+          uncryptedMagicBytes:nil failureTolerance:-1 keyRingSize:256];
+  [provider setSharedKey:key withIndex:255];
+  XCTAssertEqualObjects([provider exportSharedKey:255], key);
+  RTC_OBJC_TYPE(RTCDataPacketCryptor) *cryptor =
+      [[RTC_OBJC_TYPE(RTCDataPacketCryptor) alloc]
+          initWithAlgorithm:RTC_OBJC_TYPE(RTCCryptorAlgorithmAesGcm) keyProvider:provider];
+  RTC_OBJC_TYPE(RTCEncryptedPacket) *packet =
+      [cryptor encrypt:@"participant" keyIndex:255 data:cleartext];
+  XCTAssertNotNil(packet);
+  XCTAssertEqual(packet.keyIndex, 255u);
+  XCTAssertEqualObjects([cryptor decrypt:@"participant" encryptedPacket:packet], cleartext);
+  NSMutableData *tampered = [packet.data mutableCopy];
+  ((uint8_t *)tampered.mutableBytes)[tampered.length - 1] ^= 1;
+  RTC_OBJC_TYPE(RTCEncryptedPacket) *invalid =
+      [[RTC_OBJC_TYPE(RTCEncryptedPacket) alloc]
+          initWithData:tampered iv:packet.iv keyIndex:packet.keyIndex];
+  XCTAssertNil([cryptor decrypt:@"participant" encryptedPacket:invalid]);
+}
+
+- (void)testLegacyCryptoOptionsRetainSrtpDefaults {
+  RTC_OBJC_TYPE(RTCCryptoOptions) *options =
+      [[RTC_OBJC_TYPE(RTCCryptoOptions) alloc]
+          initWithSrtpEnableGcmCryptoSuites:YES
+          srtpEnableAes128Sha1_32CryptoCipher:NO
+          srtpEnableEncryptedRtpHeaderExtensions:YES
+          sframeRequireFrameEncryption:YES];
+  XCTAssertTrue(options.srtpEnableGcmCryptoSuites);
+  XCTAssertFalse(options.srtpPreferGcmCryptoSuites);
+  XCTAssertFalse(options.srtpEnableAes128Sha1_32CryptoCipher);
