+void DriveConferenceAudio() {
+  auto &coordinator = ConferenceCoordinator();
+  auto &ownership = coordinator.ownership;
+  auto action = ownership.Next();
+  UpdateConferenceAdmissions();
+  // Dropping a coalesced pending owner or a fully retired owner is safe here:
+  // this is never one of the factories' worker threads.
+  for (auto it = coordinator.owners.begin(); it != coordinator.owners.end();) {
+    if (it->first != ownership.active_owner() &&
+        it->first != ownership.desired_owner() &&
+        it->first != ownership.in_flight_owner()) {
+      it = coordinator.owners.erase(it);
+    } else {
+      ++it;
+    }
+  }
+  if (!action) return;
+  auto &owner = coordinator.owners.at(action->owner);
+  auto adm = owner.adm;
+  auto admission = owner.admission;
+  const auto operation = *action;
+  // Do not capture the record/factory. Its final release must not happen on its
+  // own worker. Workers never wait for the coordinator or another worker.
+  owner.worker->PostTask([adm, admission, operation] {
+    const int state = admission->load(std::memory_order_acquire);
+    const bool retire = operation.kind == ConferenceOwnership::Kind::kRetire || state < 0;
+    const int result = retire ? adm->RetireConferencePlayout()
+                              : adm->SetConferencePlayoutReserved(state == kConferenceAudioReserved);
+    if (result != 0 || getenv("CONFERENCE_TEST_MEDIA_TRACE")) {
+      NSLog(@"Conference audio owner=%llu operation=%llu retire=%d state=%d result=%d",
+            (unsigned long long)operation.owner, (unsigned long long)operation.id,
+            retire, state, result);
+    }
+    dispatch_async(ConferenceControlQueue(), ^{
+      if (ConferenceCoordinator().ownership.Complete(operation.id, result == 0)) {
+        DriveConferenceAudio();
+      }
+    });
+  });
