+        webrtc::H264ProfileLevelId(profile, *supportedLevel));
+    if (profileString) {
+      return [NSString stringForStdString:*profileString];
+    }
+  }
+  // Query failures, unknown values and a missing family retain Level 3.1.
+  return nil;
+}
