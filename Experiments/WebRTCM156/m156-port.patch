+    // Its new peer must not take ownership back from the replacement factory.
+    if (self->_conferencePlayoutState->load(std::memory_order_acquire) == kConferenceAudioRetired) {
+      if (getenv("CONFERENCE_TEST_MEDIA_TRACE")) {
+        NSLog(@"Conference audio ignores retired factory=%p owner=%llu", self,
+              (unsigned long long)self->_conferencePlayoutOwner);
+      }
+      return;
+    }
+    auto &coordinator = ConferenceCoordinator();
+    coordinator.owners.try_emplace(self->_conferencePlayoutOwner, ConferenceAudioOwner{
+        self, self->_workerThread.get(), self->_nativeAudioDeviceModule, self->_conferencePlayoutState});
+    coordinator.ownership.Select(self->_conferencePlayoutOwner);
+    DriveConferenceAudio();
+  });
