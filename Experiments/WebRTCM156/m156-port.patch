+class CoupledProcessingAudioDevice : public ::testing::NiceMock<test::MockAudioDeviceModule> {
+ public:
+  explicit CoupledProcessingAudioDevice(bool available) : available_(available) {}
+
+  PlatformAudioProcessingTopology GetPlatformAudioProcessingTopology() const override {
+    return PlatformAudioProcessingTopology::kEchoCancellationAndNoiseSuppressionCoupled;
+  }
+  bool PlatformVoiceProcessingPathIsAvailable() const override { return available_; }
+  int32_t EnablePlatformVoiceProcessingPath(bool enabled) override {
+    path_enabled_ = enabled && available_;
+    return enabled && !available_ ? -1 : 0;
+  }
+  bool BuiltInAECIsAvailable() const override { return available_; }
+  bool BuiltInNSIsAvailable() const override { return available_; }
+  bool BuiltInAGCIsAvailable() const override { return available_; }
+  int32_t EnableBuiltInAEC(bool enabled) override { aec_enabled_ = enabled; return 0; }
+  int32_t EnableBuiltInNS(bool enabled) override { ns_enabled_ = enabled; return 0; }
+  int32_t EnableBuiltInAGC(bool enabled) override { agc_enabled_ = enabled; return 0; }
+  PlatformAudioProcessingState GetPlatformAudioProcessingState() const override {
+    PlatformAudioProcessingState state;
+    state.topology = GetPlatformAudioProcessingTopology();
+    state.is_echo_cancellation_available = available_;
+    state.is_noise_suppression_available = available_;
+    state.is_auto_gain_control_available = available_;
+    state.is_voice_processing_enabled_requested = path_enabled_;
+    state.is_voice_processing_enabled_active = path_enabled_;
+    state.is_voice_processing_bypassed_requested = !path_enabled_;
+    state.is_voice_processing_bypassed_active = !path_enabled_;
+    state.is_echo_cancellation_requested = aec_enabled_;
+    state.is_noise_suppression_requested = ns_enabled_;
+    state.is_auto_gain_control_requested = agc_enabled_;
+    state.is_echo_cancellation_active = path_enabled_ && aec_enabled_;
+    state.is_noise_suppression_active = path_enabled_ && ns_enabled_;
+    state.is_auto_gain_control_active = path_enabled_ && agc_enabled_;
+    return state;
+  }
+
+ private:
+  const bool available_;
+  bool path_enabled_ = false;
+  bool aec_enabled_ = false;
+  bool ns_enabled_ = false;
+  bool agc_enabled_ = false;
+};
+
+TEST(WebRtcVoiceEngineTest, CoupledADMDefaultCommunicationProcessing) {
+  test::RunLoop run_loop;
+  for (bool platform_available : {false, true}) {
+    Environment env = CreateTestEnvironment();
+    auto adm = make_ref_counted<CoupledProcessingAudioDevice>(platform_available);
+    scoped_refptr<AudioProcessing> apm = BuiltinAudioProcessingBuilder().Build(env);
+    WebRtcVoiceEngine engine(
+        env, adm, MockAudioEncoderFactory::CreateUnusedFactory(),
+        MockAudioDecoderFactory::CreateUnusedFactory(), nullptr, apm, nullptr);
+    AutoInitTerminate init_term(engine);
+
+    const AudioProcessingState state = engine.GetAudioProcessingState();
+    EXPECT_EQ(true, state.echo_cancellation.requested_enabled);
+    EXPECT_EQ(true, state.noise_suppression.requested_enabled);
+    EXPECT_EQ(true, state.auto_gain_control.requested_enabled);
+    const auto expected = platform_available ? AudioProcessingImplementation::kPlatform
+                                            : AudioProcessingImplementation::kSoftware;
+    EXPECT_EQ(expected, state.echo_cancellation.effective);
+    EXPECT_EQ(expected, state.noise_suppression.effective);
+    EXPECT_EQ(expected, state.auto_gain_control.effective);
+    const AudioProcessing::Config config = apm->GetConfig();
+    EXPECT_EQ(!platform_available, config.echo_canceller.enabled);
+    EXPECT_EQ(!platform_available, config.noise_suppression.enabled);
+    EXPECT_EQ(!platform_available, config.gain_controller1.enabled);
+  }
+}
