+# Native macOS regression runners. XCTest discovers XCTestCase classes in the
+# loadable bundle; neither the iOS UIApplicationMain nor gtest main is linked.
+if (rtc_include_tests && is_mac && !build_with_chromium) {
+  rtc_test("m155_processing_tests") {
+    deps = [
+      ":sdk_tests",
+      "../test:test_main",
+    ]
+  }
+
+  config("m155_sdk_xctest_config") {
+    # mac_sdk.gni creates this platform symlink for system Xcode builds.
+    _framework_dir = "$root_build_dir/sdk/xcode_links/MacOSX.platform/Developer/Library/Frameworks"
+    if (!use_system_xcode) {
+      _framework_dir = "//build/mac_files/xcode_binaries/Contents/Developer/Platforms/MacOSX.platform/Developer/Library/Frameworks"
+    }
+    framework_dirs = [ _framework_dir ]
+    frameworks = [
+      "CoreMedia.framework",
+      "Foundation.framework",
+      "VideoToolbox.framework",
+      "XCTest.framework",
+    ]
+    ldflags = [ "-Wl,-rpath," + rebase_path(_framework_dir) ]
+  }
+
+  # Use the existing visibility granted by video_toolbox_cc to this label. The
+  # iOS version of this target above is in a mutually exclusive platform branch.
+  rtc_library("sdk_unittests_sources") {
+    testonly = true
+    sources = [
+      "objc/unittests/RTCConfigurationCompatibility_xctest.mm",
+      "objc/unittests/RTCFrameCryptorKeyProvider_xctest.mm",
+      "objc/unittests/nalu_rewriter_xctest.mm",
+    ]
+    configs += [
+      "..:common_objc",
+      ":m155_sdk_xctest_config",
+    ]
+    deps = [
+      ":base_objc",
+      ":default_codec_factory_objc",
+      ":mediaconstraints_objc",
+      ":peerconnectionfactory_base_objc",
+      ":video_toolbox_cc",
+      "../api:peer_connection_interface",
+      "../api/crypto:frame_crypto_transformer",
+      "../common_video",
+      "../p2p:port_allocator",
