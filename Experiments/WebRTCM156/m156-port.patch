+TEST(KeyProviderM155, CopyPreservesEveryOption) {
+  KeyProviderOptions options;
+  options.shared_key = true;
+  options.ratchet_salt = {1, 2, 3};
+  options.uncrypted_magic_bytes = {4, 5};
+  options.ratchet_window_size = 3;
+  options.failure_tolerance = 2;
+  options.key_ring_size = 256;
+  options.discard_frame_when_cryptor_not_ready = true;
+  options.key_derivation_algorithm = kHKDF;
+  auto provider = make_ref_counted<DefaultKeyProviderImpl>(options);
+  const auto& copy = provider->options();
+  EXPECT_EQ(copy.shared_key, options.shared_key);
+  EXPECT_EQ(copy.ratchet_salt, options.ratchet_salt);
+  EXPECT_EQ(copy.uncrypted_magic_bytes, options.uncrypted_magic_bytes);
+  EXPECT_EQ(copy.ratchet_window_size, options.ratchet_window_size);
+  EXPECT_EQ(copy.failure_tolerance, options.failure_tolerance);
+  EXPECT_EQ(copy.key_ring_size, options.key_ring_size);
+  EXPECT_TRUE(copy.discard_frame_when_cryptor_not_ready);
+  EXPECT_EQ(copy.key_derivation_algorithm, options.key_derivation_algorithm);
+}
+
+TEST(DataPacketCryptorM155, RejectsTamperedCiphertextTagAndIv) {
+  KeyProviderOptions options;
+  options.ratchet_salt = {0, 1, 2, 3, 4, 5, 6, 7};
+  auto provider = make_ref_counted<DefaultKeyProviderImpl>(options);
+  ASSERT_TRUE(provider->SetKey("participant", 0, std::vector<uint8_t>(16, 0x42)));
+  auto cryptor = make_ref_counted<DataPacketCryptor>(
+      FrameCryptorTransformer::Algorithm::kAesGcm, provider);
+  const std::vector<uint8_t> cleartext(32, 0x7b);
+  auto result = cryptor->Encrypt("participant", 0, cleartext);
+  ASSERT_TRUE(result.ok());
+  auto packet = result.value();
+  auto original = packet->data;
+  packet->data[0] ^= 1;
+  EXPECT_FALSE(cryptor->Decrypt("participant", packet).ok());
+  packet->data = original;
+  packet->data.back() ^= 1;
+  EXPECT_FALSE(cryptor->Decrypt("participant", packet).ok());
+  packet->data = original;
+  packet->iv[0] ^= 1;
+  EXPECT_FALSE(cryptor->Decrypt("participant", packet).ok());
+  packet->iv[0] ^= 1;
+  auto recovered = cryptor->Decrypt("participant", packet);
+  ASSERT_TRUE(recovered.ok());
+  EXPECT_EQ(recovered.value(), cleartext);
+}
