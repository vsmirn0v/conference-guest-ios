+class CollectingObserver : public FrameCryptorTransformerObserver {
+ public:
+  void OnFrameCryptionStateChanged(const std::string participant_id,
+                                   FrameCryptionState state) override {
+    last = state;
+    event.Set();
+  }
+  FrameCryptionState last = FrameCryptionState::kNew;
+  Event event;
+};
+
+class FrameCryptorM155Test : public ::testing::Test {
+ protected:
+  void SetUp() override {
+    KeyProviderOptions options;
+    options.shared_key = true;
+    options.ratchet_salt = {0, 1, 2, 3, 4, 5, 6, 7};
+    provider_ = make_ref_counted<DefaultKeyProviderImpl>(options);
+    ASSERT_TRUE(provider_->SetSharedKey(0, std::vector<uint8_t>(16, 0x42)));
+    signaling_ = Thread::Create();
+    ASSERT_TRUE(signaling_->Start());
+    cryptor_ = scoped_refptr<FrameCryptorTransformer>(new FrameCryptorTransformer(
+        signaling_.get(), "participant",
+        FrameCryptorTransformer::MediaType::kVideoFrame,
+        FrameCryptorTransformer::Algorithm::kAesGcm, provider_));
+    cryptor_->SetEnabled(true);
+  }
+
+  void TearDown() override {
+    cryptor_ = nullptr;
+    signaling_->Stop();
+  }
+
+  std::vector<uint8_t> Transform(std::vector<uint8_t> data,
+                                 VideoCodecType codec,
+                                 RtpTimestampInfo timestamp,
+                                 TransformableFrameInterface::Direction direction,
+                                 bool expect_output = true,
+                                 FrameCryptionState expected_failure =
+                                     FrameCryptionState::kDecryptionFailed) {
+    auto payload = std::make_shared<std::vector<uint8_t>>(std::move(data));
+    auto frame = std::make_unique<NiceMock<MockTransformableVideoFrame>>();
+    VideoFrameMetadata metadata;
+    metadata.SetCodec(codec);
+    ON_CALL(*frame, GetDirection()).WillByDefault(Return(direction));
+    ON_CALL(*frame, GetSsrc()).WillByDefault(Return(kSsrc));
+    ON_CALL(*frame, GetRtpTimestampInfo()).WillByDefault(Return(timestamp));
+    ON_CALL(*frame, Metadata()).WillByDefault(Return(metadata));
+    ON_CALL(*frame, IsKeyFrame()).WillByDefault(Return(true));
+    ON_CALL(*frame, GetData()).WillByDefault([payload] {
+      return std::span<const uint8_t>(*payload);
+    });
+    ON_CALL(*frame, SetData(::testing::_))
+        .WillByDefault([payload](std::span<const uint8_t> bytes) {
+          payload->assign(bytes.begin(), bytes.end());
+        });
+    // Any regression to the deprecated timestamp API fails this test.
+    EXPECT_CALL(*frame, GetTimestamp()).Times(0);
+    auto sink = make_ref_counted<CollectingSink>();
+    auto observer = make_ref_counted<CollectingObserver>();
+    cryptor_->RegisterFrameCryptorTransformerObserver(observer);
+    scoped_refptr<FrameTransformerInterface> as_interface = cryptor_;
+    as_interface->RegisterTransformedFrameSinkCallback(sink, kSsrc);
+    as_interface->Transform(std::move(frame));
+    if (!expect_output) {
+      EXPECT_TRUE(observer->event.Wait(TimeDelta::Seconds(5)));
+      EXPECT_EQ(observer->last, expected_failure);
+      EXPECT_FALSE(sink->event.Wait(TimeDelta::Millis(200)));
+      as_interface->UnregisterTransformedFrameSinkCallback(kSsrc);
+      cryptor_->UnRegisterFrameCryptorTransformerObserver();
+      return {};
+    }
+    const bool completed = sink->event.Wait(TimeDelta::Seconds(5));
+    EXPECT_TRUE(completed);
+    as_interface->UnregisterTransformedFrameSinkCallback(kSsrc);
+    cryptor_->UnRegisterFrameCryptorTransformerObserver();
+    return completed ? sink->data : std::vector<uint8_t>();
+  }
+
+  static constexpr uint32_t kSsrc = 0x12345678;
+  scoped_refptr<DefaultKeyProviderImpl> provider_;
+  std::unique_ptr<Thread> signaling_;
+  scoped_refptr<FrameCryptorTransformer> cryptor_;
+};
+
+TEST_F(FrameCryptorM155Test, UsesBothTimestampVariantsAndVp8Metadata) {
+  const uint32_t timestamp = 0x11223344;
+  const std::vector<RtpTimestampInfo> timestamps = {
+      RtpTimestampWithOffset{timestamp}, RtpTimestampWithoutOffset{timestamp}};
+  const std::vector<uint8_t> cleartext(40, 0x42);
+  for (const auto& info : timestamps) {
+    auto encrypted = Transform(cleartext, kVideoCodecVP8, info,
+                               TransformableFrameInterface::Direction::kSender);
+    ASSERT_EQ(encrypted.size(), cleartext.size() + 16u + 12u + 2u);
+    // VP8 key-frame framing preserves the first ten bytes as authenticated data.
+    EXPECT_TRUE(std::equal(cleartext.begin(), cleartext.begin() + 10,
+                           encrypted.begin()));
+    const size_t iv_start = encrypted.size() - 14;
+    EXPECT_EQ(encrypted[iv_start + 4], 0x11);
+    EXPECT_EQ(encrypted[iv_start + 5], 0x22);
+    EXPECT_EQ(encrypted[iv_start + 6], 0x33);
+    EXPECT_EQ(encrypted[iv_start + 7], 0x44);
+    EXPECT_EQ(Transform(encrypted, kVideoCodecVP8, info,
+                        TransformableFrameInterface::Direction::kReceiver),
+              cleartext);
+  }
+}
+
+TEST_F(FrameCryptorM155Test, UsesH264MetadataForNaluFraming) {
+  const std::vector<uint8_t> cleartext = {
+      0, 0, 0, 1, 0x65, 0x88, 0x84, 0x0a, 0xf2, 0x62, 0x80, 0, 0xa7, 0xbe};
+  const RtpTimestampInfo timestamp = RtpTimestampWithOffset{0x11223344};
+  auto encrypted = Transform(cleartext, kVideoCodecH264, timestamp,
+                             TransformableFrameInterface::Direction::kSender);
+  ASSERT_GE(encrypted.size(), cleartext.size() + 16u + 12u + 2u);
+  EXPECT_TRUE(std::equal(cleartext.begin(), cleartext.begin() + 6,
+                         encrypted.begin()));
+  EXPECT_EQ(Transform(encrypted, kVideoCodecH264, timestamp,
+                      TransformableFrameInterface::Direction::kReceiver),
+            cleartext);
+}
+
+#ifdef RTC_ENABLE_H265
+TEST_F(FrameCryptorM155Test, RoundTripsH265RaslAndIdrNalus) {
+  EXPECT_EQ(H265::kRaslN, 8);
+  EXPECT_EQ(H265::kRaslR, 9);
+  const RtpTimestampInfo timestamp = RtpTimestampWithOffset{0x11223344};
+  for (const auto nalu_type :
+       {H265::kRaslN, H265::kRaslR, H265::kIdrWRadl, H265::kIdrNLp}) {
+    SCOPED_TRACE(static_cast<int>(nalu_type));
+    const std::vector<uint8_t> cleartext = {
+        0,    0,    0,    1, static_cast<uint8_t>(nalu_type << 1), 1,
+        0x80, 0x42, 0x53, 0x64, 0x75, 0x86, 0x97, 0xa8, 0xb9, 0xca};
+    auto encrypted = Transform(cleartext, kVideoCodecH265, timestamp,
+                               TransformableFrameInterface::Direction::kSender);
+    ASSERT_GE(encrypted.size(), cleartext.size() + 16u + 12u + 2u);
+    // Preserve the Annex B start code and both bytes of the H.265 NAL header.
+    EXPECT_TRUE(std::equal(cleartext.begin(), cleartext.begin() + 6,
+                           encrypted.begin()));
+    EXPECT_FALSE(std::equal(cleartext.begin() + 6, cleartext.end(),
+                            encrypted.begin() + 6));
+    EXPECT_EQ(Transform(encrypted, kVideoCodecH265, timestamp,
+                        TransformableFrameInterface::Direction::kReceiver),
+              cleartext);
+  }
+}
+
+TEST_F(FrameCryptorM155Test, DropsTruncatedH265NaluHeaderBeforeEncryption) {
+  // A VCL type requires two NAL header bytes. The existing framing guard must
+  // reject this before copying the clear header or subtracting its length.
+  Transform({0, 0, 0, 1, static_cast<uint8_t>(H265::kRaslN << 1)},
+            kVideoCodecH265, RtpTimestampWithOffset{0x11223344},
+            TransformableFrameInterface::Direction::kSender, false,
+            FrameCryptionState::kEncryptionFailed);
+}
+
+TEST_F(FrameCryptorM155Test, DropsTruncatedH265EncryptedFrame) {
+  Transform({0, 0, 0, 1, static_cast<uint8_t>(H265::kIdrWRadl << 1)},
+            kVideoCodecH265, RtpTimestampWithOffset{0x11223344},
+            TransformableFrameInterface::Direction::kReceiver, false);
+}
+#endif
+
+TEST_F(FrameCryptorM155Test, DropsTruncatedEncryptedFrame) {
+  Transform({0xff}, kVideoCodecVP8, RtpTimestampWithOffset{1},
+            TransformableFrameInterface::Direction::kReceiver, false);
+}
+
+}  // namespace
+}  // namespace webrtc
