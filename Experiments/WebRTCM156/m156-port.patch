+// Revoke before posting retirement. SDK tasks already queued on an old worker
+// see the atomic gate and cannot start hardware while retirement is pending.
+void UpdateConferenceAdmissions() {
+  auto &coordinator = ConferenceCoordinator();
+  auto &ownership = coordinator.ownership;
+  for (auto &[owner, record] : coordinator.owners) {
+    int state = kConferenceAudioRetired;
+    if (owner == ownership.desired_owner()) {
+      const bool retiring = ownership.in_flight() &&
+          ownership.in_flight()->kind == ConferenceOwnership::Kind::kRetire;
+      state = owner == ownership.active_owner() && !retiring
+          ? (ownership.desired_reserved() ? kConferenceAudioReserved : kConferenceAudioAdmitted)
+          : kConferenceAudioPending;
+    }
+    record.admission->store(state, std::memory_order_release);
+  }
