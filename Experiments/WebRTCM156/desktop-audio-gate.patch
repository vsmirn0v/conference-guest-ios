+  // Process lifetime: queued main work and audio workers outlive owner teardown.
+  static auto* const state = new ApplicationInputMuteState;
+  return *state;
+}
+void ScheduleApplicationInputMuteRestore(int delay_ms = 0) {
+  if (!CurrentApplicationInputMute().QueueRestore()) return;
+  dispatch_after(dispatch_time(DISPATCH_TIME_NOW, delay_ms * NSEC_PER_MSEC),
+                 dispatch_get_main_queue(), ^{
+    auto result = CurrentApplicationInputMute().Restore([](bool muted) {
+      if (@available(macOS 14.0, *)) {
+        AVAudioApplication* application = [AVAudioApplication sharedInstance];
+        if (application.isInputMuted != muted) {
+          NSError* error = nil;
+          if (![application setInputMuted:muted error:&error]) {
+            RTC_LOG(LS_ERROR) << "Could not restore application input mute";
+            return false;
+          }
+        }
+      }
+      return true;
+    });
+    if (result == ApplicationInputMuteState::RestoreResult::kRetry) {
+      ScheduleApplicationInputMuteRestore(250);
+    }
+  });
+}
+}  // namespace
+void SetApplicationInputMuteIntent(int muted) {
+  RTC_DCHECK([NSThread isMainThread]);
+  auto& state = CurrentApplicationInputMute();
+  state.SetIntent(muted);
+  if (state.IsReconfiguring()) ScheduleApplicationInputMuteRestore();
+}
+bool ApplicationInputMuteReconfiguring() {
+  return CurrentApplicationInputMute().IsReconfiguring();
+}
+ScopedApplicationInputMuteReconfiguration::ScopedApplicationInputMuteReconfiguration() {
+  if (@available(macOS 14.0, *)) {
+    active_ = true;
+    CurrentApplicationInputMute().BeginReconfiguration();
+  }
+}
+ScopedApplicationInputMuteReconfiguration::~ScopedApplicationInputMuteReconfiguration() {
+  if (!active_) return;
+  CurrentApplicationInputMute().EndReconfiguration();
+  ScheduleApplicationInputMuteRestore();
+}
