+namespace webrtc::mac_adm {
+// No platform calls under this lock. Platform reconciliation and app writes run
+// on main; native lifecycle scopes only publish pending work from their workers.
+class ApplicationInputMuteState {
+ public:
+  struct Snapshot { int intent; uint64_t generation; unsigned attempt; };
+  enum class RestoreResult { kIdle, kComplete, kRetry };
+  void SetIntent(int muted) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    intent_ = muted < 0 ? -1 : (muted != 0 ? 1 : 0);
+    ++generation_;
+    attempts_ = 0;
+  }
+  void BeginReconfiguration() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    ++depth_;
+    ++generation_;
+    attempts_ = 0;
+  }
+  void EndReconfiguration() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    assert(depth_ != 0);
+    --depth_;
+    ++generation_;
+    attempts_ = 0;
+    pending_ = true;
+  }
+  bool IsReconfiguring() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return depth_ != 0 || pending_;
+  }
+  bool QueueRestore() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (queued_ || (!pending_ && depth_ == 0)) return false;
+    queued_ = true;
+    return true;
+  }
+  bool SnapshotForRestore(Snapshot* snapshot) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    queued_ = false;
+    if (depth_ != 0 || !pending_) return false;
+    *snapshot = {intent_, generation_, ++attempts_};
+    return true;
+  }
+  template <typename Apply>
+  RestoreResult Restore(Apply apply) {
+    Snapshot current;
+    if (!SnapshotForRestore(&current)) return RestoreResult::kIdle;
+    // Platform writes happen outside the state lock, on main. A released owner
+    // (-1) must not override CallKit or another engine's platform mute state.
+    if (current.intent < 0 || apply(current.intent != 0)) {
+      DidRestore(current.generation);
+      return RestoreResult::kComplete;
+    }
+    if (current.attempt < 5) return RestoreResult::kRetry;
+    // Do not permanently disable accessory gestures after exhausting a bounded
+    // restore. The SDK's network mute is independent and stays unchanged.
+    DidRestore(current.generation);
+    return RestoreResult::kComplete;
+  }
+  void DidRestore(uint64_t generation) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (depth_ == 0 && generation_ == generation) pending_ = false;
+  }
+ private:
+  mutable std::mutex mutex_;
+  int intent_ = -1;  // No app-owned intent before the first app write.
+  unsigned depth_ = 0;
+  uint64_t generation_ = 0;
+  bool pending_ = false;
+  bool queued_ = false;
+  unsigned attempts_ = 0;
+};
+// Native-Mac ownership exports are implemented by AudioEngineDevice's TU.
+void SetApplicationInputMuteIntent(int muted);
+bool ApplicationInputMuteReconfiguring();
+class ScopedApplicationInputMuteReconfiguration {
+ public:
+  ScopedApplicationInputMuteReconfiguration();
+  ~ScopedApplicationInputMuteReconfiguration();
+ private:
+  bool active_ = false;
+};
+}  // namespace webrtc::mac_adm
