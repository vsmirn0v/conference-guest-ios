 namespace webrtc {
+
+namespace {
+std::atomic<uint64_t> application_capture_state{0};
+static_assert(std::atomic<uint64_t>::is_always_lock_free);
+}  // namespace
+
+void SetApplicationCaptureMuted(bool muted) {
+  uint64_t previous = application_capture_state.load(std::memory_order_acquire);
+  // Every mute invalidates pending opens, including while capture is already
+  // closed for an in-flight user unmute operation.
+  while (muted || (previous & 1) != static_cast<uint64_t>(muted)) {
+    const uint64_t next = ((previous & ~uint64_t{1}) + 2) |
+                          static_cast<uint64_t>(muted);
+    if (application_capture_state.compare_exchange_weak(
+            previous, next, std::memory_order_acq_rel,
+            std::memory_order_acquire)) return;
+  }
+}
+
+uint64_t ApplicationCaptureState() {
+  return application_capture_state.load(std::memory_order_acquire);
+}
+
+bool UnmuteApplicationCaptureIfState(uint64_t expected_state) {
+  const uint64_t next = (expected_state & 1)
+      ? ((expected_state & ~uint64_t{1}) + 2) : expected_state;
+  return application_capture_state.compare_exchange_strong(
+      expected_state, next, std::memory_order_acq_rel,
+      std::memory_order_acquire);
+}
 
