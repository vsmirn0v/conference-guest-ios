+#ifndef MODULES_AUDIO_DEVICE_MAC_APPLICATION_INPUT_MUTE_STATE_H_
+#define MODULES_AUDIO_DEVICE_MAC_APPLICATION_INPUT_MUTE_STATE_H_
+
+#include <cassert>
+#include <cstdint>
+#include <mutex>
