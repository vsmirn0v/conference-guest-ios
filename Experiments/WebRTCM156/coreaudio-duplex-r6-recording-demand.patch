+                     }) async -> GuestRecordingDemandWaitReceipt {
+        let started = now()
+        var observations = 0
+        func finish(_ status: GuestRecordingDemandWaitStatus) -> GuestRecordingDemandWaitReceipt {
+            .init(status: status, startedUptime: started, finishedUptime: now(),
+                  deadlineUptime: deadlineUptime, observations: observations)
+        }
+        guard deadlineUptime.isFinite, started.isFinite else { return finish(.invalidDeadline) }
+        while true {
+            if cancelled() { return finish(.cancelled) }
+            let current = now()
+            guard current.isFinite, current >= started else { return finish(.invalidDeadline) }
+            if current >= deadlineUptime { return finish(.timedOut) }
+            let value = observe(); observations += 1
+            if !value.ownerCurrent { return finish(.ownerRetired) }
+            if value.terminal { return finish(.terminal) }
+            if !value.requestCurrent { return finish(.superseded) }
+            guard let requested = value.recordingRequested else { return finish(.unsupported) }
+            if cancelled() { return finish(.cancelled) }
+            let after = now()
+            guard after.isFinite, after >= current else { return finish(.invalidDeadline) }
+            if after >= deadlineUptime { return finish(.timedOut) }
+            if requested { return finish(.ready) }
