diff --git a/modules/audio_device/audio_engine_configuration_recovery_gate.h b/modules/audio_device/audio_engine_configuration_recovery_gate.h
new file mode 100644
--- /dev/null
+++ b/modules/audio_device/audio_engine_configuration_recovery_gate.h
@@ -0,0 +1,56 @@
+/* Copyright 2026 Rock'n'Roll contributors. BSD license: see LICENSE. */
+#ifndef MODULES_AUDIO_DEVICE_AUDIO_ENGINE_CONFIGURATION_RECOVERY_GATE_H_
+#define MODULES_AUDIO_DEVICE_AUDIO_ENGINE_CONFIGURATION_RECOVERY_GATE_H_
+
+#include <cstdint>
+
+namespace webrtc {
+
+// Sequence-bound admission for deferred AVAudioEngine configuration recovery.
+// AudioEngineDevice confines this gate to its worker thread. Notification
+// callbacks carry Registration values and never access the gate off-thread.
+class AudioEngineConfigurationRecoveryGate {
+ public:
+  struct Registration {
+    uint64_t epoch = 0;
+    uintptr_t engine_identity = 0;
+  };
+
+  struct RecoveryState {
+    uintptr_t engine_identity = 0;
+    bool initialized = false;
+    bool device_mode = false;
+    bool any_running = false;
+    bool engine_running = false;
+  };
+
+  [[nodiscard]] Registration RegisterEngine(uintptr_t engine_identity) {
+    ++current_.epoch;
+    current_.engine_identity = engine_identity;
+    return current_;
+  }
+
+  void Invalidate() {
+    ++current_.epoch;
+    current_.engine_identity = 0;
+  }
+
+  // Revalidate at task execution time, before changing logical engine state.
+  // A route-driven rebuild invalidates its registration; a successful restart
+  // makes duplicate notifications no-ops through engine_running.
+  [[nodiscard]] bool ShouldRecover(const Registration& registration,
+                                   const RecoveryState& state) const {
+    return state.initialized && state.engine_identity != 0 &&
+           registration.epoch == current_.epoch &&
+           registration.engine_identity == current_.engine_identity &&
+           registration.engine_identity == state.engine_identity &&
+           state.device_mode && state.any_running && !state.engine_running;
+  }
+
+ private:
+  Registration current_;
+};
+
+}  // namespace webrtc
+
+#endif  // MODULES_AUDIO_DEVICE_AUDIO_ENGINE_CONFIGURATION_RECOVERY_GATE_H_
diff --git a/modules/audio_device/audio_engine_configuration_recovery_gate_unittest.cc b/modules/audio_device/audio_engine_configuration_recovery_gate_unittest.cc
new file mode 100644
--- /dev/null
+++ b/modules/audio_device/audio_engine_configuration_recovery_gate_unittest.cc
@@ -0,0 +1,108 @@
+/* Copyright 2026 Rock'n'Roll contributors. BSD license: see LICENSE. */
+
+#include "modules/audio_device/audio_engine_configuration_recovery_gate.h"
+
+#include "test/gtest.h"
+
+namespace webrtc {
+namespace {
+
+constexpr uintptr_t kOldEngine = 0x1000;
+constexpr uintptr_t kReplacementEngine = 0x2000;
+
+AudioEngineConfigurationRecoveryGate::RecoveryState StoppedDeviceState(
+    uintptr_t engine_identity = kOldEngine) {
+  AudioEngineConfigurationRecoveryGate::RecoveryState state;
+  state.engine_identity = engine_identity;
+  state.initialized = true;
+  state.device_mode = true;
+  state.any_running = true;
+  state.engine_running = false;
+  return state;
+}
+
+TEST(AudioEngineConfigurationRecoveryGateTest,
+     DeviceRebuildInvalidatesQueuedRecovery) {
+  AudioEngineConfigurationRecoveryGate gate;
+  const auto queued = gate.RegisterEngine(kOldEngine);
+
+  // Default-device recovery removes the old observer and installs a new one.
+  gate.Invalidate();
+  const auto replacement = gate.RegisterEngine(kReplacementEngine);
+  const auto state = StoppedDeviceState(kReplacementEngine);
+
+  EXPECT_FALSE(gate.ShouldRecover(queued, state));
+  EXPECT_TRUE(gate.ShouldRecover(replacement, state));
+}
+
+TEST(AudioEngineConfigurationRecoveryGateTest,
+     RestartBeforeTaskExecutionSuppressesRecovery) {
+  AudioEngineConfigurationRecoveryGate gate;
+  const auto queued = gate.RegisterEngine(kOldEngine);
+  auto state = StoppedDeviceState();
+
+  // Another path restarted the engine after the notification was queued.
+  state.engine_running = true;
+  EXPECT_FALSE(gate.ShouldRecover(queued, state));
+}
+
+TEST(AudioEngineConfigurationRecoveryGateTest,
+     OldEngineNotificationCannotRecoverReplacement) {
+  AudioEngineConfigurationRecoveryGate gate;
+  const auto stale = gate.RegisterEngine(kOldEngine);
+  const auto current = gate.RegisterEngine(kReplacementEngine);
+  const auto state = StoppedDeviceState(kReplacementEngine);
+
+  EXPECT_FALSE(gate.ShouldRecover(stale, state));
+  EXPECT_TRUE(gate.ShouldRecover(current, state));
+}
+
+TEST(AudioEngineConfigurationRecoveryGateTest,
+     RepeatedNotificationsRecoverOnlyUntilEngineRuns) {
+  AudioEngineConfigurationRecoveryGate gate;
+  const auto queued = gate.RegisterEngine(kOldEngine);
+  auto state = StoppedDeviceState();
+  int recovery_count = 0;
+
+  // Model serialized tasks on the audio worker. A successful first recovery
+  // starts the engine before the next queued notification is examined.
+  for (int i = 0; i < 3; ++i) {
+    if (gate.ShouldRecover(queued, state)) {
+      ++recovery_count;
+      state.engine_running = true;
+    }
+  }
+
+  EXPECT_EQ(recovery_count, 1);
+}
+
+TEST(AudioEngineConfigurationRecoveryGateTest,
+     GenuineStoppedConfigurationChangeIsRecoverable) {
+  AudioEngineConfigurationRecoveryGate gate;
+  const auto queued = gate.RegisterEngine(kOldEngine);
+  const auto state = StoppedDeviceState();
+
+  EXPECT_TRUE(gate.ShouldRecover(queued, state));
+}
+
+TEST(AudioEngineConfigurationRecoveryGateTest,
+     RecoveryRequiresCurrentLogicalDeviceDemand) {
+  AudioEngineConfigurationRecoveryGate gate;
+  const auto queued = gate.RegisterEngine(kOldEngine);
+  auto state = StoppedDeviceState();
+
+  state.initialized = false;
+  EXPECT_FALSE(gate.ShouldRecover(queued, state));
+  state = StoppedDeviceState();
+  state.device_mode = false;
+  EXPECT_FALSE(gate.ShouldRecover(queued, state));
+  state = StoppedDeviceState();
+  state.any_running = false;
+  EXPECT_FALSE(gate.ShouldRecover(queued, state));
+  state = StoppedDeviceState();
+  state.engine_identity = 0;
+  EXPECT_FALSE(gate.ShouldRecover(queued, state));
+}
+
+}  // namespace
+}  // namespace webrtc
diff --git a/modules/audio_device/audio_engine_default_route_policy.h b/modules/audio_device/audio_engine_default_route_policy.h
new file mode 100644
--- /dev/null
+++ b/modules/audio_device/audio_engine_default_route_policy.h
@@ -0,0 +1,41 @@
+/* Copyright 2026 Rock'n'Roll contributors. BSD license: see LICENSE. */
+#ifndef MODULES_AUDIO_DEVICE_AUDIO_ENGINE_DEFAULT_ROUTE_POLICY_H_
+#define MODULES_AUDIO_DEVICE_AUDIO_ENGINE_DEFAULT_ROUTE_POLICY_H_
+
+namespace webrtc {
+
+// Decides whether a system-default notification needs an application-initiated
+// engine rebuild. This policy is independent of configuration-notification
+// recovery, which must still rebuild an engine that Core Audio has stopped.
+class AudioEngineDefaultRoutePolicy {
+ public:
+  struct State {
+    bool input_default_changed = false;
+    bool output_default_changed = false;
+    bool input_default = false;
+    bool output_default = false;
+    bool input_enabled = false;
+    bool output_enabled = false;
+    bool voice_processing_enabled = false;
+  };
+
+  [[nodiscard]] static constexpr bool RequiresRecreate(const State& state) {
+    const bool default_changed =
+        state.input_default_changed || state.output_default_changed;
+    const bool native_default_duplex =
+        state.input_default && state.output_default && state.input_enabled &&
+        state.output_enabled && state.voice_processing_enabled;
+
+    // VPIO's aggregate device follows both system defaults itself. Recreating
+    // its engine on the default-device timer races that migration and can
+    // start a replacement while the route is still settling. A genuine native
+    // configuration stop remains recoverable through ReconfigureEngine().
+    // Preserve the existing explicit rebuild for pinned devices, non-VPIO and
+    // single-direction graphs.
+    return default_changed && !native_default_duplex;
+  }
+};
+
+}  // namespace webrtc
+
+#endif  // MODULES_AUDIO_DEVICE_AUDIO_ENGINE_DEFAULT_ROUTE_POLICY_H_
diff --git a/modules/audio_device/audio_engine_default_route_policy_unittest.cc b/modules/audio_device/audio_engine_default_route_policy_unittest.cc
new file mode 100644
--- /dev/null
+++ b/modules/audio_device/audio_engine_default_route_policy_unittest.cc
@@ -0,0 +1,88 @@
+/* Copyright 2026 Rock'n'Roll contributors. BSD license: see LICENSE. */
+
+#include "modules/audio_device/audio_engine_default_route_policy.h"
+
+#include "test/gtest.h"
+
+namespace webrtc {
+namespace {
+
+using Policy = AudioEngineDefaultRoutePolicy;
+
+Policy::State DefaultVoiceProcessingDuplex() {
+  Policy::State state;
+  state.input_default = true;
+  state.output_default = true;
+  state.input_enabled = true;
+  state.output_enabled = true;
+  state.voice_processing_enabled = true;
+  return state;
+}
+
+TEST(AudioEngineDefaultRoutePolicyTest,
+     RepeatedDefaultUpdatesDoNotForceVoiceProcessingRebuilds) {
+  auto state = DefaultVoiceProcessingDuplex();
+  int forced_rebuilds = 0;
+
+  // Model separate and repeated input/output notifications for one handover.
+  for (int update = 0; update < 6; ++update) {
+    state.input_default_changed = update % 2 == 0;
+    state.output_default_changed = update % 2 == 1;
+    if (Policy::RequiresRecreate(state)) {
+      ++forced_rebuilds;
+    }
+  }
+
+  EXPECT_EQ(forced_rebuilds, 0);
+  state.input_default_changed = true;
+  state.output_default_changed = true;
+  EXPECT_FALSE(Policy::RequiresRecreate(state));
+}
+
+TEST(AudioEngineDefaultRoutePolicyTest, PinnedInputKeepsExplicitRebuild) {
+  auto state = DefaultVoiceProcessingDuplex();
+  state.input_default = false;
+  state.output_default_changed = true;
+
+  EXPECT_TRUE(Policy::RequiresRecreate(state));
+}
+
+TEST(AudioEngineDefaultRoutePolicyTest, PinnedOutputKeepsExplicitRebuild) {
+  auto state = DefaultVoiceProcessingDuplex();
+  state.output_default = false;
+  state.input_default_changed = true;
+
+  EXPECT_TRUE(Policy::RequiresRecreate(state));
+}
+
+TEST(AudioEngineDefaultRoutePolicyTest, NonVoiceProcessingKeepsExplicitRebuild) {
+  auto state = DefaultVoiceProcessingDuplex();
+  state.voice_processing_enabled = false;
+  state.output_default_changed = true;
+
+  EXPECT_TRUE(Policy::RequiresRecreate(state));
+}
+
+TEST(AudioEngineDefaultRoutePolicyTest, SingleDirectionGraphKeepsExplicitRebuild) {
+  auto state = DefaultVoiceProcessingDuplex();
+  state.input_enabled = false;
+  state.output_default_changed = true;
+  EXPECT_TRUE(Policy::RequiresRecreate(state));
+
+  state = DefaultVoiceProcessingDuplex();
+  state.output_enabled = false;
+  state.input_default_changed = true;
+  EXPECT_TRUE(Policy::RequiresRecreate(state));
+}
+
+TEST(AudioEngineDefaultRoutePolicyTest, NoDefaultChangeDoesNotForceRebuild) {
+  auto state = DefaultVoiceProcessingDuplex();
+  EXPECT_FALSE(Policy::RequiresRecreate(state));
+
+  state.input_default = false;
+  state.output_default = false;
+  EXPECT_FALSE(Policy::RequiresRecreate(state));
+}
+
+}  // namespace
+}  // namespace webrtc
