+  const auto after = owner.GetExperimentalCoreAudioDuplexState();
+  EXPECT_EQ(after.output_create_count, before.output_create_count);
+  EXPECT_EQ(after.output_start_count, before.output_start_count);
+  EXPECT_FALSE(after.output_data_ready); EXPECT_FALSE(after.output_running);
+  EXPECT_EQ(after.output_lifecycle, ExperimentalCoreAudioOutputAuthority::kPendingRaw);
+  EXPECT_EQ(owner.ExperimentalCoreAudioError(), 0);
+  // A fresh native demand does not make the previous false completion ready.
+  AudioDeviceMacDuplexTestPeer::Driver(owner).Demand(false, true);
+  EXPECT_EQ(AudioDeviceMacDuplexTestPeer::OutputCompletion(owner, false, 1), -20);
+  EXPECT_EQ(owner.RetireExperimentalCoreAudioOwner(), 0);
+}
