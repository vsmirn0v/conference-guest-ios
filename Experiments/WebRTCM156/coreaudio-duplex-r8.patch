+TEST(ExperimentalCoreAudioOutputNegotiationTest, OutputCompletionSupersessionIsStaleAfterSuccessOrInterruption) {
+  for (bool success : {false, true}) {
+    AudioDeviceMac owner(true, true); AudioDeviceMacDuplexTestPeer::Negotiate(owner);
+    auto& driver = AudioDeviceMacDuplexTestPeer::Driver(owner);
+    // Replay a track reassociation that changes only the sequence, keeping
+    // the exact muted/listening flags unchanged as in the observed failure.
+    ASSERT_NE(driver.Latch(Authority::kMuted | Authority::kSound, 2), 0u);
+    auto& raw = AudioDeviceMacDuplexTestPeer::Priming(owner);
+    raw.StartReturned(100); ASSERT_TRUE(raw.Observe(1, 2, 1024, 101));
+    const auto before = owner.GetExperimentalCoreAudioDuplexState();
+    ASSERT_NE(driver.Latch(Authority::kMuted | Authority::kSound, 3), 0u);
+    EXPECT_EQ(AudioDeviceMacDuplexTestPeer::OutputCompletion(owner, success, 2), -21);
+    const auto after = owner.GetExperimentalCoreAudioDuplexState();
+    EXPECT_EQ(after.output_lifecycle, before.output_lifecycle);
+    EXPECT_EQ(after.output_start_count, before.output_start_count);
+    EXPECT_EQ(after.output_create_count, before.output_create_count);
+    EXPECT_EQ(after.raw_output_callbacks, before.raw_output_callbacks);
+    EXPECT_EQ(after.output_start_return_nanos, before.output_start_return_nanos);
+    EXPECT_FALSE(after.output_data_ready); EXPECT_EQ(owner.ExperimentalCoreAudioError(), 0);
+    EXPECT_EQ(owner.RetireExperimentalCoreAudioOwner(), 0);
+  }
+}
