+int32_t AudioDeviceMacDuplex::OutputOnlyCompletion(bool success, uint64_t intent, uint64_t deadline) {
+  auto state_result = [&]() -> int32_t {
+    const uint64_t unsafe = owner_.experimental_unsafe_errors_.mask();
+    auto incomplete = [unsafe](const auto& io) {
+      const uint64_t required = io.required_proof.load(std::memory_order_acquire);
+      return required && !ExperimentalCoreAudioRetirementComplete(io.proof.load(std::memory_order_acquire), required, unsafe);
+    };
+    // A newer intent cannot erase an actual native failure or retirement debt.
+    if (unsafe || IsRetired() || incomplete(owner_.experimental_input_io_) || incomplete(owner_.experimental_output_io_)) return kAdmission;
+    const int32_t error = owner_.ExperimentalCoreAudioError();
+    if (error) return error == kDeadline ? kDeadline : kAdmission;
+    const uint64_t word = authority_.Read();
+    if (word & Authority::kTerminal) return kAdmission;
+    if (Now() >= deadline) return Error(kDeadline);
+    if (Authority::Intent(word) != intent) return kStale;
+    return 0;
+  };
+  if (const int32_t state = state_result()) return state;
+  if (!success && !OutputRequested()) {
+    // Native playout demand can close without an app-intent sequence change.
+    // Retire once; never retry a physical Start or reset the original deadline.
+    const bool stopped = StopOutput(deadline);
+    if (const int32_t state = state_result()) return state;
+    return stopped && !OutputRequested() ? 0 : kAdmission;
+  }
+  return success ? 0 : kAdmission;
+}
