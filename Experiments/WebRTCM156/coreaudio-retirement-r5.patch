+class ExperimentalCoreAudioUnsafeErrors {
+ public:
+  void Record(uint32_t origin) {
+    mask_.fetch_or(uint64_t{1} << origin, std::memory_order_acq_rel);
+    count_.fetch_add(1, std::memory_order_acq_rel);
+  }
+  uint64_t mask() const { return mask_.load(std::memory_order_acquire); }
+  uint64_t count() const { return count_.load(std::memory_order_acquire); }
+ private:
+  static_assert(std::atomic<uint64_t>::is_always_lock_free);
+  std::atomic<uint64_t> mask_{0}, count_{0};
+};
+// HAL may queue a callback beyond unregister. Cells are never reclaimed/reused.
+// A single atomic closes admission and counts admitted owner accesses.
+class ExperimentalCoreAudioCallbackCell {
+ public:
+  static constexpr uint64_t kClosed = uint64_t{1} << 63;
+  static constexpr uint64_t kPublished = uint64_t{1} << 62;
+  static constexpr uint64_t kCountMask = kPublished - 1;
+  void Prepare(void* owner) { owner_ = owner; }
+  bool Open() {
+    uint64_t expected = kClosed;
+    return state_.compare_exchange_strong(expected, kPublished, std::memory_order_release, std::memory_order_relaxed);
+  }
+  void Close() { state_.fetch_or(kClosed, std::memory_order_acq_rel); }
+  bool ClosedAndDrained() const {
+    const uint64_t state = state_.load(std::memory_order_acquire);
+    return (state & kClosed) && !(state & kCountMask);
+  }
+  class Lease {
+   public:
+    explicit Lease(ExperimentalCoreAudioCallbackCell* cell) : cell_(cell) {
+      uint64_t state = cell_->state_.load(std::memory_order_acquire);
+      while (!(state & kClosed) && (state & kCountMask) < kCountMask) {
+        if (cell_->state_.compare_exchange_weak(state, state + 1, std::memory_order_acq_rel)) {
+          owner_ = cell_->owner_; return;
+        }
+      }
+    }
+    ~Lease() { if (owner_) cell_->state_.fetch_sub(1, std::memory_order_release); }
+    Lease(const Lease&) = delete;
+    Lease& operator=(const Lease&) = delete;
+    void* owner() const { return owner_; }
+   private:
+    ExperimentalCoreAudioCallbackCell* cell_;
+    void* owner_ = nullptr;
+  };
+ private:
+  static_assert(std::atomic<uint64_t>::is_always_lock_free);
+  std::atomic<uint64_t> state_{kClosed};
+  void* owner_ = nullptr;  // Immutable before Open; read only after admission.
+};
+template <size_t Capacity>
+class ExperimentalCoreAudioCallbackPool {
+ public:
+  ExperimentalCoreAudioCallbackCell* Allocate(void* owner) {
+    if (!owner) return nullptr;
+    size_t next = used_.load(std::memory_order_acquire);
+    while (next < Capacity) {
+      if (used_.compare_exchange_weak(next, next + 1, std::memory_order_acq_rel)) {
+        cells_[next].Prepare(owner); return &cells_[next];
+      }
+    }
+    return nullptr;
+  }
+  size_t used() const { return used_.load(std::memory_order_acquire); }
+ private:
+  std::array<ExperimentalCoreAudioCallbackCell, Capacity> cells_;
+  std::atomic<size_t> used_{0};
+};
+inline ExperimentalCoreAudioCallbackPool<1024>& ExperimentalCoreAudioCallbackCells() {
+  // Static storage with no destructor: HAL tombstones also survive exit teardown.
+  using Pool = ExperimentalCoreAudioCallbackPool<1024>;
+  alignas(Pool) static std::byte storage[sizeof(Pool)];
+  static Pool* cells = new (storage) Pool;
+  return *cells;
+}
