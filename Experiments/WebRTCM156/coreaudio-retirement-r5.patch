+template <typename Owner, size_t Capacity>
+class ExperimentalCoreAudioOwnerAnchorPool {
+ public:
+  bool Retain(const Owner& owner) {
+    if (!owner) return false;
+    std::lock_guard<std::mutex> lock(mutex_);
+    for (auto& slot : owners_) if (!slot) { slot = owner; return true; }
+    return false;
+  }
+  bool ReleaseConfirmed(const Owner& owner, bool confirmed) {
+    if (!confirmed) return false;
+    Owner retired;
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      for (auto& slot : owners_) if (slot.get() == owner.get()) { retired = std::move(slot); break; }
+    }
+    return bool(retired);  // Release the anchor outside its mutex.
+  }
+ private:
+  std::mutex mutex_;
+  std::array<Owner, Capacity> owners_;
+};
+inline bool ExperimentalCoreAudioRetirementComplete(uint64_t observed, uint64_t required, uint64_t unsafe) {
+  return unsafe == 0 && (observed & required) == required;
+}
+inline bool ExperimentalCoreAudioNativeStopComplete(bool started, int32_t stopped, int32_t destroyed) {
+  return (!started || stopped == 0) && destroyed == 0;
