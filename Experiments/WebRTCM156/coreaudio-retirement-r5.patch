+TEST(ExperimentalCoreAudioRetirementTest, ClosedCellRejectsQueuedCallbackAfterOwnerRelease) {
+  ExperimentalCoreAudioCallbackPool<2> pool;
+  auto owner = std::make_unique<int>(31);
+  auto* old = pool.Allocate(owner.get()); ASSERT_NE(old, nullptr); old->Open();
+  std::atomic<bool> entered{false}, release{false};
+  std::thread callback([&] {
+    ExperimentalCoreAudioCallbackCell::Lease lease(old);
+    EXPECT_EQ(lease.owner(), owner.get());
+    entered.store(true, std::memory_order_release);
+    while (!release.load(std::memory_order_acquire)) std::this_thread::yield();
+    EXPECT_EQ(*static_cast<int*>(lease.owner()), 31);
+  });
+  while (!entered.load(std::memory_order_acquire)) std::this_thread::yield();
+  old->Close();
+  EXPECT_FALSE(old->ClosedAndDrained());
+  { ExperimentalCoreAudioCallbackCell::Lease late(old); EXPECT_EQ(late.owner(), nullptr); }
+  release.store(true, std::memory_order_release); callback.join();
+  ASSERT_TRUE(old->ClosedAndDrained()); owner.reset();
+  int replacement = 42;
+  auto* fresh = pool.Allocate(&replacement); ASSERT_NE(fresh, nullptr); fresh->Open();
+  { ExperimentalCoreAudioCallbackCell::Lease late(old); EXPECT_EQ(late.owner(), nullptr); }
+  { ExperimentalCoreAudioCallbackCell::Lease current(fresh); EXPECT_EQ(current.owner(), &replacement); }
+  fresh->Close(); EXPECT_TRUE(fresh->ClosedAndDrained());
+}
