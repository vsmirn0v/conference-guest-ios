+  auto& io = input ? experimental_input_io_ : experimental_output_io_;
+  auto& worker = input ? capture_worker_thread_ : render_worker_thread_;
+  auto& owned_converter = input ? experimental_capture_converter_owned_ : experimental_render_converter_owned_;
+  auto& converter = input ? _captureConverter : _renderConverter;
+  uint64_t required = kWorkerJoined | kConverterDisposed | kListenersRemoved;
+  if (io.cell) required |= kCellClosed | kCellDrained;
+  if (io.created) required |= kDestroyed;
+  if (io.started) required |= kStopSucceeded;
+  io.required_proof.fetch_or(required, std::memory_order_release);
+  // Control calls are worker-serialized; never wait, join or call HAL under mutex_.
+  if (io.created && io.started && !(io.proof.load(std::memory_order_acquire) & kCellClosed)) {
+    {
+      MutexLock lock(&mutex_);
+      if (input) { _recording = false; _doStopRec = true; }
+      else { _playing = false; _doStop = true; }
+    }
+    const bool signaled = input ? _stopEventRec.Wait(TimeDelta::Seconds(2)) : _stopEvent.Wait(TimeDelta::Seconds(2));
+    const bool acknowledged = io.ack_serial.load(std::memory_order_acquire) == io.serial;
+    if (!signaled || !acknowledged) {
+      RecordExperimentalCoreAudioError(-7, input ? ErrorOrigin::kCaptureStopTimeout : ErrorOrigin::kRenderStopTimeout, __LINE__);
+      // No concurrent fallback destroy: the original callback may still be in HAL.
+    }
+  } else if (io.created && !io.started && !(io.proof.load(std::memory_order_acquire) & kDestroyed)) {
+    const OSStatus status = AudioDeviceDestroyIOProcID(io.device, io.proc);
+    io.destroy_status.store(status, std::memory_order_release);
+    if (status != noErr) RecordExperimentalCoreAudioError(status, ErrorOrigin::kHALCall, __LINE__);
+    else io.proof.fetch_or(kDestroyed, std::memory_order_release);
+  }
+  if (io.cell) {
+    io.cell->Close(); io.proof.fetch_or(kCellClosed, std::memory_order_release);
+    if (!DrainCallbackCell(io.cell)) return -1;
+    io.proof.fetch_or(kCellDrained, std::memory_order_release);
+  }
+  if (input) _captureDeviceIsAlive = 0; else _renderDeviceIsAlive = 0;
+  if (!worker.empty()) {
+    const kern_return_t wake = semaphore_signal_all(input ? _captureSemaphore : _renderSemaphore);
+    if (wake != KERN_SUCCESS) RecordExperimentalCoreAudioError(wake, ErrorOrigin::kResourceProof, __LINE__);
+    worker.Finalize();
+  }
+  io.proof.fetch_or(kWorkerJoined, std::memory_order_release);
+  if (io.created) {
+    if (!ExperimentalCoreAudioNativeStopComplete(io.started, io.stop_status.load(std::memory_order_acquire),
+        io.destroy_status.load(std::memory_order_acquire))) {
+      RecordExperimentalCoreAudioError(-10, ErrorOrigin::kResourceProof, __LINE__); return -1;
+    }
+    io.created = false; io.started = false; io.proc = nullptr;
+    if (input) _inDeviceIOProcID = nullptr; else _deviceIOProcID = nullptr;
+  }
+  if (experimental_unsafe_errors_.mask()) return -1;
+  const auto scope = input ? kAudioDevicePropertyScopeInput : kAudioDevicePropertyScopeOutput;
+  for (auto& entry : experimental_listeners_) {
+    if (!entry.registered || entry.object == kAudioObjectSystemObject || entry.address.mScope != scope) continue;
+    const OSStatus status = RemoveDeviceListener(entry.object, &entry.address);
+    if (status != noErr) RecordExperimentalCoreAudioError(status, ErrorOrigin::kHALCall, __LINE__);
+  }
+  if (experimental_unsafe_errors_.mask()) return -1;
+  io.proof.fetch_or(kListenersRemoved, std::memory_order_release);
+  if (owned_converter) {
+    const OSStatus status = AudioConverterDispose(converter);
+    if (status != noErr) { RecordExperimentalCoreAudioError(status, ErrorOrigin::kHALCall, __LINE__); return -1; }
+    owned_converter = false; converter = nullptr;
+  }
+  io.proof.fetch_or(kConverterDisposed, std::memory_order_release);
+  if (!ExperimentalCoreAudioRetirementComplete(io.proof.load(std::memory_order_acquire),
+      io.required_proof.load(std::memory_order_acquire), experimental_unsafe_errors_.mask())) {
+    RecordExperimentalCoreAudioError(-10, ErrorOrigin::kResourceProof, __LINE__); return -1;
+  }
+  if (input) { _captureBuffer.Clear(); if (experimental_capture_buffer_) experimental_capture_buffer_->ClearWhenIdle(); }
+  else _renderBuffer.Clear();
+  io.proof.fetch_or(kDirectionClean, std::memory_order_release);
+  if (input) { _recIsInitialized = false; _recording = false; _doStopRec = false; }
+  else { _playIsInitialized = false; _playing = false; _doStop = false; }
+  return 0;
+}
+int32_t AudioDeviceMac::RetireExperimentalCoreAudioOwner() {
+  if (!experimental_ownership_) return -1;
+  if (experimental_retirement_confirmed_.load(std::memory_order_acquire)) return 0;
+  experimental_retirement_requested_.store(true, std::memory_order_release);
+  if (_ptrAudioBuffer) _ptrAudioBuffer->SetExperimentalCoreAudioCaptureMuted(true);
+  const int32_t input = StopExperimentalDirection(true), output = StopExperimentalDirection(false);
+  for (auto& entry : experimental_listeners_) if (entry.cell && !entry.registered) DrainCallbackCell(entry.cell);
+  if (input || output || experimental_unsafe_errors_.mask()) return -1;
+  for (auto& entry : experimental_listeners_) {
+    if (!entry.registered) continue;
+    const OSStatus status = RemoveDeviceListener(entry.object, &entry.address);
+    if (status != noErr) RecordExperimentalCoreAudioError(status, ErrorOrigin::kHALCall, __LINE__);
+  }
+  if (experimental_unsafe_errors_.mask()) return -1;
+  _mixerManager.Close();
+  const OSStatus unloaded = _initialized ? AudioHardwareUnload() : noErr;
+  if (unloaded != noErr) { RecordExperimentalCoreAudioError(unloaded, ErrorOrigin::kHALCall, __LINE__); return -1; }
+  if (experimental_capture_semaphore_owned_) {
+    const kern_return_t status = semaphore_destroy(mach_task_self(), _captureSemaphore);
+    if (status != KERN_SUCCESS) { RecordExperimentalCoreAudioError(status, ErrorOrigin::kResourceProof, __LINE__); return -1; }
+    experimental_capture_semaphore_owned_ = false;
+  }
+  if (experimental_render_semaphore_owned_) {
+    const kern_return_t status = semaphore_destroy(mach_task_self(), _renderSemaphore);
+    if (status != KERN_SUCCESS) { RecordExperimentalCoreAudioError(status, ErrorOrigin::kResourceProof, __LINE__); return -1; }
+    experimental_render_semaphore_owned_ = false;
+  }
+  _initialized = false; _isShutDown = true;
+  _outputDeviceIsSpecified = false; _inputDeviceIsSpecified = false;
+  experimental_retirement_confirmed_.store(true, std::memory_order_release);
+  return 0;
+}
+OSStatus AudioDeviceMac::guardedObjectListenerProc(AudioObjectID object, UInt32 count,
+    const AudioObjectPropertyAddress addresses[], void* context) {
+  ExperimentalCoreAudioCallbackCell::Lease lease(static_cast<ExperimentalCoreAudioCallbackCell*>(context));
+  auto* owner = static_cast<AudioDeviceMac*>(lease.owner());
+  return owner ? owner->implObjectListenerProc(object, count, addresses) : noErr;
+}
+OSStatus AudioDeviceMac::guardedDeviceIOProc(AudioDeviceID, const AudioTimeStamp*,
+    const AudioBufferList* input, const AudioTimeStamp* input_time, AudioBufferList* output,
+    const AudioTimeStamp* output_time, void* context) {
+  ExperimentalCoreAudioCallbackCell::Lease lease(static_cast<ExperimentalCoreAudioCallbackCell*>(context));
+  if (auto* owner = static_cast<AudioDeviceMac*>(lease.owner())) {
+    owner->implDeviceIOProc(input, input_time, output, output_time);
+  } else if (output) {
+    for (UInt32 index = 0; index < output->mNumberBuffers; ++index) {
+      auto& buffer = output->mBuffers[index];
+      if (buffer.mData) memset(buffer.mData, 0, buffer.mDataByteSize);
+    }
+  }
+  return noErr;
+}
+OSStatus AudioDeviceMac::guardedInputIOProc(AudioDeviceID, const AudioTimeStamp*,
+    const AudioBufferList* input, const AudioTimeStamp* input_time, AudioBufferList*,
+    const AudioTimeStamp*, void* context) {
+  ExperimentalCoreAudioCallbackCell::Lease lease(static_cast<ExperimentalCoreAudioCallbackCell*>(context));
+  if (auto* owner = static_cast<AudioDeviceMac*>(lease.owner())) owner->implInDeviceIOProc(input, input_time);
+  return noErr;
+}
