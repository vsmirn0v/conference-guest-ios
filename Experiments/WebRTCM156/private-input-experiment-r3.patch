+TEST(PrivateInputMeterTest, PrivateMonoContractUsesBothNegotiatedEndpoints) {
+  using F=mac_adm::PrivateInputPcmFormat; using C=mac_adm::PrivateInputFormatContract;
+  const F native{44100,3,true,false}, requested{44100,1,true,false};
+  C c; ASSERT_TRUE(c.Configure(requested));
+  EXPECT_FALSE(c.MatchesRequested(native,requested));
+  EXPECT_FALSE(c.MatchesRequested(requested,native));
+  EXPECT_TRUE(c.MatchesRequested(requested,requested));
+  EXPECT_FALSE(c.MatchesAdopted(requested,requested));
+  EXPECT_TRUE(c.AdoptAfterStartup(requested,requested,C::kAllStartupProofs));
+  EXPECT_TRUE(c.MatchesAdopted(requested,requested));
+}
+TEST(PrivateInputMeterTest, PrivateMonoContractRejectsEveryEndpointMismatch) {
+  using F=mac_adm::PrivateInputPcmFormat; using C=mac_adm::PrivateInputFormatContract;
+  const F requested{44100,1,true,false}; C c; ASSERT_TRUE(c.Configure(requested));
+  for (const F wrong: {F{48000,1,true,false},F{44100,3,true,false},F{44100,1,false,false},F{44100,1,true,true}}) {
+    EXPECT_FALSE(c.MatchesRequested(wrong,requested)); EXPECT_FALSE(c.MatchesRequested(requested,wrong));
+    EXPECT_FALSE(c.AdoptAfterStartup(wrong,requested,C::kAllStartupProofs));
+    EXPECT_FALSE(c.AdoptAfterStartup(requested,wrong,C::kAllStartupProofs));
+  }
+  for (const F wrong: {F{0,1,true,false},F{44100,3,true,false},F{44100,1,false,false}}) {
+    C invalid; EXPECT_FALSE(invalid.Configure(wrong));
+  }
+}
+TEST(PrivateInputMeterTest, PrivateFormatCannotBeAdoptedWithAnyFailedStartupProof) {
+  using F=mac_adm::PrivateInputPcmFormat; using C=mac_adm::PrivateInputFormatContract;
+  const F requested{44100,1,true,false};
+  for (size_t bit=0;bit<C::kStartupProofCount;++bit) {
+    C c; ASSERT_TRUE(c.Configure(requested));
+    EXPECT_FALSE(c.AdoptAfterStartup(requested,requested,C::kAllStartupProofs & ~(uint64_t(1)<<bit)));
+    EXPECT_FALSE(c.MatchesAdopted(requested,requested));
+  }
+}
+TEST(PrivateInputMeterTest, PrivateAdoptedFormatRejectsDriftAndCannotBeRebased) {
+  using F=mac_adm::PrivateInputPcmFormat; using C=mac_adm::PrivateInputFormatContract;
+  const F requested{44100,1,true,false}, changed{48000,1,true,false}; C c;
+  ASSERT_TRUE(c.Configure(requested)); ASSERT_TRUE(c.AdoptAfterStartup(requested,requested,C::kAllStartupProofs));
+  EXPECT_FALSE(c.MatchesAdopted(changed,requested)); EXPECT_FALSE(c.MatchesAdopted(requested,changed));
+  EXPECT_FALSE(c.Configure(changed)); EXPECT_FALSE(c.AdoptAfterStartup(changed,changed,C::kAllStartupProofs));
+  EXPECT_TRUE(c.MatchesAdopted(requested,requested));
