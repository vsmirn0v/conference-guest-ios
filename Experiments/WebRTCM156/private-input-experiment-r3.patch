 #include <time.h>
 
 namespace webrtc::mac_adm {
+// This contract is private-meter-only. The pre-start native bus may expose
+// multiple hardware channels; admission uses the exact requested mono format
+// actually negotiated on both connected endpoints, after every startup proof.
+struct PrivateInputPcmFormat {
+  double sample_rate=0;
+  uint32_t channels=0;
+  bool float32=false, interleaved=false;
+  bool operator==(const PrivateInputPcmFormat&) const = default;
+};
+class PrivateInputFormatContract {
+ public:
+  static constexpr size_t kStartupProofCount=13;
+  static constexpr uint64_t kAllStartupProofs=(uint64_t(1)<<kStartupProofCount)-1;
+  bool Configure(PrivateInputPcmFormat requested) {
+    if (configured_ || !std::isfinite(requested.sample_rate) || requested.sample_rate<=0 ||
+        requested.channels!=1 || !requested.float32) return false;
+    requested_=requested; configured_=true; return true;
+  }
+  bool MatchesRequested(PrivateInputPcmFormat input, PrivateInputPcmFormat sink) const {
+    return configured_ && input==requested_ && sink==requested_;
+  }
+  bool AdoptAfterStartup(PrivateInputPcmFormat input, PrivateInputPcmFormat sink, uint64_t proofs) {
+    if (adopted_ || proofs!=kAllStartupProofs || !MatchesRequested(input,sink)) return false;
+    actual_=input; adopted_=true; return true;
+  }
+  bool MatchesAdopted(PrivateInputPcmFormat input, PrivateInputPcmFormat sink) const {
+    return adopted_ && input==actual_ && MatchesRequested(input,sink);
+  }
+ private:
+  PrivateInputPcmFormat requested_,actual_;
+  bool configured_=false,adopted_=false;
+};
+
 class PrivateInputGraphSeal {
  public:
   void Seal() { private_.store(true, std::memory_order_release); }
