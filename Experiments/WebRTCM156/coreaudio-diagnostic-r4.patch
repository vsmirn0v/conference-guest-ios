+struct FirstErrorTestContext { uint64_t generation = 0; uint32_t origin = 0; };
+TEST(ExperimentalCoreAudioFirstErrorTest, FirstWriterRetainsErrorAndContext) {
+  ExperimentalCoreAudioFirstError<FirstErrorTestContext> error;
+  EXPECT_EQ(error.Read().error, 0);
+  EXPECT_FALSE(error.Read().metadata_ready);
+  bool ignored_factory_called = false;
+  error.Record(0, [&] { ignored_factory_called = true; return FirstErrorTestContext{}; });
+  EXPECT_FALSE(ignored_factory_called);
+  error.Record(-6, [] { return FirstErrorTestContext{41, 10}; });
+  error.Record(-5, [&] { ignored_factory_called = true; return FirstErrorTestContext{42, 12}; });
+  const auto first = error.Read();
+  EXPECT_EQ(first.error, -6);
+  EXPECT_TRUE(first.metadata_ready);
+  EXPECT_EQ(first.context.generation, 41u);
+  EXPECT_EQ(first.context.origin, 10u);
+  EXPECT_FALSE(ignored_factory_called);
+}
+TEST(ExperimentalCoreAudioFirstErrorTest, PendingMetadataNeverReadsUnpublishedContext) {
+  ExperimentalCoreAudioFirstError<FirstErrorTestContext> error;
+  std::atomic<bool> entered{false}, release{false};
+  std::thread winner([&] {
+    error.Record(-6, [&] {
+      entered.store(true, std::memory_order_release);
+      while (!release.load(std::memory_order_acquire)) std::this_thread::yield();
+      return FirstErrorTestContext{99, 10};
+    });
+  });
+  while (!entered.load(std::memory_order_acquire)) std::this_thread::yield();
+  const auto pending = error.Read();
+  EXPECT_EQ(pending.error, -6);
+  EXPECT_FALSE(pending.metadata_ready);
+  EXPECT_EQ(pending.context.generation, 0u);
+  error.Record(-5, [] { return FirstErrorTestContext{100, 12}; });
+  release.store(true, std::memory_order_release);
+  winner.join();
+  const auto published = error.Read();
+  EXPECT_EQ(published.error, -6);
+  EXPECT_TRUE(published.metadata_ready);
+  EXPECT_EQ(published.context.generation, 99u);
+  EXPECT_EQ(published.context.origin, 10u);
+}
 
