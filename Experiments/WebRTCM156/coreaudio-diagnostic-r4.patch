 namespace webrtc {
+// The original sticky error CAS remains the first publication. Only its winner
+// writes immutable metadata; readers never inspect it before release/acquire.
+// A reader may observe the error before its metadata is ready and reports that.
+template <typename Context>
+class ExperimentalCoreAudioFirstError {
+ public:
+  struct Snapshot { int32_t error = 0; bool metadata_ready = false; Context context{}; };
+  template <typename MakeContext>
+  void Record(int32_t error, MakeContext make_context) {
+    int32_t expected = 0;
+    if (error && error_.compare_exchange_strong(expected, error, std::memory_order_acq_rel)) {
+      context_ = make_context();
+      ready_.store(true, std::memory_order_release);
+    }
+  }
+  int32_t error() const { return error_.load(std::memory_order_acquire); }
+  Snapshot Read() const {
+    Snapshot result;
+    result.metadata_ready = ready_.load(std::memory_order_acquire);
+    result.error = error();
+    if (result.metadata_ready) result.context = context_;
+    return result;
+  }
+ private:
+  static_assert(std::atomic<int32_t>::is_always_lock_free);
+  static_assert(std::atomic<bool>::is_always_lock_free);
+  std::atomic<int32_t> error_{0};
+  std::atomic<bool> ready_{false};
+  Context context_{};
+};
 // Opt-in only. Payload and both privacy epochs share one SPSC publication.
 // All storage is allocated before capture starts. Producer and consumer each
 // exclusively own their scratch vector; neither may reset an active ring.
