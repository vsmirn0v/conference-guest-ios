+namespace {
+std::shared_ptr<PreparedInputGraph> BuildGraphResources(std::shared_ptr<PreparedInputGraph> graph,
+    const AudioEngineDevice::EngineState& profile, uintptr_t worker_identity, int64_t deadline_ms) {
+  if ([NSThread isMainThread] || worker_identity == reinterpret_cast<uintptr_t>(Thread::Current()) || TimeMillis() >= deadline_ms) return graph;
+  const int64_t build_begin_ms = TimeMillis();
+  LOGI() << "Bridge build begin id=" << graph->graph_id;
+  @try {
+    graph->engine = [[AVAudioEngine alloc] init];
+    LOGI() << "Bridge build engine allocated id=" << graph->graph_id << " elapsedMs=" << TimeMillis() - build_begin_ms;
+    graph->input = graph->engine.inputNode;
+    LOGI() << "Bridge build input obtained id=" << graph->graph_id << " elapsedMs=" << TimeMillis() - build_begin_ms;
+    NSError* error = nil;
+    if (![graph->input setVoiceProcessingEnabled:YES error:&error]) { LOGW() << "Bridge VPIO enable failed: " << error.localizedDescription.UTF8String; return graph; }
+    LOGI() << "Bridge build voice processing enabled id=" << graph->graph_id << " elapsedMs=" << TimeMillis() - build_begin_ms;
+    graph->output = graph->engine.outputNode; graph->input.voiceProcessingBypassed = NO;
+    graph->input.voiceProcessingAGCEnabled = profile.voice_processing_agc_enabled;
+    graph->input.voiceProcessingInputMuted = NO;  // Normal InputMixer mode; callback gate discards staged input.
+    if (@available(macOS 14.0, *)) {
+      auto bridge = graph->bridge;
+      [graph->input setMutedSpeechActivityEventListener:^(AVAudioVoiceProcessingSpeechActivityEvent event) { bridge->Speech(event == AVAudioVoiceProcessingSpeechActivityStarted ? AudioDeviceModule::SpeechActivityEvent::kStarted : AudioDeviceModule::SpeechActivityEvent::kEnded); }];
+    }
+    if (@available(macOS 14.0, *)) { AVAudioVoiceProcessingOtherAudioDuckingConfiguration duck;
+      duck.enableAdvancedDucking = profile.advanced_ducking; duck.duckingLevel = ToAVDuckingLevel(profile.ducking_level);
+      graph->input.voiceProcessingOtherAudioDuckingConfiguration = duck; }
+    AVAudioFormat* in = [graph->input outputFormatForBus:0]; AVAudioFormat* out = [graph->output outputFormatForBus:0];
+    if (!in.sampleRate || !out.sampleRate || !in.channelCount || !out.channelCount || in.commonFormat != AVAudioPCMFormatFloat32 || out.commonFormat != AVAudioPCMFormatFloat32) {
+      LOGW() << "Bridge unsupported node formats in=" << in.description.UTF8String << " out=" << out.description.UTF8String; return graph;
+    }
+    graph->input_format = [[AVAudioFormat alloc] initWithCommonFormat:in.commonFormat sampleRate:in.sampleRate channels:1 interleaved:in.interleaved];
+    graph->output_format = [[AVAudioFormat alloc] initWithCommonFormat:out.commonFormat sampleRate:out.sampleRate channels:1 interleaved:out.interleaved];
+    AVAudioFormat* rtc_out = [[AVAudioFormat alloc] initWithCommonFormat:AVAudioPCMFormatInt16 sampleRate:out.sampleRate channels:1 interleaved:YES];
+    AVAudioFormat* rtc_in = [[AVAudioFormat alloc] initWithCommonFormat:AVAudioPCMFormatInt16 sampleRate:in.sampleRate channels:1 interleaved:YES];
+    OSStatus converter_status = AudioConverterNew(graph->input_format.streamDescription, rtc_in.streamDescription, &graph->converter);
+    if (converter_status != noErr) { LOGW() << "Bridge converter creation failed=" << converter_status; return graph; }
+    graph->record_buffer = [[AVAudioPCMBuffer alloc] initWithPCMFormat:rtc_in frameCapacity:kMaximumFramesPerBuffer];
+    graph->source = BridgeSource(rtc_out, graph->bridge); graph->mixer = [[AVAudioMixerNode alloc] init]; graph->sink = BridgeSink(graph->bridge);
+    [graph->engine attachNode:graph->source]; [graph->engine attachNode:graph->mixer]; [graph->engine attachNode:graph->sink];
+    [graph->engine connect:graph->source to:graph->engine.mainMixerNode format:graph->output_format];
+    [graph->engine connect:graph->engine.mainMixerNode to:graph->output format:graph->output_format];
+    [graph->engine connect:graph->input to:graph->mixer format:graph->input_format];
+    [graph->engine connect:graph->mixer to:graph->sink format:graph->input_format]; graph->mixer.outputVolume = 0;
+    graph->built = true; LOGI() << "Bridge build end id=" << graph->graph_id;
+  } @catch (NSException* exception) { LOGW() << "Bridge build exception: " << exception.reason.UTF8String; }
+  return graph;
+}
+bool StoppedGraphIsQuiescent(const std::shared_ptr<PreparedInputGraph>& graph, bool log_proof = false) {
+  @try {
+    const bool engine_running = graph->engine.running;
+    bool clean = graph->engine && !engine_running && graph->bridge->gate.IsClosed() && graph->bridge->gate.Drained() && !graph->bridge->ever_opened &&
+        !graph->bridge->target.load() && !graph->bridge->silent_renders.load() && !graph->bridge->discarded_inputs.load() &&
+        !graph->bridge->active_renders.load() && !graph->bridge->active_records.load();
+    std::array<AudioUnit, 2> units{graph->input.audioUnit, graph->output.audioUnit};
+    std::array<UInt32, 2> running{0, 0};
+    std::array<OSStatus, 2> status{kAudioUnitErr_Uninitialized, kAudioUnitErr_Uninitialized};
+    for (int i = 0; i != 2; ++i) {
+      UInt32 size = sizeof(running[i]);
+      if (units[i]) status[i] = AudioUnitGetProperty(units[i], kAudioOutputUnitProperty_IsRunning, kAudioUnitScope_Global, 0, &running[i], &size);
+      clean = (status[i] == kAudioUnitErr_Uninitialized || (status[i] == noErr && running[i] == 0)) && clean;
+    }
+    if (log_proof || !clean) LOGI() << "Bridge stopped proof graph=" << graph->graph_id << " clean=" << clean << " engineRunning=" << engine_running
+        << " inputRunning=" << running[0] << " outputRunning=" << running[1] << " status=" << status[0] << "/" << status[1]
+        << " callbacks=" << graph->bridge->silent_renders.load() << "/" << graph->bridge->discarded_inputs.load()
+        << " active=" << graph->bridge->active_renders.load() << "/" << graph->bridge->active_records.load();
+    return clean;
+  } @catch (NSException*) { return false; }
+}
+bool PreparedFormatsMatch(const std::shared_ptr<PreparedInputGraph>& graph) {
+  @try { return [graph->input_bus_format isEqual:[graph->input outputFormatForBus:0]] &&
+      [graph->output_bus_format isEqual:[graph->output outputFormatForBus:0]]; }
+  @catch (NSException*) { return false; }
+}
