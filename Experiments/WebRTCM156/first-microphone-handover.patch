+struct PreparedInputGraph {
+  InputRequest request;
+  AudioEngineDevice::StoppedInputPreparationRequest warm_request;
+  uint64_t graph_id = 0;
+  InputRequest::Route prepared_route;
+  __strong AVAudioEngine* engine = nil;
+  __strong AVAudioInputNode* input = nil;
+  __strong AVAudioOutputNode* output = nil;
+  __strong AVAudioSourceNode* source = nil;
+  __strong AVAudioMixerNode* mixer = nil;
+  __strong AVAudioSinkNode* sink = nil;
+  __strong AVAudioFormat* input_format = nil;
+  __strong AVAudioFormat* output_format = nil;
+  __strong AVAudioFormat* input_bus_format = nil;
+  __strong AVAudioFormat* output_bus_format = nil;
+  __strong AVAudioPCMBuffer* record_buffer = nil;
+  AudioConverterRef converter = nullptr;
+  std::unique_ptr<FineAudioBuffer> retired_fine;
+  std::shared_ptr<AudioGraphCallbackBridge> bridge = std::make_shared<AudioGraphCallbackBridge>();
+  std::shared_ptr<PreparedInputGraph> old;
+  bool built = false, staged = false, started = false, adopted = false, stop_confirmed = false;
+  bool cleanup_confirmed = true, swap_started = false, recovery_requested = false;
+  bool warm_prepared = false, from_cache = false;
+  uint64_t recovery_generation = 0, active_renders_at_close = 0;
+  AudioEngineDevice::EngineState recovery_state;
+  bool Stop() {
+    if (stop_confirmed || !engine) return cleanup_confirmed;
+    bridge->gate.Close();
+    if (!Drain(bridge->gate)) { cleanup_confirmed = false; return false; }
+    stop_confirmed = StopGraphUnits(engine, input, output);
+    cleanup_confirmed = cleanup_confirmed && stop_confirmed; return cleanup_confirmed;
+  }
+  bool Dispose() {
+    if (adopted) {
+      if (old) {
+        bool clean = old->Dispose();
+        const uint64_t after = old->bridge->active_renders.load(std::memory_order_relaxed);
+        LOGI() << "Bridge old graph retired renders=" << old->active_renders_at_close << "/" << after << " clean=" << clean;
+        clean = clean && after == old->active_renders_at_close;
+        if (clean) old.reset(); return clean;
+      }
+      return true;
+    }
+    bool clean = Stop();
+    if (old) clean = old->Dispose() && clean;
+    if (!clean) {
+      auto* retained = new PreparedInputGraph;
+      retained->engine = engine; retained->input = input; retained->output = output;
+      retained->source = source; retained->mixer = mixer; retained->sink = sink;
+      retained->record_buffer = record_buffer; retained->converter = converter;
+      retained->bridge = bridge; retained->retired_fine = std::move(retired_fine); retained->old = std::move(old);
+      LOGE() << "Bridge cleanupUnconfirmed; graph resources retained until process exit";
+    } else if (converter) { AudioConverterDispose(converter); }
+    converter = nullptr; engine = nil; input = nil; output = nil; source = nil; mixer = nil; sink = nil;
+    record_buffer = nil; input_format = nil; output_format = nil; retired_fine.reset(); old.reset();
+    cleanup_confirmed = clean; return clean;
+  }
+  ~PreparedInputGraph() { if (!adopted) Dispose(); }
+};
