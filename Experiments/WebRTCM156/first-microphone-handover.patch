+bool AudioEngineDevice::RemoveBridgeConfigurationObserver() {
+  RTC_DCHECK_RUN_ON(thread_);
+  ++configuration_epoch_;  // Invalidate queued notifications before any owner teardown.
+  if (active_bridge_) {
+    active_bridge_->notification_gate.Close();
+    if (!Drain(active_bridge_->notification_gate)) {
+      cleanup_unconfirmed_ = true; this->AddRef(); return false;
+    }
+  }
+  @try {
+    if (configuration_observer_) {
+      [[NSNotificationCenter defaultCenter] removeObserver:(__bridge_transfer id)configuration_observer_ name:AVAudioEngineConfigurationChangeNotification object:nil];
+      configuration_observer_ = nullptr;
+    }
+  } @catch (NSException*) { cleanup_unconfirmed_ = true; this->AddRef(); return false; }
+  return true;
+}
+bool AudioEngineDevice::InstallBridgeConfigurationObserver() {
+  RTC_DCHECK_RUN_ON(thread_);
+  RTC_DCHECK(active_bridge_ && !configuration_observer_);
+  const std::weak_ptr<AudioGraphCallbackBridge> observed_bridge = active_bridge_;
+  const uintptr_t engine_identity = reinterpret_cast<uintptr_t>((__bridge void*)engine_device_);
+  const uint64_t registration = ++configuration_epoch_;
+  if (!active_bridge_->notification_gate.Open()) return false;
+  configuration_observer_ = (__bridge_retained void*)[[NSNotificationCenter defaultCenter]
+      addObserverForName:AVAudioEngineConfigurationChangeNotification object:engine_device_ queue:nil usingBlock:^(NSNotification*) {
+        // Separate from render admission: registration remains observable while rendering is closed.
+        auto bridge = observed_bridge.lock();
+        if (!bridge || !bridge->notification_gate.TryEnter()) return;
+        ReconfigureBridgeEngine(observed_bridge, engine_identity, registration);
+        bridge->notification_gate.Leave();
+      }];
+  return configuration_observer_ != nullptr;
+}
+void AudioEngineDevice::ReconfigureBridgeEngine(std::weak_ptr<AudioGraphCallbackBridge> expected_bridge,
+                                               uintptr_t engine_identity, uint64_t registration) {
+  // Called only while the notification-posting fence holds this owner's lifetime.
+  thread_->PostTask(SafeTask(safety_, [this, expected_bridge, engine_identity, registration] {
+    RTC_DCHECK_RUN_ON(thread_);
+    auto bridge = expected_bridge.lock();
+    if (!initialized_ || cleanup_unconfirmed_ || !bridge || active_bridge_ != bridge ||
+        configuration_epoch_ != registration || !engine_device_ ||
+        engine_identity != reinterpret_cast<uintptr_t>((__bridge void*)engine_device_) ||
+        engine_state_.render_mode != RenderMode::Device || !engine_state_.IsAnyRunning() || engine_device_.running) return;
+    // This is the qualified recovery task itself; never post an unqualified second task.
+    mac_adm::ScopedApplicationInputMuteReconfiguration preserve_application_mute;
+    EngineState current = engine_state_, shutdown = current;
+    shutdown.input_enabled = false; shutdown.input_running = false;
+    shutdown.output_enabled = false; shutdown.output_running = false;
+    int32_t result = ModifyEngineState([shutdown](EngineState) { return shutdown; });
+    if (result == 0) result = ModifyEngineState([current](EngineState) { return current; });
+    LOGW() << "Bridge qualified configuration recovery result=" << result;
+  }));
+}
+
+bool AudioEngineDevice::CloseActiveBridge() {
+  RTC_DCHECK_RUN_ON(thread_);
+  if (!active_bridge_) return true;
+  active_bridge_->gate.Close();
+  if (Drain(active_bridge_->gate)) return true;
+  active_bridge_->gate.ResumeUnchanged(); return false;
+}
+bool AudioEngineDevice::BindActiveBridge(bool first_running_candidate) {
+  RTC_DCHECK_RUN_ON(thread_);
+  if (!active_bridge_ || !active_bridge_->gate.IsClosed() || !active_bridge_->gate.Drained()) return false;
+  // Ordinary rebinds require a stopped AV graph. The sole exception is first publication
+  // into an already-running candidate whose gate has NEVER opened and target is still absent.
+  if (engine_device_.running && !(first_running_candidate && !active_bridge_->ever_opened)) return false;
+  AudioBufferList* buffer = converter_buffer_ ? const_cast<AudioBufferList*>(converter_buffer_.audioBufferList) : nullptr;
+  AudioGraphCallbackBridge::Target target{fine_audio_buffer_.get(), converter_ref_, buffer, machTickUnitsToNanoseconds_, active_bridge_->source_id, active_bridge_->sink_id, {}};
+  const std::weak_ptr<AudioGraphCallbackBridge> generation = active_bridge_;
+  target.speech = [this, generation](AudioDeviceModule::SpeechActivityEvent rtc_event) {
+    thread_->PostTask(SafeTask(safety_, [this, generation, rtc_event] {
+      RTC_DCHECK_RUN_ON(thread_);
+      if (!cleanup_unconfirmed_ && generation.lock() == active_bridge_ && observer_) observer_->OnSpeechActivityEvent(rtc_event);
+    }));
+  };
+  active_bridge_->Bind(std::move(target)); return true;
+}
+AudioEngineDevice::InputPreparationRequest AudioEngineDevice::BeginInputPreparation(bool input, bool output, uint64_t capture_state) {
+  RTC_DCHECK_RUN_ON(thread_);
+  InputPreparationRequest request; request.generation = ++state_generation_; request.capture_state = capture_state; request.graph_id = ++graph_generation_;
+  request.previous = engine_state_; request.next = engine_state_;
+  request.next.input_available = input; request.next.output_available = output;
+  request.owner = reinterpret_cast<uintptr_t>((__bridge void*)engine_device_); request.worker_identity = reinterpret_cast<uintptr_t>(thread_);
+  request.deadline_ms = TimeMillis() + 6000;
+  EngineStateUpdate state{request.previous, request.next};
+  request.eligible = (prepared_input_graph_enabled_ || BridgeMode()) && initialized_ && !cleanup_unconfirmed_ && active_bridge_ && engine_device_ && engine_device_.running &&
+      !input_node_instantiated_ && state.DidEnableInput() && state.prev.IsOutputRunning() && state.next.IsOutputRunning() &&
+      !state.prev.is_interrupted && !state.next.is_interrupted && !state.IsEngineRecreateRequired() &&
+      state.next.mute_mode == MuteMode::InputMixer && state.next.input_muted &&
+      state.next.platform_voice_processing_allowed && state.next.voice_processing_enabled && !state.next.voice_processing_bypassed &&
+      state.next.built_in_aec_enabled && state.next.built_in_ns_enabled && state.prev.IsInputDefaultDevice() && state.next.IsInputDefaultDevice() &&
+      state.prev.IsOutputDefaultDevice() && state.next.IsOutputDefaultDevice() && IsMicrophonePermissionAuthorized() && capture_state == ApplicationCaptureState();
+  if (request.eligible) { request.route = CurrentDefaultRoute(); request.eligible = request.route.valid; }
+  return request;
+}
+bool AudioEngineDevice::ValidateInputRequest(const InputPreparationRequest& request, bool ready, const std::shared_ptr<PreparedInputGraph>& graph) {
+  RTC_DCHECK_RUN_ON(thread_);
