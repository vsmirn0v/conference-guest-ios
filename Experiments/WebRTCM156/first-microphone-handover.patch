+#ifndef MODULES_AUDIO_DEVICE_MAC_PREPARED_GRAPH_CALLBACK_GATE_H_
+#define MODULES_AUDIO_DEVICE_MAC_PREPARED_GRAPH_CALLBACK_GATE_H_
+#include <atomic>
+#include <cstdint>
+
+namespace webrtc::mac_adm {
+// Control owns the target. Readers enter before dereferencing it. Close prevents
+// new readers. A drained gate is necessary but not sufficient for target changes:
+// the graph owner must also prove the AV graph stopped, except initial publication
+// into a running candidate whose gate has never opened.
+class PreparedGraphCallbackGate {
+ public:
+  static_assert(std::atomic<uint32_t>::is_always_lock_free);
+  bool TryEnter() noexcept {
+    uint32_t value = state_.load(std::memory_order_acquire);
+    while (!(value & kClosed) && (value & kReaders) != kReaders) {
+      if (state_.compare_exchange_weak(value, value + 1,
+                                     std::memory_order_acquire,
+                                     std::memory_order_relaxed)) return true;
+    }
+    return false;
+  }
+  void Leave() noexcept { state_.fetch_sub(1, std::memory_order_release); }
+  void Close() noexcept { state_.fetch_or(kClosed, std::memory_order_acq_rel); }
+  bool Drained() const noexcept {
+    return (state_.load(std::memory_order_acquire) & kReaders) == 0;
+  }
+  bool IsClosed() const noexcept {
+    return (state_.load(std::memory_order_acquire) & kClosed) != 0;
+  }
+  bool Open() noexcept {
+    uint32_t expected = kClosed;
+    return state_.compare_exchange_strong(expected, 0, std::memory_order_release,
+                                          std::memory_order_relaxed);
+  }
+  // Only cancellation before ANY target/resource mutation may resume in-flight
+  // readers. The target must be exactly the one those readers already hold.
+  void ResumeUnchanged() noexcept { state_.fetch_and(kReaders, std::memory_order_release); }
+ private:
+  static constexpr uint32_t kClosed = uint32_t{1} << 31;
+  static constexpr uint32_t kReaders = kClosed - 1;
+  std::atomic<uint32_t> state_{kClosed};
+};
+}  // namespace webrtc::mac_adm
+#endif
