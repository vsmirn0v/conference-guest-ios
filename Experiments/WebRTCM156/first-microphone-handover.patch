+std::shared_ptr<PreparedInputGraph> AudioEngineDevice::BuildInputGraph(const InputPreparationRequest& request) {
+  auto graph = std::make_shared<PreparedInputGraph>(); graph->request = request; graph->graph_id = request.graph_id;
+  return request.eligible ? BuildGraphResources(graph, request.next, request.worker_identity, request.deadline_ms) : graph;
+}
+std::shared_ptr<PreparedInputGraph> AudioEngineDevice::BuildStoppedInputGraph(const StoppedInputPreparationRequest& request) {
+  auto graph = std::make_shared<PreparedInputGraph>(); graph->warm_request = request; graph->graph_id = request.graph_id;
+  return request.eligible ? BuildGraphResources(graph, request.state, request.worker_identity, request.deadline_ms) : graph;
+}
+AudioEngineDevice::StoppedInputPreparationRequest AudioEngineDevice::BeginStoppedInputPreparation(uint64_t capture_state, int64_t deadline_ms) {
+  RTC_DCHECK_RUN_ON(thread_);
+  StoppedInputPreparationRequest request;
+  request.capture_state = capture_state; request.deadline_ms = deadline_ms;
+  if (cleanup_unconfirmed_ || TimeMillis() >= deadline_ms || (ApplicationCaptureState() & 1) == 0) {
+    request.result = kAudioEngineStateTransitionError; return request;
+  }
+  auto prerequisites = [&] {
+    RTC_DCHECK_RUN_ON(thread_);
+    const auto& state = engine_state_;
+    return !cleanup_unconfirmed_ && !stopped_graph_id_ && !engine_device_ && !input_node_instantiated_ &&
+        !state.input_available && !state.output_available &&
+        !state.IsAnyEnabled() && !state.IsAnyRunning() && !state.input_enabled_persistent_mode && state.input_muted &&
+        !state.is_interrupted && state.render_mode == RenderMode::Device && state.mute_mode == MuteMode::InputMixer &&
+        state.platform_voice_processing_allowed && state.voice_processing_enabled && !state.voice_processing_bypassed &&
+        state.built_in_aec_enabled && state.built_in_ns_enabled && state.IsInputDefaultDevice() && state.IsOutputDefaultDevice() &&
+        !audio_device_buffer_->IsPlaying() && !audio_device_buffer_->IsRecording() && IsMicrophonePermissionAuthorized() && (capture_state & 1) != 0;
+  };
+  const auto initial_route = CurrentDefaultRoute();
+  if (!prerequisites() || !BuiltInRoute(initial_route)) return request;
+  const EngineState initial_state = engine_state_;
+  const uint64_t initial_generation = state_generation_;
+  const bool initialized_before = initialized_;
+  const int64_t init_begin_ms = TimeMillis();
+  int32_t init_result = kAudioEngineInitError;
+  @try { init_result = Init(); }  // HAL listeners/device IDs only; never an AV graph or I/O start.
+  @catch (NSException* exception) { LOGE() << "Bridge early Init exception: " << exception.reason.UTF8String; }
+  LOGI() << "Bridge early Init result=" << init_result << " durationMs=" << TimeMillis() - init_begin_ms
+         << " initializedBefore=" << initialized_before << " deadlineRemainingMs=" << deadline_ms - TimeMillis();
+  if (init_result != 0) {
+    // Init can fail after partially registering HAL listeners. Keep their complete owner alive.
+    cleanup_unconfirmed_ = true; this->AddRef();
+    request.result = init_result < 0 ? init_result : kAudioEngineInitError;
+    return request;
+  }
+  if (!initialized_ || TimeMillis() >= deadline_ms || (ApplicationCaptureState() & 1) == 0 ||
+      state_generation_ != initial_generation || engine_state_ != initial_state || !prerequisites() ||
+      !SameRoute(initial_route, CurrentDefaultRoute())) {
+    request.result = kAudioEngineStateTransitionError; return request;
+  }
+  request.generation = ++state_generation_; request.graph_id = ++graph_generation_;
+  request.configuration_generation = warm_configuration_generation_;
+  request.initialized_at_reservation = initialized_; request.state = engine_state_;
+  request.module_identity = reinterpret_cast<uintptr_t>(this); request.worker_identity = reinterpret_cast<uintptr_t>(thread_);
+  request.route = initial_route; request.eligible = true; request.result = 0;
+  stopped_graph_id_ = request.graph_id;  // Covers build, cache and caller cleanup, not activation authority.
+  LOGI() << "Bridge stopped warm reserve eligible=" << request.eligible << " graph=" << request.graph_id << " initialized=" << request.initialized_at_reservation
+         << " warmConfiguration=" << request.configuration_generation << " fullGeneration=" << request.generation;
+  return request;
+}
+bool AudioEngineDevice::HasStoppedInputGraph() { RTC_DCHECK_RUN_ON(thread_); return stopped_graph_id_ != 0; }
+void AudioEngineDevice::InvalidateStoppedInputPreparation() { RTC_DCHECK_RUN_ON(thread_); ++warm_configuration_generation_; }
+bool AudioEngineDevice::ValidateStoppedInputRequest(const std::shared_ptr<PreparedInputGraph>& graph) {
+  RTC_DCHECK_RUN_ON(thread_);
+  const auto& request = graph->warm_request;
+  const uint64_t observed_capture = ApplicationCaptureState();
+  const auto observed_route = CurrentDefaultRoute();
+  const bool configuration = warm_configuration_generation_ == request.configuration_generation;
+  const bool owner = request.eligible && !cleanup_unconfirmed_ && stopped_graph_id_ == graph->graph_id &&
+      request.module_identity == reinterpret_cast<uintptr_t>(this) && initialized_ == request.initialized_at_reservation;
+  const bool projected_state = WarmStateProjection(engine_state_) == WarmStateProjection(request.state);
+  const bool initial_closed = (request.capture_state & 1) != 0, current_closed = (observed_capture & 1) != 0;
+  const bool capture_equal = request.capture_state == observed_capture;  // Diagnostic only: stopped preparation has no active target.
+  const bool availability = !engine_state_.input_available && !engine_state_.output_available;
+  const bool adb_stopped = !audio_device_buffer_->IsPlaying() && !audio_device_buffer_->IsRecording();
+  const bool no_engine = !engine_device_ && !input_node_instantiated_, deadline = TimeMillis() < request.deadline_ms;
+  const bool devices_equal = SameDevices(request.route, observed_route), builtin = BuiltInRoute(observed_route);
+  const bool authorized = IsMicrophonePermissionAuthorized();
+  const bool valid = configuration && owner && projected_state && initial_closed && current_closed && availability &&
+      adb_stopped && no_engine && deadline && devices_equal && builtin && authorized;
+  if (!valid) LOGW() << "Bridge stopped resource rejected graph=" << graph->graph_id << " configuration=" << configuration
+      << " owner=" << owner << " projectedState=" << projected_state << " captureEqual=" << capture_equal
+      << " initialCaptureClosed=" << initial_closed << " currentClosed=" << current_closed << " availability=" << availability
+      << " adbStopped=" << adb_stopped << " noEngine=" << no_engine << " deadlineValid=" << deadline
+      << " devicesEqual=" << devices_equal << " builtIn=" << builtin << " authorized=" << authorized;
+  return valid;
+}
+int32_t AudioEngineDevice::StageStoppedInputGraph(const std::shared_ptr<PreparedInputGraph>& graph) {
+  RTC_DCHECK_RUN_ON(thread_);
+  if (!graph->built || !ValidateStoppedInputRequest(graph) || !StoppedGraphIsQuiescent(graph)) return kAudioEngineStateTransitionError;
+  @try {
+    graph->staged = true;
+    NSDictionary* output_context = @{ @"RockAudioPreparedGraphID": @(graph->graph_id), @"RockAudioPreparedGraphPhase": @1 };
+    NSDictionary* input_context = @{ @"RockAudioPreparedGraphID": @(graph->graph_id), @"RockAudioPreparedGraphPhase": @1, kAudioEngineInputMixerNodeKey: graph->mixer };
+    if (!observer_ || observer_->OnEngineWillConnectOutput(graph->engine, graph->engine.mainMixerNode, graph->output, graph->output_format, output_context) ||
+        !ValidateStoppedInputRequest(graph) || observer_->OnEngineWillConnectInput(graph->engine, graph->input, graph->mixer, graph->input_format, input_context) ||
+        !ValidateStoppedInputRequest(graph)) return kAudioEngineStateTransitionError;
+  } @catch (NSException*) { return kAudioEngineDeviceFormatError; }
+  return 0;
+}
+int32_t AudioEngineDevice::PrepareStoppedInputGraph(const std::shared_ptr<PreparedInputGraph>& graph) {
+  const auto& request = graph->warm_request;
+  if (!graph->built || !graph->staged || [NSThread isMainThread] || request.worker_identity == reinterpret_cast<uintptr_t>(Thread::Current())) return kAudioEngineInvalidStateError;
+  @try {
+    LOGI() << "Bridge stopped caller prepare begin graph=" << graph->graph_id;
+    [graph->engine prepare]; usleep(100000);  // Preserve the normal VPIO stabilization while no media exists.
+    graph->input_bus_format = [graph->input outputFormatForBus:0]; graph->output_bus_format = [graph->output outputFormatForBus:0];
+    graph->prepared_route = CurrentDefaultRoute();
+    const bool quiescent = StoppedGraphIsQuiescent(graph), deadline = TimeMillis() < request.deadline_ms;
+    const uint64_t observed_capture = ApplicationCaptureState();
+    const bool capture_equal = request.capture_state == observed_capture, capture_closed = (observed_capture & 1) != 0;
+    const bool initial_closed = (request.capture_state & 1) != 0;
+    const bool devices_equal = SameDevices(request.route, graph->prepared_route), builtin = BuiltInRoute(graph->prepared_route);
+    graph->warm_prepared = quiescent && deadline && initial_closed && capture_closed && devices_equal && builtin;
+    LOGI() << "Bridge stopped resource readiness graph=" << graph->graph_id << " quiescent=" << quiescent << " deadlineValid=" << deadline
+           << " captureEqual=" << capture_equal << " captureClosed=" << capture_closed << " initialCaptureClosed=" << initial_closed
+           << " devicesEqual=" << devices_equal << " builtIn=" << builtin;
+    LOGI() << "Bridge stopped caller prepare end graph=" << graph->graph_id << " ready=" << graph->warm_prepared
+           << " silent=" << graph->bridge->silent_renders.load() << " discarded=" << graph->bridge->discarded_inputs.load()
+           << " active=" << graph->bridge->active_renders.load() << "/" << graph->bridge->active_records.load();
+  } @catch (NSException* exception) { LOGW() << "Bridge stopped prepare exception: " << exception.reason.UTF8String; }
+  return graph->warm_prepared ? 0 : kAudioEngineStateTransitionError;
+}
+int32_t AudioEngineDevice::PublishStoppedInputGraph(const std::shared_ptr<PreparedInputGraph>& graph) {
+  RTC_DCHECK_RUN_ON(thread_);
+  if (!graph->warm_prepared || !ValidateStoppedInputRequest(graph) || !StoppedGraphIsQuiescent(graph, true) ||
+      !SameRoute(graph->prepared_route, CurrentDefaultRoute()) || !PreparedFormatsMatch(graph)) return kAudioEngineStateTransitionError;
+  prepared_input_graph_enabled_ = true;  // Only this explicitly opted-in module passed all stopped-cache checks.
+  LOGI() << "Bridge stopped cache ready graph=" << graph->graph_id << " warmConfiguration=" << warm_configuration_generation_
+         << " fullGeneration=" << state_generation_;
+  return 0;
+}
+int32_t AudioEngineDevice::AttachStoppedInputGraph(const InputPreparationRequest& request, const std::shared_ptr<PreparedInputGraph>& graph) {
+  RTC_DCHECK_RUN_ON(thread_);
+  const bool profile = SameInputGraphProfile(graph->warm_request.state, request.next);
+  const bool intent = ValidateInputRequest(request, false, graph), route = SameRoute(graph->prepared_route, CurrentDefaultRoute());
+  const bool stopped = StoppedGraphIsQuiescent(graph, true), formats = PreparedFormatsMatch(graph);
+  LOGI() << "Bridge cache match graph=" << graph->graph_id << " profile=" << profile << " intent=" << intent
+         << " route=" << route << " stopped=" << stopped << " formats=" << formats;
+  if (!graph->warm_prepared || !graph->staged || stopped_graph_id_ != graph->graph_id ||
+      graph->warm_request.module_identity != reinterpret_cast<uintptr_t>(this) || !profile || !intent || !route ||
+      !BuiltInRoute(CurrentDefaultRoute()) || !stopped || !formats) return 1;
+  graph->request = request;  // A fresh activation token consumes compatible resources; warm intent is never rebased.
+  graph->from_cache = true;
+  LOGI() << "Bridge stopped cache consumed graph=" << graph->graph_id << " activation=" << request.generation;
+  return 0;
+}
+int32_t AudioEngineDevice::FinishStoppedInputGraph(const std::shared_ptr<PreparedInputGraph>& graph, bool clean, bool require_current) {
+  RTC_DCHECK_RUN_ON(thread_);
+  if (!clean || !graph->cleanup_confirmed) {
+    graph->cleanup_confirmed = false; cleanup_unconfirmed_ = true; this->AddRef();
+    LOGE() << "Bridge stopped cleanupUnconfirmed; complete owner must remain retained";
+    return kAudioEngineStateTransitionError;
+  }
+  const bool current = !require_current || ValidateStoppedInputRequest(graph);
+  if (stopped_graph_id_ == graph->graph_id) stopped_graph_id_ = 0;
+  return current ? 0 : kAudioEngineStateTransitionError;
+}
+int32_t AudioEngineDevice::StageInputGraph(const InputPreparationRequest& request, const std::shared_ptr<PreparedInputGraph>& graph) {
+  RTC_DCHECK_RUN_ON(thread_);
+  if (!graph->built || !ValidateInputRequest(request, false, graph)) { LOGW() << "Bridge Stage rejected built=" << graph->built; return kAudioEngineStateTransitionError; }
+  if (graph->from_cache) return graph->staged && StoppedGraphIsQuiescent(graph) && PreparedFormatsMatch(graph) ? 0 : kAudioEngineStateTransitionError;
+  LOGI() << "Bridge stage prepare id=" << request.generation;
+  @try {
+    graph->staged = true;  // Original retained delegate must retire even partial tap installation.
+    NSDictionary* output_context = @{ @"RockAudioPreparedGraphID": @(graph->graph_id), @"RockAudioPreparedGraphPhase": @1 };
+    NSDictionary* input_context = @{ @"RockAudioPreparedGraphID": @(graph->graph_id), @"RockAudioPreparedGraphPhase": @1, kAudioEngineInputMixerNodeKey: graph->mixer };
+    if (!observer_ || observer_->OnEngineWillConnectOutput(graph->engine, graph->engine.mainMixerNode, graph->output, graph->output_format, output_context) ||
+        !ValidateInputRequest(request, false, graph) || observer_->OnEngineWillConnectInput(graph->engine, graph->input, graph->mixer, graph->input_format, input_context) || !ValidateInputRequest(request, false, graph)) return kAudioEngineStateTransitionError;
+  } @catch (NSException*) { return kAudioEngineDeviceFormatError; }
+  return 0;
+}
+int32_t AudioEngineDevice::StartInputGraph(const std::shared_ptr<PreparedInputGraph>& graph) {
+  const auto& request = graph->request;
+  if (!graph->built || !graph->staged || [NSThread isMainThread] || request.worker_identity == reinterpret_cast<uintptr_t>(Thread::Current())) return kAudioEngineInvalidStateError;
+  @try {
+    if (graph->from_cache) {
+      if (!StoppedGraphIsQuiescent(graph) || !PreparedFormatsMatch(graph) || !SameRoute(graph->prepared_route, CurrentDefaultRoute())) return kAudioEngineStateTransitionError;
+      LOGI() << "Bridge cached caller start; no prepare graph=" << graph->graph_id;
+    } else {
+      LOGI() << "Bridge caller prepare begin id=" << request.generation;
+      [graph->engine prepare]; usleep(100000);
+    }
+    LOGI() << "Bridge caller native start begin id=" << request.generation;
+    NSError* error = nil;
+    if (TimeMillis() >= request.deadline_ms || request.capture_state != ApplicationCaptureState() || ![graph->engine startAndReturnError:&error]) return kAudioEnginePlayoutStartError;
+    const int64_t callback_deadline = std::min(request.deadline_ms, TimeMillis() + 250);
+    while ((graph->bridge->silent_renders.load(std::memory_order_relaxed) < 2 || graph->bridge->discarded_inputs.load(std::memory_order_relaxed) == 0) && TimeMillis() < callback_deadline) usleep(1000);
+    LOGI() << "Bridge caller native start end id=" << request.generation << " silent=" << graph->bridge->silent_renders.load()
+           << " discarded=" << graph->bridge->discarded_inputs.load() << " active=" << graph->bridge->active_renders.load();
+    const auto started_route = CurrentDefaultRoute();
+    const bool cached_stable = !graph->from_cache || (SameRoute(graph->prepared_route, started_route) && PreparedFormatsMatch(graph));
+    if (!graph->from_cache) {
+      graph->input_bus_format = [graph->input outputFormatForBus:0]; graph->output_bus_format = [graph->output outputFormatForBus:0];
+      graph->prepared_route = started_route;
+    }
+    graph->started = cached_stable && graph->engine.running && graph->bridge->silent_renders.load() >= 2 && graph->bridge->discarded_inputs.load() > 0 && TimeMillis() < request.deadline_ms && request.capture_state == ApplicationCaptureState() && SameDevices(request.route, graph->prepared_route);
+    LOGI() << "Bridge started ready=" << graph->started << " input=" << graph->input_bus_format.description.UTF8String
+           << " output=" << graph->output_bus_format.description.UTF8String << " captureEqual=" << (request.capture_state == ApplicationCaptureState())
+           << " devicesEqual=" << SameDevices(request.route, graph->prepared_route) << " deadlineRemainingMs=" << request.deadline_ms - TimeMillis();
+  } @catch (NSException* exception) { LOGW() << "Bridge start exception: " << exception.reason.UTF8String; }
+  return graph->started ? 0 : kAudioEngineStateTransitionError;
+}
+int32_t AudioEngineDevice::CommitInputGraph(const InputPreparationRequest& request, const std::shared_ptr<PreparedInputGraph>& graph) {
+  RTC_DCHECK_RUN_ON(thread_);
+  if (!graph->started || !graph->staged || graph->bridge->ever_opened || graph->bridge->active_renders.load() ||
+      graph->bridge->active_records.load() || !ValidateInputRequest(request, true, graph)) { LOGW() << "Bridge Commit rejected before old close"; return kAudioEngineStateTransitionError; }
+  @try {
+    if (!graph->engine.running || ![graph->input_bus_format isEqual:[graph->input outputFormatForBus:0]] ||
+        ![graph->output_bus_format isEqual:[graph->output outputFormatForBus:0]]) return kAudioEngineDeviceFormatError;
+    ++state_generation_;  // This commit owns the reserved request. Later requests invalidate recovery.
+    LOGI() << "Bridge handoff close old id=" << request.generation << " candidate active pulls=" << graph->bridge->active_renders.load();
+    if (!CloseActiveBridge()) return kAudioEngineStateTransitionError;
+    graph->old = std::make_shared<PreparedInputGraph>();
+    auto& old = graph->old;
+    old->engine = engine_device_; old->output = engine_device_.outputNode;
+    old->source = source_node_; old->bridge = active_bridge_; old->staged = true;
+    old->active_renders_at_close = old->bridge->active_renders.load(std::memory_order_relaxed);
+    LOGI() << "Bridge old graph drained renders=" << old->active_renders_at_close;
+    graph->swap_started = true;
+    if (!RemoveBridgeConfigurationObserver()) {
+      graph->cleanup_confirmed = false;
+      @throw [NSException exceptionWithName:@"BridgeObserverDrain" reason:@"Notification posting drain unconfirmed" userInfo:nil];
+    }
+    old->stop_confirmed = StopGraphUnits(old->engine, nil, old->output);
+    if (!old->stop_confirmed) { graph->cleanup_confirmed = false; @throw [NSException exceptionWithName:@"BridgeStop" reason:@"Old output stop unconfirmed" userInfo:nil]; }
+    if (observer_) {
+      if (observer_->OnEngineDidStop(old->engine, true, false) || state_generation_ != request.generation + 1)
+        @throw [NSException exceptionWithName:@"BridgeObserver" reason:@"Old stop observer failed" userInfo:nil];
+      const int32_t release_result = observer_->OnEngineWillRelease(old->engine);
+      if (release_result == 0) old->staged = false;  // Release succeeded even if its callback changed intent.
+      if (release_result || state_generation_ != request.generation + 1)
+        @throw [NSException exceptionWithName:@"BridgeObserver" reason:@"Old release observer failed" userInfo:nil];
+    }
