+struct AudioGraphCallbackBridge {
+  struct Target { FineAudioBuffer* fine = nullptr; AudioConverterRef converter = nullptr;
+    AudioBufferList* record_buffer = nullptr; double tick_ns = 0;
+    uint64_t source_id = 0, sink_id = 0;
+    std::function<void(AudioDeviceModule::SpeechActivityEvent)> speech; };
+  mac_adm::PreparedGraphCallbackGate gate;
+  mac_adm::PreparedGraphCallbackGate notification_gate;  // Posting lifetime is independent of render admission.
+  std::unique_ptr<Target> owner;
+  std::atomic<Target*> target{nullptr};
+  std::atomic<uint64_t> silent_renders{0}, discarded_inputs{0}, active_renders{0}, active_records{0};
+  static_assert(std::atomic<uint64_t>::is_always_lock_free);
+  uint64_t next_node_id = 1, source_id = 0, sink_id = 0;  // Control-thread node identities; snapshots are immutable in Target.
+  bool ever_opened = false;  // Control-thread state: running replacement is allowed only for the initial candidate publication.
+  void Bind(Target value) {
+    RTC_DCHECK(gate.IsClosed() && gate.Drained());
+    owner = std::make_unique<Target>(value); target.store(owner.get(), std::memory_order_release);
+    RTC_CHECK(gate.Open()); ever_opened = true;
+  }
+  void Speech(AudioDeviceModule::SpeechActivityEvent event) {
+    if (!gate.TryEnter()) return;
+    Target* current = target.load(std::memory_order_acquire);
+    if (current && current->speech) current->speech(event);
+    gate.Leave();
+  }
+  OSStatus Render(uint64_t node_id, BOOL* silence, AVAudioFrameCount frames, AudioBufferList* buffers) {
+    if (buffers->mNumberBuffers != 1) return kAudio_ParamError;
+    if (!gate.TryEnter()) {
+      silent_renders.fetch_add(1, std::memory_order_relaxed);
+      *silence = YES; if (buffers->mBuffers[0].mData) std::memset(buffers->mBuffers[0].mData, 0, buffers->mBuffers[0].mDataByteSize);
+      return noErr;
+    }
+    Target* current = target.load(std::memory_order_acquire);
+    if (current && current->source_id == node_id && current->fine && buffers->mBuffers[0].mData && frames <= buffers->mBuffers[0].mDataByteSize / sizeof(int16_t)) {
+      active_renders.fetch_add(1, std::memory_order_relaxed);
+      current->fine->GetPlayoutData(std::span<int16_t>(static_cast<int16_t*>(buffers->mBuffers[0].mData), frames), kFixedPlayoutDelayEstimate);
+      *silence = NO;
+    } else {
+      *silence = YES; if (buffers->mBuffers[0].mData) std::memset(buffers->mBuffers[0].mData, 0, buffers->mBuffers[0].mDataByteSize);
+    }
+    gate.Leave(); return noErr;
+  }
+  OSStatus Record(uint64_t node_id, const AudioTimeStamp* timestamp, AVAudioFrameCount frames, const AudioBufferList* buffers) {
+    if (!gate.TryEnter()) { discarded_inputs.fetch_add(1, std::memory_order_relaxed); return noErr; }
+    Target* current = target.load(std::memory_order_acquire); OSStatus result = noErr;
+    if (current && current->sink_id == node_id && current->fine && current->converter && current->record_buffer && buffers->mNumberBuffers == 1 && frames <= kMaximumFramesPerBuffer) {
+      current->record_buffer->mBuffers[0].mDataByteSize = buffers->mBuffers[0].mDataByteSize;
+      result = AudioConverterConvertComplexBuffer(current->converter, frames, buffers, current->record_buffer);
+      if (result == noErr) { active_records.fetch_add(1, std::memory_order_relaxed); current->fine->DeliverRecordedData(
+          std::span<const int16_t>(static_cast<int16_t*>(current->record_buffer->mBuffers[0].mData), frames),
+          kFixedRecordDelayEstimate, timestamp->mHostTime * current->tick_ns); }
+    }
+    gate.Leave(); return result;
+  }
+};
+namespace {
+AVAudioSourceNode* BridgeSource(AVAudioFormat* format, const std::shared_ptr<AudioGraphCallbackBridge>& bridge) {
+  const auto owner = bridge;  // Capture a value, never the caller's replaceable shared_ptr reference.
+  const uint64_t node_id = owner->next_node_id++; owner->source_id = node_id;
+  return [[AVAudioSourceNode alloc] initWithFormat:format renderBlock:^OSStatus(BOOL* silence, const AudioTimeStamp*, AVAudioFrameCount frames, AudioBufferList* buffers) {
+    return owner->Render(node_id, silence, frames, buffers);
+  }];
+}
+AVAudioSinkNode* BridgeSink(const std::shared_ptr<AudioGraphCallbackBridge>& bridge) {
+  const auto owner = bridge;
+  const uint64_t node_id = owner->next_node_id++; owner->sink_id = node_id;
+  return [[AVAudioSinkNode alloc] initWithReceiverBlock:^OSStatus(const AudioTimeStamp* time, AVAudioFrameCount frames, const AudioBufferList* buffers) {
+    return owner->Record(node_id, time, frames, buffers);
+  }];
+}
+}  // namespace
