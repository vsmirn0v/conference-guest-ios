+TEST(PrivateInputMeterTest, StartupDiagnosticsSurviveRevokeWithoutMeterPermission) {
+  using C=mac_adm::PrivateInputMeterControl; using D=C::Detail; using S=C::Stage;
+  C c; ASSERT_TRUE(c.Begin(1)); c.SetStage(1,S::kNativeStart);
+  c.RawCallback(1,128,1,1,512); EXPECT_TRUE(c.Record(1,std::vector<float>{0.3f}));
+  c.SetDetail(1,D::kUnitStatus,uint64_t(int64_t(-10867))); c.Reject(1,-5001);
+  c.Revoke(1); c.Finish(1,true,-5001);
+  const auto state=c.Read(); EXPECT_EQ(state.meter.callbacks,0u); EXPECT_FALSE(state.active);
+  EXPECT_EQ(state.diagnostic.at(size_t(D::kRawCallbackAttempts)),1u);
+  EXPECT_EQ(state.diagnostic.at(size_t(D::kRawCallbacksAccepted)),1u);
+  EXPECT_EQ(state.diagnostic.at(size_t(D::kFailureStage)),uint64_t(S::kNativeStart));
+  EXPECT_EQ(int64_t(state.diagnostic.at(size_t(D::kUnitStatus))),-10867);
+  EXPECT_GT(state.diagnostic.at(size_t(D::kFirstRawCallbackNS)),0u);
+  EXPECT_TRUE(state.confirmed_stopped);
+}
