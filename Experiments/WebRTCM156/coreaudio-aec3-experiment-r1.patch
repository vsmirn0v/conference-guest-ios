+  EXPECT_EQ(epoch.Begin(2, 2, reset), 0);
+  converter_history.push_back(0.7f);
+  EXPECT_EQ(epoch.Begin(2, 2, reset), 0);
+  EXPECT_EQ(converter_history.size(), 1u);
+  // Boolean mute returns open, but changed epoch must discard held PCM.
