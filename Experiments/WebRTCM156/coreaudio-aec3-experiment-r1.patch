+int32_t AudioDeviceMac::EnableExperimentalCoreAudioControl() {
+  MutexLock lock(&mutex_);
+  if (_playing || _recording || _playIsInitialized || _recIsInitialized) return -1;
+  AudioDeviceID input = 0, output = 0;
+  UInt32 size = sizeof(AudioDeviceID);
+  AudioObjectPropertyAddress address = {kAudioHardwarePropertyDefaultInputDevice,
+      kAudioObjectPropertyScopeGlobal, kAudioObjectPropertyElementMain};
+  OSStatus result = AudioObjectGetPropertyData(kAudioObjectSystemObject, &address, 0, nullptr, &size, &input);
+  if (result != noErr) return -1;
+  address.mSelector = kAudioHardwarePropertyDefaultOutputDevice;
+  size = sizeof(AudioDeviceID);
+  result = AudioObjectGetPropertyData(kAudioObjectSystemObject, &address, 0, nullptr, &size, &output);
+  if (result != noErr) return -1;
+  // Narrow experiment: a shared duplex IOProc cannot promise physical input-off.
+  if (!input || !output || input == output) return -2;
+  experimental_capture_buffer_ =
+      std::make_unique<ExperimentalCoreAudioCapture>(REC_BUF_SIZE_IN_SAMPLES);
+  experimental_core_audio_enabled_.store(true, std::memory_order_release);
+  return 0;
+}
+int32_t AudioDeviceMac::ExperimentalCoreAudioError() const {
+  return experimental_core_audio_error_.load(std::memory_order_acquire);
+}
