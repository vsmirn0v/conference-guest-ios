+void AudioDeviceBuffer::ExperimentalMeter::AddEnergy(uint64_t sum, size_t count, bool known) {
+  const uint64_t now = CoreAudioUptimeNanos();
+  if (!known) energy_known.store(false, std::memory_order_relaxed);
+  samples.fetch_add(count, std::memory_order_relaxed);
+  energy.fetch_add(sum, std::memory_order_relaxed);
+  recent_energy.store(sum, std::memory_order_relaxed);
+  recent_samples.store(count, std::memory_order_relaxed);
+  uint64_t zero = 0;
+  first.compare_exchange_strong(zero, now, std::memory_order_relaxed);
+  last.store(now, std::memory_order_relaxed);
