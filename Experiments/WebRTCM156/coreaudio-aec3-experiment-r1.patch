+// Copyright 2026 The WebRTC project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license.
+#ifndef MODULES_AUDIO_DEVICE_MAC_EXPERIMENTAL_CORE_AUDIO_CAPTURE_H_
+#define MODULES_AUDIO_DEVICE_MAC_EXPERIMENTAL_CORE_AUDIO_CAPTURE_H_
+
+#include <algorithm>
+#include <cstdint>
+#include <span>
+#include <vector>
+#include "modules/audio_device/mac/audio_ring_buffer_mac.h"
+
+namespace webrtc {
+// Opt-in only. Payload and both privacy epochs share one SPSC publication.
+// All storage is allocated before capture starts. Producer and consumer each
+// exclusively own their scratch vector; neither may reset an active ring.
+// Capture-worker-only epoch. Reset must finish successfully before any input
+// from a new epoch enters a stateful converter.
+class ExperimentalCoreAudioCaptureEpoch {
+ public:
+  template <typename Reset>
+  int32_t Begin(uint64_t local, uint64_t process, Reset reset) {
+    if (local != local_ || process != process_) {
+      const int32_t result = reset();
+      if (result) return result;
+      local_ = local;
+      process_ = process;
+    }
+    return 0;
+  }
+  uint64_t local() const { return local_; }
+  uint64_t process() const { return process_; }
+ private:
+  uint64_t local_ = UINT64_MAX, process_ = UINT64_MAX;
+};
+
+class ExperimentalCoreAudioCapture {
+ public:
+  explicit ExperimentalCoreAudioCapture(size_t capacity)
+      : ring_(capacity), producer_(capacity), consumer_(capacity) {}
+  void ClearWhenIdle() { ring_.Clear(); }
+  size_t AvailableToRead() const { return ring_.AvailableToRead(); }
+  size_t capacity() const { return producer_.size(); }
+  bool Write(std::span<const float> input, uint64_t local, uint64_t process) {
+    if (input.size() > producer_.size() || input.size() > ring_.AvailableToWrite()) return false;  // Drop whole oversize IO.
+    auto tagged = std::span(producer_).first(input.size());
+    auto source = input.begin();
+    for (auto& sample : tagged) sample = {*source++, local, process};
+    return ring_.Write(tagged) == tagged.size();
+  }
+  size_t Read(std::span<float> output, uint64_t local, uint64_t process) {
+    if (output.size() > consumer_.size()) return 0;
+    auto tagged = std::span(consumer_).first(output.size());
+    const size_t count = ring_.Read(tagged);
+    auto destination = output.begin();
+    for (const auto& sample : tagged.first(count)) {
+      *destination++ = (!(local & 1) && !(process & 1) &&
+                         sample.local == local && sample.process == process)
+                            ? sample.value : 0.0f;
+    }
+    return count;
+  }
+ private:
+  struct Sample { float value; uint64_t local; uint64_t process; };
+  AudioRingBufferMac<Sample> ring_;
+  std::vector<Sample> producer_, consumer_;
+};
+}  // namespace webrtc
+#endif
