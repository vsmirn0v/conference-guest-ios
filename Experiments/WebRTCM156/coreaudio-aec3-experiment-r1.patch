+void AudioDeviceBuffer::ExperimentalMeter::Add(const int16_t* data, size_t count) {
+  if (!data || count == 0 || count > 65536) return;
+  static_assert(std::atomic<uint64_t>::is_always_lock_free);
+  uint64_t sum = 0;
+  for (int16_t sample : std::span<const int16_t>(data, count)) {
+    const int64_t value = sample;
+    sum += uint64_t(value * value);
+  }
+  AddEnergy(sum, count, true);
