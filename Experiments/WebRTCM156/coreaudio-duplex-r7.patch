+}
+TEST(ExperimentalCoreAudioOutputNegotiationTest, ChangedShapeBeforeListenerOnlyProducesSilence) {
+  AudioDeviceMac owner(true, true);
+  AudioDeviceMacDuplexTestPeer::Negotiate(owner);
+  auto* cell = ExperimentalCoreAudioCallbackCells().Allocate(&owner);
+  ASSERT_NE(cell, nullptr); ASSERT_TRUE(cell->Open());
+  std::array<float, 256> pcm; pcm.fill(0.75f);
+  AudioBufferList output{1, {{2, static_cast<UInt32>(sizeof(pcm)), pcm.data()}}};
+  // The real format remains zero/unbound. Reaching the legacy converter guard
+  // would reject this callback. Raw admission must not read that format at all.
+  EXPECT_EQ(AudioDeviceMacDuplexTestPeer::Raw(owner, cell, &output), noErr);
+  for (float sample : pcm) EXPECT_EQ(sample, 0);
+  output.mBuffers[0].mDataByteSize /= 2; pcm.fill(0.5f);
+  EXPECT_EQ(AudioDeviceMacDuplexTestPeer::Raw(owner, cell, &output), noErr);
+  for (size_t i = 0; i < pcm.size() / 2; ++i) EXPECT_EQ(pcm[i], 0);
+  for (size_t i = pcm.size() / 2; i < pcm.size(); ++i) EXPECT_EQ(pcm[i], 0.5f);
+  auto state = owner.GetExperimentalCoreAudioDuplexState();
+  EXPECT_EQ(state.raw_output_callbacks, 2u); EXPECT_EQ(state.output_callbacks, 0u);
+  EXPECT_FALSE(state.output_data_ready); EXPECT_FALSE(state.output_running);
+  AudioDeviceMacDuplexTestPeer::Event(owner);
+  EXPECT_EQ(owner.ExperimentalCoreAudioError(), 0);
+  EXPECT_FALSE(owner.GetExperimentalCoreAudioDuplexState().authority & Authority::kTerminal);
+  cell->Close(); EXPECT_TRUE(cell->ClosedAndDrained());
+  EXPECT_EQ(owner.RetireExperimentalCoreAudioOwner(), 0);
+}
