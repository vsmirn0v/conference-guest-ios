+  const auto queued = output.Read();
+  ASSERT_TRUE(output.FormatEvent()); EXPECT_NE(output.Read(), queued);
+  EXPECT_FALSE(output.ClaimBound(queued, nullptr)); EXPECT_FALSE(output.Allows());
+  ASSERT_TRUE(output.SetSound(false)); EXPECT_EQ(Output::State(output.Read()), Output::kDormant);
+  EXPECT_FALSE(output.BeginRaw());
+  ASSERT_TRUE(output.SetSound(true)); ASSERT_TRUE(output.BeginRaw());
+  EXPECT_EQ(Output::State(output.Read()), Output::kRawNegotiating);
+  ASSERT_TRUE(output.Close()); ASSERT_TRUE(output.Retired());
+  EXPECT_EQ(Output::State(output.Read()), Output::kPendingRaw);
