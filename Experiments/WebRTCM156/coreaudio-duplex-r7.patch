+  priming.StartReturned(30);
+  EXPECT_FALSE(priming.Fresh());
+  EXPECT_TRUE(priming.Observe(1, 2, 1024, 31));
+  EXPECT_FALSE(priming.Fresh());
+  EXPECT_TRUE(priming.Observe(1, 2, 1024, 32));
+  EXPECT_TRUE(priming.Fresh());
+  EXPECT_TRUE(priming.Shape(2, 8, 128));
