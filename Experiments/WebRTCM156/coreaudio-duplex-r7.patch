+  const auto current = owner.GetExperimentalCoreAudioDuplexState().authority;
+  EXPECT_TRUE(current & Authority::kSealed);
+  EXPECT_FALSE(Authority::AllowsPublication(owner.GetExperimentalCoreAudioDuplexState().authority));
+  EXPECT_EQ(owner.ExperimentalCoreAudioError(), 0);
