+// Only invokes real callbacks/authority and retirement on an uninitialized
+// driver. No test here initializes a device, registers a HAL callback or starts IO.
+class AudioDeviceMacDuplexTestPeer {
+ public:
+  static AudioDeviceMacDuplex& Driver(AudioDeviceMac& owner) { return *owner.duplex_; }
+  static void Negotiate(AudioDeviceMac& owner) {
+    auto& driver = Driver(owner);
+    driver.selected_.input = 101; driver.selected_.output = 95;
+    driver.negotiating_.store(true, std::memory_order_release);
+    driver.Demand(true, true); driver.Demand(false, true);
+    driver.Latch(ExperimentalCoreAudioDuplexAuthority::kAuthorized |
+        ExperimentalCoreAudioDuplexAuthority::kMuted | ExperimentalCoreAudioDuplexAuthority::kSound, 1);
+    driver.output_authority_.BeginRaw();
+  }
+  static void Event(AudioDeviceMac& owner, bool input = false, bool format = true) {
+    auto& driver = Driver(owner);
+    AudioObjectPropertyAddress address{format ? static_cast<AudioObjectPropertySelector>(kAudioDevicePropertyStreamFormat) :
+        static_cast<AudioObjectPropertySelector>(kAudioDevicePropertyDataSource),
+        input ? kAudioDevicePropertyScopeInput : kAudioDevicePropertyScopeOutput,
+        kAudioObjectPropertyElementMain};
+    driver.RouteChanged(input ? driver.selected_.input : driver.selected_.output, address);
+  }
+  static bool CommitCapture(AudioDeviceMac& owner) {
+    auto& authority = Driver(owner).authority_;
+    uint64_t word = authority.Read();
+    return authority.Seal(word, &word) && authority.Commit(word, nullptr);
+  }
+  static void ClaimBound(AudioDeviceMac& owner) {
+    auto& output = Driver(owner).output_authority_;
+    output.ClaimBound(output.Read(), nullptr);
+  }
+  static bool CompareInputSeal(AudioDeviceMac& owner, bool input_change, bool identity_change, bool numeric_change = false) {
+    AudioDeviceMacDuplex::Route a, b;
+    a.input = b.input = 101; a.output = b.output = 95;
+    a.input_uid = b.input_uid = "input"; a.output_uid = b.output_uid = "output";
+    a.input_format.mSampleRate = b.input_format.mSampleRate = 24000;
+    a.output_format.mSampleRate = 48000; b.output_format.mSampleRate = 24000;
+    if (input_change) b.input_format.mSampleRate = 48000;
+    if (identity_change) b.output_uid = "other";
+    if (numeric_change) ++b.output;
+    return Driver(owner).SameCaptureRoute(a, b);
+  }
+  static bool Seal(AudioDeviceMac& owner, uint64_t word) {
+    uint64_t sealed = 0;
+    return Driver(owner).authority_.Seal(word, &sealed);
+  }
+  static OSStatus Raw(AudioDeviceMac& owner, ExperimentalCoreAudioCallbackCell* cell, AudioBufferList* output) {
+    (void)owner;
+    AudioTimeStamp time{}; time.mFlags = kAudioTimeStampHostTimeValid; time.mHostTime = 1;
+    return AudioDeviceMac::guardedDeviceIOProc(0, nullptr, nullptr, nullptr, output, &time, cell);
+  }
+  static ExperimentalCoreAudioOutputPriming& Priming(AudioDeviceMac& owner) { return Driver(owner).output_priming_; }
+  static bool BoundFastPathAfterPropertyChange(AudioDeviceMac& owner, bool bind_reuse) {
+    auto& driver = Driver(owner);
+    Negotiate(owner);
+    uint64_t bound = 0;
+    if (!driver.output_authority_.ClaimBound(driver.output_authority_.Read(), &bound) ||
+        !driver.output_authority_.Authorize(bound) || !driver.output_priming_.Publish()) return true;
+    owner._outStreamFormat.mSampleRate = 48000;
+    owner._playing = true; driver.render_exited_.store(false, std::memory_order_release);
+    AudioDeviceMacDuplex::Route observed;
+    observed.output_format = owner._outStreamFormat; observed.output_format.mSampleRate = 24000;
+    const bool result = bind_reuse ? driver.BindOutput(observed, driver.Now() + 100000000, driver.output_authority_.Read()) :
+        driver.StartOutput(observed, 1, driver.Now() + 100000000);
+    // The observed property must never be overwritten to hide the mismatch.
+    EXPECT_EQ(observed.output_format.mSampleRate, 24000);
+    return result;
+  }
+  static uint64_t RawProofMask() {
+    return AudioDeviceMac::kCellClosed | AudioDeviceMac::kCellDrained | AudioDeviceMac::kStopSucceeded |
+        AudioDeviceMac::kDestroyed | AudioDeviceMac::kWorkerJoined | AudioDeviceMac::kConverterDisposed |
+        AudioDeviceMac::kListenersRemoved;
+  }
+  static bool StopUnbound(AudioDeviceMac& owner) { return Driver(owner).StopOutput(Driver(owner).Now() + 100000000); }
+};
