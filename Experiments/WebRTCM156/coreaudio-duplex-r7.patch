+TEST(ExperimentalCoreAudioOutputNegotiationTest, SealRaceNeverAcceptsStaleFormatAndTruePostsealEventIsFatal) {
+  for (size_t i = 0; i < 100; ++i) {
+    Authority authority; authority.SetCaptureDemand(true); uint64_t token = 0;
+    ASSERT_TRUE(authority.Latch(1, Authority::kAuthorized | Authority::kMuted | Authority::kSound, &token));
+    std::atomic<bool> go{false}; bool sealed = false;
+    std::thread event([&] { while (!go.load(std::memory_order_acquire)) {} authority.RouteEvent(); });
+    go.store(true, std::memory_order_release); sealed = authority.Seal(token, nullptr); event.join();
+    if (sealed) EXPECT_TRUE(authority.Read() & Authority::kTerminal);
+    else EXPECT_NE(authority.Read(), token);
+    EXPECT_FALSE(Authority::AllowsPublication(authority.Read()));
+  }
+  AudioDeviceMac owner(true, true); AudioDeviceMacDuplexTestPeer::Negotiate(owner);
+  ASSERT_TRUE(AudioDeviceMacDuplexTestPeer::Seal(owner, owner.GetExperimentalCoreAudioDuplexState().authority));
+  AudioDeviceMacDuplexTestPeer::ClaimBound(owner);
+  AudioDeviceMacDuplexTestPeer::Event(owner);
+  EXPECT_EQ(owner.ExperimentalCoreAudioError(), -6);
+  EXPECT_TRUE(owner.GetExperimentalCoreAudioDuplexState().authority & Authority::kTerminal);
+  EXPECT_EQ(owner.RetireExperimentalCoreAudioOwner(), 0);
+}
