+TEST(ExperimentalCoreAudioOutputNegotiationTest, SoundAndLifecycleCASRejectOldProofAcrossTransitions) {
+  using Output = ExperimentalCoreAudioOutputAuthority;
+  Output output;
+  EXPECT_FALSE(output.BeginRaw()); // Main Sound-on may be visible first.
+  ASSERT_TRUE(output.SetSound(true)); ASSERT_TRUE(output.BeginRaw());
+  const auto stale = output.Read();
+  ASSERT_TRUE(output.FormatEvent()); EXPECT_FALSE(output.ClaimBound(stale, nullptr));
+  uint64_t bound = 0; ASSERT_TRUE(output.ClaimBound(output.Read(), &bound));
+  EXPECT_FALSE(output.FormatEvent()); // Bound is fatal even before converter allocation.
+  ASSERT_TRUE(output.SetSound(false)); EXPECT_FALSE(output.Authorize(bound));
+  ASSERT_TRUE(output.Close()); EXPECT_EQ(Output::State(output.Read()), Output::kClosing);
+  EXPECT_FALSE(output.FormatEvent()); EXPECT_FALSE(output.BeginRaw());
+  ASSERT_TRUE(output.Retired()); EXPECT_EQ(Output::State(output.Read()), Output::kDormant);
+  ASSERT_TRUE(output.FormatEvent()); EXPECT_FALSE(output.BeginRaw());
+  ASSERT_TRUE(output.SetSound(true)); ASSERT_TRUE(output.BeginRaw());
+  EXPECT_FALSE(output.ClaimBound(stale, nullptr));
+}
+TEST(ExperimentalCoreAudioOutputNegotiationTest, SoundOnPendingStartFormatEventRevokesOnlyTheNewOutputProof) {
