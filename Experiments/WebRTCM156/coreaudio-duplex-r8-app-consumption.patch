+#if DEBUG && ROCK_COREAUDIO_DUPLEX_R6
+// Native snapshots only reject work. The latest intent is consumed under the
+// owner's lock; final publication still requires the native exact-token CAS.
+enum GuestDuplexPreparationConsumption {
+    enum Decision: String { case reject, retryLatest, accept }
+
+    static func nativeFailed(core: [String: Any], duplex: [String: Any], expectedOwner: UInt64) -> Bool {
+        guard expectedOwner != 0, core["supported"] as? Bool == true, core["enabled"] as? Bool == true,
+              let cleanup = core["cleanupUnconfirmed"] as? Bool,
+              let diagnostic = core["nativeDiagnostics"] as? [String: Any],
+              let firstError = diagnostic["firstError"] as? Int,
+              let unsafe = diagnostic["unsafeFailureMask"] as? UInt64,
+              let retiring = diagnostic["retirementRequested"] as? Bool,
+              let retired = diagnostic["retirementConfirmed"] as? Bool,
+              let inputProof = diagnostic["inputRetirementProof"] as? UInt64,
+              let inputRequired = diagnostic["inputRetirementRequired"] as? UInt64,
+              let outputProof = diagnostic["outputRetirementProof"] as? UInt64,
+              let outputRequired = diagnostic["outputRetirementRequired"] as? UInt64,
+              let authority = duplex["authority"] as? UInt64,
+              duplex["ownerGeneration"] as? UInt64 == expectedOwner,
+              duplex["transportPinned"] as? Bool == true,
+              let quarantined = duplex["transportQuarantined"] as? Bool else { return true }
+        return cleanup || firstError != 0 || unsafe != 0 || retiring || retired || quarantined || authority & 8 != 0 ||
+            inputProof & inputRequired != inputRequired || outputProof & outputRequired != outputRequired
+    }
+
+    // Caller holds the same intent lock used by every local/native latch.
+    static func decide(status: Int, expected: UInt32, latest: UInt32, receiptMatches: Bool,
+                       terminal: Bool, nativeFailure: Bool, permitActive: Bool,
+                       now: TimeInterval, deadline: TimeInterval) -> Decision {
+        guard receiptMatches, !terminal, !nativeFailure, permitActive,
+              now.isFinite, deadline.isFinite, now < deadline,
+              expected > 0, latest > 0, expected <= 0x0fff_ffff, latest <= 0x0fff_ffff,
+              status == 0 || status == -21 else { return .reject }
+        if latest > expected { return .retryLatest }
+        return latest == expected && status == 0 ? .accept : .reject
+    }
+}
