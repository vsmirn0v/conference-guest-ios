+  }
+  void Revoke(uint64_t token) {
+    uint64_t previous=revoked_.load();
+    while (previous<token && !revoked_.compare_exchange_weak(previous,token)) {}
+    if (token_.load(std::memory_order_acquire)<=token) { requested_=false; active_=false; }
+  }
+  void RevokeCurrent() { Revoke(token_.load(std::memory_order_acquire)); }
+  void Terminate() { terminal_=true; RevokeCurrent(); }
+  uint64_t RawCallbacks() const { return callbacks_.load(std::memory_order_acquire); }
