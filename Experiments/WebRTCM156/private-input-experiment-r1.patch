+// Tokens strictly increase per ADM. A revoke tombstone precedes queued work;
+// start never resurrects a revoked token. Only control (not callbacks) resets
+// meter fields, after the previous graph is stopped and its readers drained.
+class PrivateInputMeterControl {
+ public:
+  static_assert(std::atomic<uint64_t>::is_always_lock_free);
+  struct Meter {
+    uint64_t samples=0, callbacks=0, non_silent_callbacks=0;
+    double energy=0, recent_rms=0, first=0, last=0, first_non_silent=0, last_non_silent=0;
+    bool energy_known=false;
+  };
+  struct State {
+    uint64_t token=0, revoked=0, graph_id=0, silent_output_callbacks=0;
+    uint32_t sample_rate=0, channels=0;
+    bool requested=false, active=false, start_in_flight=false, input_running=false;
+    bool confirmed_stopped=true, cleanup_unconfirmed=false;
+    int32_t result=0;
+    Meter meter;
+  };
+  static uint64_t Now() {
+    timespec t; clock_gettime(CLOCK_UPTIME_RAW, &t);
+    return uint64_t(t.tv_sec)*1000000000ULL+uint64_t(t.tv_nsec);
+  }
+  bool Begin(uint64_t token) {
+    if (!token || terminal_.load() || cleanup_.load() || !confirmed_stopped_.load()) return false;
+    uint64_t previous=newest_.load();
+    do { if (token<=previous) return false; }
+    while (!newest_.compare_exchange_weak(previous,token));
+    if (token<=revoked_.load() || terminal_.load()) return false;
+    samples_=0; energy_=0; callbacks_=0; non_silent_=0; recent_energy_=0; recent_samples_=0;
+    first_=0; last_=0; first_non_silent_=0; last_non_silent_=0; silent_output_=0; known_=true;
+    rate_=0; channels_=0; graph_id_=0; result_=0; active_=false; running_=false;
+    confirmed_stopped_=false; in_flight_=true; token_.store(token,std::memory_order_release); requested_=true;
+    if (!Valid(token)) { requested_=false; in_flight_=false; confirmed_stopped_=true; return false; }
+    return true;
+  }
+  bool Valid(uint64_t token) const {
+    return token && token_.load(std::memory_order_acquire)==token && token>revoked_.load(std::memory_order_acquire) &&
