+int32_t AudioEngineDevice::SealPrivateInputGraph(const PrivateInputMeterRequest& request, const std::shared_ptr<PreparedInputGraph>& graph) {
+  RTC_DCHECK_RUN_ON(thread_);
+  // A private graph is independently built. Never consume or modify the public stopped cache.
+  if (!ValidatePrivateInputMeter(request) || !graph || !graph->bridge->privacy.IsPrivate() ||
+      graph->warm_prepared || graph->staged || !graph->built || graph->started || graph->adopted ||
+      !StoppedGraphIsQuiescent(graph) || !PrivateInputFormatsMatch(graph) || !SameRoute(graph->prepared_route, request.resource.route))
+    return kAudioEngineStateTransitionError;
+  graph->bridge->private_meter = private_meter_control_; graph->bridge->private_token=request.token; graph->private_token = request.token;
+  private_meter_control_->SetGraph(graph->graph_id, uint32_t(graph->input_format.sampleRate), 1);
+  return 0;
+}
+std::shared_ptr<PreparedInputGraph> AudioEngineDevice::BuildPrivateInputGraph(const PrivateInputMeterRequest& request) {
+  auto graph = std::make_shared<PreparedInputGraph>(); graph->graph_id = request.resource.graph_id;
+  graph->bridge->privacy.Seal();  // No publishing authority can ever be attached.
+  if (!request.resource.eligible || [NSThread isMainThread] ||
+      request.resource.worker_identity==reinterpret_cast<uintptr_t>(Thread::Current())) return graph;
+  @try {
+    graph->engine=[[AVAudioEngine alloc] init]; graph->input=graph->engine.inputNode;
+    // No outputNode access and no VPIO/AEC/AGC configuration. A private level
+    // check needs capture PCM, not another voice-processing/output owner.
+    AVAudioFormat* format=[graph->input outputFormatForBus:0];
+    if (!format.sampleRate || !format.channelCount || format.commonFormat!=AVAudioPCMFormatFloat32 ||
+        graph->input.voiceProcessingEnabled) return graph;
+    graph->input_format=[[AVAudioFormat alloc] initWithCommonFormat:AVAudioPCMFormatFloat32
+        sampleRate:format.sampleRate channels:1 interleaved:format.interleaved];
+    graph->input_bus_format=format; graph->prepared_route=CurrentDefaultRoute(); graph->built=true;
+  } @catch (NSException*) { graph->built=false; }
+  return graph;
+}
+int32_t AudioEngineDevice::StartPrivateInputGraph(const PrivateInputMeterRequest& request, const std::shared_ptr<PreparedInputGraph>& graph) {
+  auto control = graph->bridge->private_meter;
+  if (!graph->bridge->privacy.IsPrivate() || !control || !control->Valid(request.token) ||
+      [NSThread isMainThread] || request.resource.worker_identity == reinterpret_cast<uintptr_t>(Thread::Current()))
+    return kAudioEngineStateTransitionError;
+  @try {
+    auto callback = std::make_shared<PrivateMeterCallbackOwner>(); callback->control = control; callback->token = request.token;
+    graph->private_callback = callback;
+    graph->private_meter_sink = [[AVAudioSinkNode alloc] initWithReceiverBlock:^OSStatus(
+        const AudioTimeStamp*, AVAudioFrameCount frames, const AudioBufferList* data) {
+      if (!callback->gate.TryEnter()) return noErr;
+      OSStatus result = noErr;
+      if (callback->control->Valid(callback->token)) {
+        if (data->mNumberBuffers != 1 || !data->mBuffers[0].mData || frames > kMaximumFramesPerBuffer ||
+            data->mBuffers[0].mNumberChannels != 1 || data->mBuffers[0].mDataByteSize < size_t(frames)*sizeof(float)) {
+          callback->control->Fail(callback->token,kAudioEngineDeviceFormatError); result = kAudio_ParamError;
+        } else {
+          callback->control->Record(callback->token,
+              std::span<const float>(static_cast<const float*>(data->mBuffers[0].mData), frames));
+        }
+      }
+      callback->gate.Leave(); return result;
+    }];
+    [graph->engine attachNode:graph->private_meter_sink];
+    [graph->engine connect:graph->input to:graph->private_meter_sink format:graph->input_format];
+    [graph->engine prepare];
+    if (!control->Valid(request.token) || TimeMillis() >= request.resource.deadline_ms || !(ApplicationCaptureState() & 1) ||
+        !SameRoute(request.resource.route, CurrentDefaultRoute()) || !callback->gate.Open()) return kAudioEngineStateTransitionError;
+    NSError* error = nil;
+    if (![graph->engine startAndReturnError:&error]) {
+      control->NativeRunning(request.token,graph->engine.running); return kAudioEnginePlayoutStartError;
+    }
+    control->NativeRunning(request.token,true);
+    const int64_t deadline = std::min(request.resource.deadline_ms, TimeMillis()+500);
+    while (control->Valid(request.token) && TimeMillis()<deadline &&
+           control->RawCallbacks()==0) usleep(1000);
+    UInt32 running=0, size=sizeof(running);
+    const OSStatus status=AudioUnitGetProperty(graph->input.audioUnit, kAudioOutputUnitProperty_IsRunning,
+        kAudioUnitScope_Global, 0, &running, &size);
+    graph->started = control->Valid(request.token) && status==noErr && running && graph->engine.running &&
+        control->RawCallbacks()>0 && graph->bridge->silent_renders.load()==0 && !(graph->bridge->target.load()) &&
+        !graph->bridge->ever_opened && graph->bridge->gate.IsClosed() && (ApplicationCaptureState() & 1) &&
+        TimeMillis()<request.resource.deadline_ms && SameRoute(request.resource.route, CurrentDefaultRoute()) && PrivateInputFormatsMatch(graph);
+    if (graph->started) {
+      graph->private_configuration_observer=(__bridge_retained void*)[[NSNotificationCenter defaultCenter]
+          addObserverForName:AVAudioEngineConfigurationChangeNotification object:graph->engine queue:nil usingBlock:^(NSNotification*) {
+            callback->control->Fail(callback->token,kAudioEngineStateTransitionError);
+          }];
+      if (!graph->private_configuration_observer) return kAudioEngineStateTransitionError;
+    }
+    return graph->started ? 0 : kAudioEngineStateTransitionError;
+  } @catch (NSException*) { return kAudioEngineStateTransitionError; }
+}
+bool AudioEngineDevice::CommitPrivateInputMeter(const PrivateInputMeterRequest& request, const std::shared_ptr<PreparedInputGraph>& graph) {
+  RTC_DCHECK_RUN_ON(thread_);
+  return graph->bridge->privacy.IsPrivate() && graph->started && graph->bridge->target.load()==nullptr &&
+      graph->bridge->gate.IsClosed() && !graph->bridge->ever_opened && PrivateInputFormatsMatch(graph) &&
+      ValidatePrivateInputMeter(request) && private_meter_control_->Started(request.token);
+}
+bool AudioEngineDevice::InputGraphIsPrivate(const std::shared_ptr<PreparedInputGraph>& graph) {
+  return graph && graph->bridge->privacy.IsPrivate();
+}
+bool AudioEngineDevice::StopPrivateInputGraph(const std::shared_ptr<PreparedInputGraph>& graph) {
+  if (!graph || !graph->bridge->privacy.IsPrivate() || !graph->Stop()) return false;
+  @try {
+    for (AudioUnit unit : std::array<AudioUnit,2>{graph->input.audioUnit, graph->output.audioUnit}) {
+      if (!unit) continue;
+      UInt32 running=0, size=sizeof(running);
+      const OSStatus status=AudioUnitGetProperty(unit,kAudioOutputUnitProperty_IsRunning,kAudioUnitScope_Global,0,&running,&size);
+      if (status!=kAudioUnitErr_Uninitialized && (status!=noErr || running)) return false;
+    }
+    return !graph->engine.running && (!graph->private_callback || graph->private_callback->gate.Drained());
+  } @catch (NSException*) { return false; }
+}
+int32_t AudioEngineDevice::FinishPrivateInputMeter(uint64_t token, const std::shared_ptr<PreparedInputGraph>& graph, bool clean, int32_t result) {
+  RTC_DCHECK_RUN_ON(thread_);
+  if (!clean && !cleanup_unconfirmed_) { cleanup_unconfirmed_=true; this->AddRef(); }
+  private_meter_control_->Finish(token,clean,clean?result:kAudioEngineStateTransitionError);
+  return clean ? result : kAudioEngineStateTransitionError;
+}
