+bool AudioEngineDevice::ValidatePrivateInputMeter(const PrivateInputMeterRequest& request) {
+  RTC_DCHECK_RUN_ON(thread_);
+  const auto& r = request.resource;
+  return r.eligible && private_meter_control_->Valid(request.token) && initialized_ && !cleanup_unconfirmed_ &&
+      state_generation_ == r.generation && warm_configuration_generation_ == r.configuration_generation &&
+      warm_lifecycle_generation_ == r.lifecycle_generation && engine_state_ == r.state &&
+      request.audible_owner == reinterpret_cast<uintptr_t>((__bridge void*)engine_device_) &&
+      engine_device_ && engine_device_.running && !input_node_instantiated_ && !engine_state_.input_available &&
+      TimeMillis() < r.deadline_ms && IsMicrophonePermissionAuthorized() && (ApplicationCaptureState() & 1) &&
+      SameRoute(r.route, CurrentDefaultRoute());
+}
