+  std::atomic<int32_t> result_{0};
+  std::atomic<uint32_t> rate_{0},channels_{0};
+  std::atomic<uint64_t> samples_{0},energy_{0},callbacks_{0},non_silent_{0},recent_energy_{0},recent_samples_{0},first_{0},last_{0},first_non_silent_{0},last_non_silent_{0};
+};
