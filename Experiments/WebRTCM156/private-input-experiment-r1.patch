+    return Valid(token);
+  }
+  State Read() const {
+    State s; s.token=token_.load(); s.revoked=revoked_.load(); s.graph_id=graph_id_.load();
+    s.requested=requested_.load(); s.active=active_.load(); s.start_in_flight=in_flight_.load();
+    s.input_running=running_.load(); s.confirmed_stopped=confirmed_stopped_.load(); s.cleanup_unconfirmed=cleanup_.load();
+    s.result=result_.load(); if (s.token && failed_token_.load()==s.token) s.result=-5001; s.sample_rate=rate_.load(); s.channels=channels_.load(); s.silent_output_callbacks=silent_output_.load();
+    if (s.active && Valid(s.token)) {
+      s.meter.callbacks=callbacks_.load(std::memory_order_acquire); s.meter.samples=samples_.load();
+      s.meter.energy=double(energy_.load())/1073741824.0;
