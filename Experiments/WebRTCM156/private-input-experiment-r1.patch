+  bool IsPrivate() const { return private_.load(std::memory_order_acquire); }
+  bool MayPublish() const { return !IsPrivate(); }
+  template <typename Publish> bool TryPublish(Publish publish) const {
+    if (IsPrivate()) return false;
+    publish(); return true;
+  }
+ private:
