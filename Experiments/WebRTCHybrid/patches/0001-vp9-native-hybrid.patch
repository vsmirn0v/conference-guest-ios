diff --git a/sdk/objc/native/src/vp9_hardware_decoder_wrapper.cc b/sdk/objc/native/src/vp9_hardware_decoder_wrapper.cc
new file mode 100644
--- /dev/null
+++ b/sdk/objc/native/src/vp9_hardware_decoder_wrapper.cc
@@ -0,0 +1,73 @@
+/*
+ * Copyright 2026 The WebRTC project authors. All Rights Reserved.
+ *
+ * Use of this source code is governed by a BSD-style license
+ * that can be found in the LICENSE file in the root of the source
+ * tree. An additional intellectual property rights grant can be found
+ * in the file PATENTS. All contributing project authors may
+ * be found in the AUTHORS file in the root of the source tree.
+ */
+
+#include "sdk/objc/native/src/vp9_hardware_decoder_wrapper.h"
+
+#include <utility>
+
+#include "api/video/encoded_image.h"
+#include "modules/video_coding/include/video_error_codes.h"
+
+namespace webrtc {
+namespace {
+
+class VP9HardwareDecoderWrapper final : public VideoDecoder {
+ public:
+  explicit VP9HardwareDecoderWrapper(std::unique_ptr<VideoDecoder> decoder)
+      : decoder_(std::move(decoder)) {}
+
+  bool Configure(const Settings& settings) override {
+    return decoder_->Configure(settings);
+  }
+
+  int32_t Decode(const EncodedImage& image, int64_t render_time_ms) override {
+    // A combined keyframe's width/height may describe only its base layer.
+    // Check every frame, including an enhancement layer first seen mid-GOP.
+    if (image.SpatialIndex().value_or(0) > 0) {
+      return WEBRTC_VIDEO_CODEC_FALLBACK_SOFTWARE;
+    }
+    // SpatialLayerFrameSize(i) requires i <= SpatialIndex().value_or(0).
+    // Only layer zero is accessible after the check above.
+    if (const auto base_size = image.SpatialLayerFrameSize(0);
+        base_size && *base_size != image.size()) {
+      // Never silently decode just a base prefix of a concatenated image.
+      return WEBRTC_VIDEO_CODEC_FALLBACK_SOFTWARE;
+    }
+    return decoder_->Decode(image, render_time_ms);
+  }
+
+  int32_t RegisterDecodeCompleteCallback(DecodedImageCallback* callback) override {
+    return decoder_->RegisterDecodeCompleteCallback(callback);
+  }
+
+  int32_t Release() override { return decoder_->Release(); }
+
+  DecoderInfo GetDecoderInfo() const override {
+    DecoderInfo info = decoder_->GetDecoderInfo();
+    info.is_hardware_accelerated = true;
+    return info;
+  }
+
+  const char* ImplementationName() const override {
+    return decoder_->ImplementationName();
+  }
+
+ private:
+  const std::unique_ptr<VideoDecoder> decoder_;
+};
+
+}  // namespace
+
+std::unique_ptr<VideoDecoder> CreateVP9HardwareDecoderWrapper(
+    std::unique_ptr<VideoDecoder> hardware_decoder) {
+  return std::make_unique<VP9HardwareDecoderWrapper>(std::move(hardware_decoder));
+}
+
+}  // namespace webrtc
diff --git a/sdk/objc/unittests/vp9_hardware_decoder_wrapper_unittest.cc b/sdk/objc/unittests/vp9_hardware_decoder_wrapper_unittest.cc
new file mode 100644
--- /dev/null
+++ b/sdk/objc/unittests/vp9_hardware_decoder_wrapper_unittest.cc
@@ -0,0 +1,184 @@
+/*
+ * Copyright 2026 The WebRTC project authors. All Rights Reserved.
+ *
+ * Use of this source code is governed by a BSD-style license
+ * that can be found in the LICENSE file in the root of the source
+ * tree. An additional intellectual property rights grant can be found
+ * in the file PATENTS. All contributing project authors may
+ * be found in the AUTHORS file in the root of the source tree.
+ */
+
+#include "sdk/objc/native/src/vp9_hardware_decoder_wrapper.h"
+
+#include <memory>
+#include <utility>
+
+#include "api/environment/environment_factory.h"
+#include "api/video/encoded_image.h"
+#include "api/video_codecs/video_decoder_software_fallback_wrapper.h"
+#include "modules/video_coding/include/video_error_codes.h"
+#include "test/gtest.h"
+
+namespace webrtc {
+namespace {
+
+struct DecoderState {
+  int configurations = 0;
+  int decodes = 0;
+  int releases = 0;
+  int32_t result = WEBRTC_VIDEO_CODEC_OK;
+  const EncodedImage* image = nullptr;
+  int64_t render_time_ms = 0;
+  DecodedImageCallback* callback = nullptr;
+};
+
+class CountingDecoder final : public VideoDecoder {
+ public:
+  explicit CountingDecoder(DecoderState& state) : state_(state) {}
+  bool Configure(const Settings&) override {
+    ++state_.configurations;
+    return true;
+  }
+  int32_t Decode(const EncodedImage& image, int64_t render_time_ms) override {
+    ++state_.decodes;
+    state_.image = &image;
+    state_.render_time_ms = render_time_ms;
+    return state_.result;
+  }
+  int32_t RegisterDecodeCompleteCallback(DecodedImageCallback* callback) override {
+    state_.callback = callback;
+    return WEBRTC_VIDEO_CODEC_OK;
+  }
+  int32_t Release() override {
+    ++state_.releases;
+    state_.callback = nullptr;
+    return WEBRTC_VIDEO_CODEC_OK;
+  }
+  const char* ImplementationName() const override { return "CountingDecoder"; }
+
+ private:
+  DecoderState& state_;
+};
+
+class Callback final : public DecodedImageCallback {
+ public:
+  int32_t Decoded(VideoFrame&) override { return 0; }
+};
+
+EncodedImage SingleLayer() {
+  EncodedImage image;
+  image.SetEncodedData(EncodedImageBuffer::Create(8));
+  image.SetSpatialIndex(0);
+  image.SetSpatialLayerFrameSize(0, 8);
+  image.SetRtpTimestamp(1234);
+  image._frameType = VideoFrameType::kVideoFrameKey;
+  return image;
+}
+
+TEST(VP9HardwareDecoderWrapperTest, ForwardsTemporalLayersAndLifecycle) {
+  DecoderState hardware;
+  auto decoder = CreateVP9HardwareDecoderWrapper(
+      std::make_unique<CountingDecoder>(hardware));
+  VideoDecoder::Settings settings;
+  Callback callback;
+  EXPECT_TRUE(decoder->Configure(settings));
+  EXPECT_EQ(decoder->RegisterDecodeCompleteCallback(&callback), 0);
+  auto image = SingleLayer();
+  image.SetTemporalIndex(2);
+  EXPECT_EQ(decoder->Decode(image, 42), WEBRTC_VIDEO_CODEC_OK);
+  EXPECT_EQ(hardware.image, &image);
+  EXPECT_EQ(hardware.render_time_ms, 42);
+  EXPECT_EQ(hardware.callback, &callback);
+  EXPECT_TRUE(decoder->GetDecoderInfo().is_hardware_accelerated);
+  EXPECT_EQ(decoder->Release(), 0);
+  EXPECT_EQ(hardware.configurations, 1);
+  EXPECT_EQ(hardware.releases, 1);
+  EXPECT_EQ(hardware.callback, nullptr);
+}
+
+TEST(VP9HardwareDecoderWrapperTest, AcceptsOrdinaryUnlayeredInput) {
+  DecoderState hardware;
+  auto decoder = CreateVP9HardwareDecoderWrapper(
+      std::make_unique<CountingDecoder>(hardware));
+  EncodedImage image;
+  image.SetEncodedData(EncodedImageBuffer::Create(8));
+  EXPECT_EQ(decoder->Decode(image, 0), WEBRTC_VIDEO_CODEC_OK);
+  EXPECT_EQ(hardware.decodes, 1);
+}
+
+TEST(VP9HardwareDecoderWrapperTest, RejectsSpatialMetadataBeforeHardware) {
+  for (int scenario = 0; scenario < 4; ++scenario) {
+    DecoderState hardware;
+    auto decoder = CreateVP9HardwareDecoderWrapper(
+        std::make_unique<CountingDecoder>(hardware));
+    auto image = SingleLayer();
+    if (scenario == 0) {
+      image.SetSpatialIndex(1);
+    } else if (scenario == 1) {
+      image.SetSpatialIndex(1);
+      image.SetSpatialLayerFrameSize(0, 4);
+      image.SetSpatialLayerFrameSize(1, 4);
+    } else if (scenario == 2) {
+      image.SetSpatialLayerFrameSize(0, 4);
+    } else {
+      image._frameType = VideoFrameType::kVideoFrameDelta;
+      image.SetSpatialIndex(2);
+    }
+    EXPECT_EQ(decoder->Decode(image, 0), WEBRTC_VIDEO_CODEC_FALLBACK_SOFTWARE);
+    EXPECT_EQ(hardware.decodes, 0);
+  }
+}
+
+TEST(VP9HardwareDecoderWrapperTest, RetriesSameSvcImageAndKeepsSoftwareActive) {
+  DecoderState hardware;
+  DecoderState software;
+  auto decoder = CreateVideoDecoderSoftwareFallbackWrapper(
+      CreateEnvironment(), std::make_unique<CountingDecoder>(software),
+      CreateVP9HardwareDecoderWrapper(std::make_unique<CountingDecoder>(hardware)));
+  VideoDecoder::Settings settings;
+  settings.set_codec_type(kVideoCodecVP9);
+  Callback callback;
+  ASSERT_TRUE(decoder->Configure(settings));
+  ASSERT_EQ(decoder->RegisterDecodeCompleteCallback(&callback), 0);
+  auto image = SingleLayer();
+  image.SetSpatialIndex(2);
+  EXPECT_EQ(decoder->Decode(image, 42), WEBRTC_VIDEO_CODEC_OK);
+  EXPECT_EQ(hardware.decodes, 0);
+  EXPECT_EQ(hardware.releases, 1);
+  EXPECT_EQ(hardware.callback, nullptr);
+  EXPECT_EQ(software.configurations, 1);
+  EXPECT_EQ(software.image, &image);
+  EXPECT_EQ(software.render_time_ms, 42);
+  EXPECT_EQ(software.callback, &callback);
+  EXPECT_FALSE(decoder->GetDecoderInfo().is_hardware_accelerated);
+  auto next = SingleLayer();
+  EXPECT_EQ(decoder->Decode(next, 43), WEBRTC_VIDEO_CODEC_OK);
+  EXPECT_EQ(hardware.decodes, 0);
+  EXPECT_EQ(software.decodes, 2);
+  EXPECT_EQ(decoder->Release(), 0);
+  EXPECT_EQ(hardware.releases, 1);
+  EXPECT_EQ(software.releases, 1);
+}
+
+TEST(VP9HardwareDecoderWrapperTest, PermanentHardwareFailureRetriesOriginalImage) {
+  DecoderState hardware;
+  hardware.result = WEBRTC_VIDEO_CODEC_FALLBACK_SOFTWARE;
+  DecoderState software;
+  auto decoder = CreateVideoDecoderSoftwareFallbackWrapper(
+      CreateEnvironment(), std::make_unique<CountingDecoder>(software),
+      CreateVP9HardwareDecoderWrapper(std::make_unique<CountingDecoder>(hardware)));
+  VideoDecoder::Settings settings;
+  settings.set_codec_type(kVideoCodecVP9);
+  ASSERT_TRUE(decoder->Configure(settings));
+  auto image = SingleLayer();
+  EXPECT_EQ(decoder->Decode(image, 42), WEBRTC_VIDEO_CODEC_OK);
+  EXPECT_EQ(hardware.image, &image);
+  EXPECT_EQ(software.image, &image);
+  EXPECT_EQ(hardware.decodes, 1);
+  EXPECT_EQ(software.decodes, 1);
+  EXPECT_EQ(hardware.releases, 1);
+  EXPECT_EQ(decoder->Release(), 0);
+}
+
+}  // namespace
+}  // namespace webrtc
