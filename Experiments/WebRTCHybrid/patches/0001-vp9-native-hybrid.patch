+@interface VP9HybridProbeDecoder : NSObject <RTC_OBJC_TYPE(RTCVideoDecoder)>
+@property(nonatomic) int starts;
+@property(nonatomic) int decodes;
+@property(nonatomic) int releases;
+@end
+
+@implementation VP9HybridProbeDecoder
+- (void)setCallback:(RTCVideoDecoderCallback)callback {}
+- (NSInteger)startDecodeWithNumberOfCores:(int)numberOfCores {
+  self.starts += 1;
+  return WEBRTC_VIDEO_CODEC_OK;
+}
+- (NSInteger)releaseDecoder {
+  self.releases += 1;
+  return WEBRTC_VIDEO_CODEC_OK;
+}
+- (NSInteger)decode:(RTC_OBJC_TYPE(RTCEncodedImage) *)image
+        missingFrames:(BOOL)missingFrames
+    codecSpecificInfo:(id<RTC_OBJC_TYPE(RTCCodecSpecificInfo)>)info
+         renderTimeMs:(int64_t)renderTimeMs {
+  self.decodes += 1;
+  return WEBRTC_VIDEO_CODEC_OK;
+}
+- (NSString *)implementationName { return @"VP9HybridProbe"; }
+@end
+
+namespace {
+
+std::unique_ptr<webrtc::VideoDecoder> BuildHybrid(
+    id<RTC_OBJC_TYPE(RTCVideoDecoder)> handle,
+    const char* profile = "0") {
+  id factory = OCMProtocolMock(@protocol(RTC_OBJC_TYPE(RTCVideoDecoderFactory)));
+  RTC_OBJC_TYPE(RTCVideoCodecInfo) *info =
+      [[RTC_OBJC_TYPE(RTCVideoCodecInfo) alloc] initWithName:@"VP9" parameters:nil];
+  OCMStub([factory supportedCodecs]).andReturn(@[ info ]);
+  OCMStub([factory createDecoder:[OCMArg any]]).andReturn(handle);
+  webrtc::ObjCVideoDecoderFactory bridge(factory);
+  return bridge.Create(webrtc::CreateEnvironment(),
+                       webrtc::SdpVideoFormat("VP9", {{"profile-id", profile}}));
+}
+
+}  // namespace
+
+@interface RTCVideoDecoderVP9HybridTests : XCTestCase
+@end
+
+@implementation RTCVideoDecoderVP9HybridTests
+- (void)testPublicFactoryCreatesNativeHybrid {
+  VP9HybridProbeDecoder *hardware = [[VP9HybridProbeDecoder alloc] init];
+  auto decoder = BuildHybrid(
+      [RTC_OBJC_TYPE(RTCVideoDecoderVP9) vp9DecoderWithHardwareDecoder:hardware]);
+  ASSERT_TRUE(decoder);
+  webrtc::VideoDecoder::Settings settings;
+  settings.set_codec_type(webrtc::kVideoCodecVP9);
+  ASSERT_TRUE(decoder->Configure(settings));
+  webrtc::EncodedImage image;
+  image.SetEncodedData(webrtc::EncodedImageBuffer::Create(8));
+  image.SetSpatialIndex(0);
+  image.SetSpatialLayerFrameSize(0, 8);
+  EXPECT_EQ(decoder->Decode(image, 0), WEBRTC_VIDEO_CODEC_OK);
+  EXPECT_EQ(hardware.starts, 1);
+  EXPECT_EQ(hardware.decodes, 1);
+  EXPECT_TRUE(decoder->GetDecoderInfo().is_hardware_accelerated);
+  EXPECT_EQ(decoder->Release(), WEBRTC_VIDEO_CODEC_OK);
+  EXPECT_EQ(hardware.releases, 1);
+}
+
+- (void)testSpatialMetadataDoesNotReachObjectiveCDecoder {
+  VP9HybridProbeDecoder *hardware = [[VP9HybridProbeDecoder alloc] init];
+  auto decoder = BuildHybrid(
+      [RTC_OBJC_TYPE(RTCVideoDecoderVP9) vp9DecoderWithHardwareDecoder:hardware]);
+  webrtc::VideoDecoder::Settings settings;
+  settings.set_codec_type(webrtc::kVideoCodecVP9);
+  ASSERT_TRUE(decoder->Configure(settings));
+  webrtc::EncodedImage image;
+  // Invalid VP9 payload: software may reject it; the invariant is routing.
+  const uint8_t invalid[] = {0};
+  image.SetEncodedData(webrtc::EncodedImageBuffer::Create(invalid, sizeof(invalid)));
+  image.SetSpatialIndex(2);
+  image._frameType = webrtc::VideoFrameType::kVideoFrameKey;
+  decoder->Decode(image, 0);
+  EXPECT_EQ(hardware.decodes, 0);
+  EXPECT_EQ(hardware.releases, 1);
+  EXPECT_FALSE(decoder->GetDecoderInfo().is_hardware_accelerated);
+  decoder->Release();
+}
+
+- (void)testProfileTwoBypassesHardware {
+  VP9HybridProbeDecoder *hardware = [[VP9HybridProbeDecoder alloc] init];
+  auto decoder = BuildHybrid(
+      [RTC_OBJC_TYPE(RTCVideoDecoderVP9) vp9DecoderWithHardwareDecoder:hardware], "2");
+  ASSERT_TRUE(decoder);
+  EXPECT_FALSE(decoder->GetDecoderInfo().is_hardware_accelerated);
+  EXPECT_EQ(hardware.starts, 0);
+}
+
+- (void)testHandleCannotShareHardwareBetweenStreams {
+  VP9HybridProbeDecoder *hardware = [[VP9HybridProbeDecoder alloc] init];
+  id<RTC_OBJC_TYPE(RTCVideoDecoder)> handle =
+      [RTC_OBJC_TYPE(RTCVideoDecoderVP9) vp9DecoderWithHardwareDecoder:hardware];
+  auto first = BuildHybrid(handle);
+  auto second = BuildHybrid(handle);
+  ASSERT_TRUE(first);
+  ASSERT_TRUE(second);
+  EXPECT_TRUE(first->GetDecoderInfo().is_hardware_accelerated);
+  EXPECT_FALSE(second->GetDecoderInfo().is_hardware_accelerated);
+}
+
+- (void)testNativeHandleIsNotInvokedAsConcreteHardware {
+  auto decoder = BuildHybrid([RTC_OBJC_TYPE(RTCVideoDecoderVP9)
+      vp9DecoderWithHardwareDecoder:[RTC_OBJC_TYPE(RTCVideoDecoderVP9) vp9Decoder]]);
+  ASSERT_TRUE(decoder);
+  EXPECT_FALSE(decoder->GetDecoderInfo().is_hardware_accelerated);
+}
