+TEST_F(VP9HybridFactoryTest, SpatialFixtureMatchesIndependentTopLayerPixels) {
+  const char* path = std::getenv("WEBRTC_VP9_SVC_FIXTURE");
+  if (!path) {
+    GTEST_SKIP() << "Set WEBRTC_VP9_SVC_FIXTURE to the independent RVP9SVC1 fixture";
+  }
+  std::ifstream input(path, std::ios::binary);
+  ASSERT_TRUE(input.is_open());
+  std::array<char, 8> magic;
+  ASSERT_TRUE(input.read(magic.data(), magic.size()));
+  EXPECT_EQ(std::string(magic.data(), magic.size()), "RVP9SVC1");
+  auto read_u32 = [&](uint32_t& value) {
+    std::array<uint8_t, 4> bytes;
+    if (!input.read(reinterpret_cast<char*>(bytes.data()), bytes.size())) {
+      return false;
+    }
+    value = uint32_t{bytes[0]} | (uint32_t{bytes[1]} << 8) |
+            (uint32_t{bytes[2]} << 16) | (uint32_t{bytes[3]} << 24);
+    return true;
+  };
+  uint32_t frame_count;
+  ASSERT_TRUE(read_u32(frame_count));
+  ASSERT_GT(frame_count, 0u);
+  ASSERT_LE(frame_count, 1000u);
+  @autoreleasepool {
+    VP9HybridCLIHardwareDecoder *hardware = [[VP9HybridCLIHardwareDecoder alloc] init];
+    auto decoder = BuildHybrid(
+        [RTC_OBJC_TYPE(RTCVideoDecoderVP9) vp9DecoderWithHardwareDecoder:hardware]);
+    ASSERT_TRUE(decoder);
+    VideoDecoder::Settings settings;
+    settings.set_codec_type(kVideoCodecVP9);
+    ASSERT_TRUE(decoder->Configure(settings));
+    PixelCallback callback;
+    ASSERT_EQ(decoder->RegisterDecodeCompleteCallback(&callback), WEBRTC_VIDEO_CODEC_OK);
+    for (uint32_t i = 0; i < frame_count; ++i) {
+      SCOPED_TRACE(i);
+      uint32_t width, height, key, length;
+      ASSERT_TRUE(read_u32(width) && read_u32(height) && read_u32(key) && read_u32(length));
+      ASSERT_GT(width, 0u);
+      ASSERT_LE(width, 4096u);
+      ASSERT_GT(height, 0u);
+      ASSERT_LE(height, 4096u);
+      ASSERT_LE(key, 1u);
+      ASSERT_GT(length, 0u);
+      ASSERT_LE(length, 4u * 1024u * 1024u);
+      std::vector<uint8_t> payload(length);
+      ASSERT_TRUE(input.read(reinterpret_cast<char*>(payload.data()), payload.size()));
+      ASSERT_TRUE(input.read(reinterpret_cast<char*>(callback.sha256.data()),
+                             callback.sha256.size()));
+      callback.width = width;
+      callback.height = height;
+      callback.timestamp = i * 3000;
+      EncodedImage image;
+      image.SetEncodedData(EncodedImageBuffer::Create(payload.data(), payload.size()));
+      image.SetSpatialIndex(2);
+      // Native WebRTC may retain base-layer dimensions after spatial combining.
+      image._encodedWidth = width / 4;
+      image._encodedHeight = height / 4;
+      image._frameType = key ? VideoFrameType::kVideoFrameKey : VideoFrameType::kVideoFrameDelta;
+      image.SetRtpTimestamp(callback.timestamp);
+      ASSERT_EQ(decoder->Decode(image, 0), WEBRTC_VIDEO_CODEC_OK);
+      EXPECT_EQ(callback.frames, static_cast<int>(i + 1));
+    }
+    EXPECT_EQ(input.peek(), std::ifstream::traits_type::eof());
+    EXPECT_EQ(hardware.starts, 1);
+    EXPECT_EQ(hardware.decodes, 0);
+    EXPECT_EQ(hardware.releases, 1);
+    EXPECT_FALSE(decoder->GetDecoderInfo().is_hardware_accelerated);
+    EXPECT_EQ(decoder->Release(), WEBRTC_VIDEO_CODEC_OK);
+    EXPECT_EQ(hardware.releases, 1);
+  }
+}
