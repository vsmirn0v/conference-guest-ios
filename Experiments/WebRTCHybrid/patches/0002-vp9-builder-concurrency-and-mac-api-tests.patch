+std::unique_ptr<VideoDecoder> BuildHybrid(
+    id<RTC_OBJC_TYPE(RTCVideoDecoder)> handle,
+    const char* profile = "0") {
+  VP9HybridCLIFactory *factory = [[VP9HybridCLIFactory alloc] initWithHandle:handle];
+  ObjCVideoDecoderFactory bridge(factory);
+  return bridge.Create(CreateEnvironment(), SdpVideoFormat("VP9", {{"profile-id", profile}}));
+}
