+class OutputCallback final : public DecodedImageCallback {
+ public:
+  int32_t Decoded(VideoFrame& frame) override {
+    ++frames;
+    timestamp = frame.rtp_timestamp();
+    width = frame.width();
+    return 0;
+  }
+  int frames = 0;
+  uint32_t timestamp = 0;
+  int width = 0;
+};
+
+class PixelCallback final : public DecodedImageCallback {
+ public:
+  int32_t Decoded(VideoFrame& frame) override {
+    ++frames;
+    EXPECT_EQ(frame.rtp_timestamp(), timestamp);
+    EXPECT_EQ(frame.width(), width);
+    EXPECT_EQ(frame.height(), height);
+    auto buffer = frame.video_frame_buffer()->ToI420();
+    if (!buffer || buffer->width() != width || buffer->height() != height) {
+      ADD_FAILURE() << "Unexpected decoded I420 dimensions";
+      return WEBRTC_VIDEO_CODEC_ERROR;
+    }
+    std::vector<uint8_t> packed;
+    auto append_plane = [&](const uint8_t* data, int stride, int columns, int rows) {
+      for (int row = 0; row < rows; ++row) {
+        packed.insert(packed.end(), data + row * stride, data + row * stride + columns);
+      }
+    };
+    append_plane(buffer->DataY(), buffer->StrideY(), width, height);
+    append_plane(buffer->DataU(), buffer->StrideU(), (width + 1) / 2, (height + 1) / 2);
+    append_plane(buffer->DataV(), buffer->StrideV(), (width + 1) / 2, (height + 1) / 2);
+    std::array<uint8_t, CC_SHA256_DIGEST_LENGTH> actual;
+    CC_SHA256(packed.data(), static_cast<CC_LONG>(packed.size()), actual.data());
+    EXPECT_EQ(actual, sha256);
+    return WEBRTC_VIDEO_CODEC_OK;
+  }
+  int frames = 0;
+  int width = 0;
+  int height = 0;
+  uint32_t timestamp = 0;
+  std::array<uint8_t, CC_SHA256_DIGEST_LENGTH> sha256;
+};
