+class VP9HybridFactoryTest : public ::testing::Test {
+ public:
+  void SetUp() override {
+    if (![RTC_OBJC_TYPE(RTCVideoDecoderVP9) isSupported]) {
+      GTEST_SKIP() << "VP9 disabled in this build";
+    }
+  }
+};
