+@interface VP9HybridCLIHardwareDecoder : NSObject <RTC_OBJC_TYPE(RTCVideoDecoder)>
+@property(nonatomic) int starts;
+@property(nonatomic) int decodes;
+@property(nonatomic) int releases;
+@property(nonatomic, copy) RTCVideoDecoderCallback callback;
+@property(nonatomic, strong) RTC_OBJC_TYPE(RTCVideoFrame) *outputFrame;
+@end
+
+@implementation VP9HybridCLIHardwareDecoder
+@synthesize starts = _starts;
+@synthesize decodes = _decodes;
+@synthesize releases = _releases;
+@synthesize callback = _callback;
+@synthesize outputFrame = _outputFrame;
+- (void)setCallback:(RTCVideoDecoderCallback)callback { _callback = [callback copy]; }
+- (NSInteger)startDecodeWithNumberOfCores:(int)numberOfCores {
+  self.starts += 1;
+  return WEBRTC_VIDEO_CODEC_OK;
+}
+- (NSInteger)releaseDecoder {
+  self.releases += 1;
+  self.callback = nil;
+  return WEBRTC_VIDEO_CODEC_OK;
+}
+- (NSInteger)decode:(RTC_OBJC_TYPE(RTCEncodedImage) *)image
+        missingFrames:(BOOL)missingFrames
+    codecSpecificInfo:(id<RTC_OBJC_TYPE(RTCCodecSpecificInfo)>)info
+         renderTimeMs:(int64_t)renderTimeMs {
+  self.decodes += 1;
+  if (self.outputFrame && self.callback) {
+    self.callback(self.outputFrame);
+  }
+  return WEBRTC_VIDEO_CODEC_OK;
+}
+- (NSString *)implementationName { return @"VP9HybridCLIHardware"; }
+@end
+
+@interface VP9HybridCLIFactory : NSObject <RTC_OBJC_TYPE(RTCVideoDecoderFactory)>
+- (instancetype)initWithHandle:(id<RTC_OBJC_TYPE(RTCVideoDecoder)>)handle;
+@end
+
+@implementation VP9HybridCLIFactory {
+  id<RTC_OBJC_TYPE(RTCVideoDecoder)> _handle;
+}
+- (instancetype)initWithHandle:(id<RTC_OBJC_TYPE(RTCVideoDecoder)>)handle {
+  if (self = [super init]) {
+    _handle = handle;
+  }
+  return self;
+}
+- (NSArray<RTC_OBJC_TYPE(RTCVideoCodecInfo) *> *)supportedCodecs {
+  return @[ [[RTC_OBJC_TYPE(RTCVideoCodecInfo) alloc] initWithName:@"VP9" parameters:@{}] ];
+}
+- (id<RTC_OBJC_TYPE(RTCVideoDecoder)>)createDecoder:(RTC_OBJC_TYPE(RTCVideoCodecInfo) *)info {
+  return _handle;
+}
+@end
