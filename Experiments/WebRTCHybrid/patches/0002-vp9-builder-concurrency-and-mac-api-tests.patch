+TEST_F(VP9HybridFactoryTest, ReusedHandleCannotShareHardwareConcurrently) {
+  @autoreleasepool {
+    VP9HybridCLIHardwareDecoder *hardware = [[VP9HybridCLIHardwareDecoder alloc] init];
+    id<RTC_OBJC_TYPE(RTCVideoDecoder)> handle =
+        [RTC_OBJC_TYPE(RTCVideoDecoderVP9) vp9DecoderWithHardwareDecoder:hardware];
+    std::atomic<int> hardware_count{0};
+    std::atomic<int> software_count{0};
+    auto* hw_count = &hardware_count;
+    auto* sw_count = &software_count;
+    dispatch_apply(32, dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_DEFAULT, 0), ^(size_t) {
+      @autoreleasepool {
+        auto decoder = BuildHybrid(handle);
+        if (decoder && decoder->GetDecoderInfo().is_hardware_accelerated) {
+          ++*hw_count;
+        } else if (decoder) {
+          ++*sw_count;
+        }
+      }
+    });
+    EXPECT_EQ(hardware_count.load(), 1);
+    EXPECT_EQ(software_count.load(), 31);
+    EXPECT_EQ(hardware.starts, 0);
+  }
+}
