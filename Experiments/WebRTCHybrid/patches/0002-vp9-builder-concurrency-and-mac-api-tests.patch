+TEST_F(VP9HybridFactoryTest, BridgesOutputAndRetiresCallback) {
+  @autoreleasepool {
+    VP9HybridCLIHardwareDecoder *hardware = [[VP9HybridCLIHardwareDecoder alloc] init];
+    CVPixelBufferRef pixels = nullptr;
+    ASSERT_EQ(CVPixelBufferCreate(kCFAllocatorDefault, 2, 2,
+                                 kCVPixelFormatType_32BGRA, nullptr, &pixels), kCVReturnSuccess);
+    RTC_OBJC_TYPE(RTCCVPixelBuffer) *buffer =
+        [[RTC_OBJC_TYPE(RTCCVPixelBuffer) alloc] initWithPixelBuffer:pixels];
+    CVPixelBufferRelease(pixels);
+    hardware.outputFrame = [[RTC_OBJC_TYPE(RTCVideoFrame) alloc]
+        initWithBuffer:buffer rotation:RTC_OBJC_TYPE(RTCVideoRotation_0) timeStampNs:0];
+    hardware.outputFrame.timeStamp = 1234;
+    auto decoder = BuildHybrid(
+        [RTC_OBJC_TYPE(RTCVideoDecoderVP9) vp9DecoderWithHardwareDecoder:hardware]);
+    ASSERT_TRUE(decoder);
+    VideoDecoder::Settings settings;
+    settings.set_codec_type(kVideoCodecVP9);
+    ASSERT_TRUE(decoder->Configure(settings));
+    OutputCallback callback;
+    ASSERT_EQ(decoder->RegisterDecodeCompleteCallback(&callback), 0);
+    EncodedImage image;
+    image.SetEncodedData(EncodedImageBuffer::Create(8));
+    image.SetSpatialIndex(0);
+    image.SetSpatialLayerFrameSize(0, 8);
+    EXPECT_EQ(decoder->Decode(image, 0), WEBRTC_VIDEO_CODEC_OK);
+    EXPECT_EQ(hardware.starts, 1);
+    EXPECT_EQ(hardware.decodes, 1);
+    EXPECT_EQ(callback.frames, 1);
+    EXPECT_EQ(callback.timestamp, 1234u);
+    EXPECT_EQ(callback.width, 2);
+    EXPECT_TRUE(decoder->GetDecoderInfo().is_hardware_accelerated);
+    EXPECT_EQ(decoder->Release(), WEBRTC_VIDEO_CODEC_OK);
+    EXPECT_EQ(hardware.releases, 1);
+    EXPECT_FALSE(hardware.callback);
+    EXPECT_EQ(decoder->Decode(image, 0), WEBRTC_VIDEO_CODEC_UNINITIALIZED);
+    EXPECT_EQ(callback.frames, 1);
+  }
+}
